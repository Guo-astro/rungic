# The kernel loop worker needs access only to our ext4 backing image.
type rungic_docker_image file_type
typeattribute rungic_docker_image data_file_type
allow kernel rungic_docker_image file { open read write getattr ioctl lock map }

# Dedicated compatibility domain for the user's trusted Docker workloads.
# Other Android domains remain enforcing. Retain established allow rules
# to reduce audit noise and preserve the option to return to enforcing.
type rungic_docker domain
typeattribute rungic_docker mlstrustedsubject
typeattribute rungic_docker netdomain
permissive rungic_docker
type rungic_docker_file file_type
typeattribute rungic_docker_file data_file_type
allow rungic_docker rungic_docker * *
allow rungic_docker rungic_docker_file * *
allowxperm rungic_docker rungic_docker_file file ioctl *
allow rungic_docker magisk { fd fifo_file unix_stream_socket } *
allow rungic_docker magisk process sigchld
allow rungic_docker { adbd shell untrusted_app_27 } fd use
# Termux command substitution and redirection use app-labelled anonymous pipes.
allow rungic_docker untrusted_app_27 fifo_file { read write getattr ioctl }
allowxperm rungic_docker untrusted_app_27 fifo_file ioctl { 0x5401 0x5413 }
allow rungic_docker adbd unix_stream_socket { read write getattr ioctl }
allow magisk rungic_docker process { transition dyntransition signal sigkill sigstop getattr getcap ptrace }
allow rungic_docker { rootfs tmpfs proc proc_type sysfs sysfs_type } dir { open read getattr search mounton }
allow rungic_docker { rootfs tmpfs proc proc_type sysfs sysfs_type } file { open read getattr map }
allow rungic_docker { rootfs tmpfs proc proc_type sysfs sysfs_type } lnk_file { open read getattr }
allow rungic_docker { cgroup cgroup_v2 } { dir file } *
allow rungic_docker { tmpfs devpts } filesystem { mount remount unmount getattr associate }
allow rungic_docker fs_type filesystem { mount remount unmount getattr associate }
allow rungic_docker { device devpts } dir { open read getattr search mounton }
allow rungic_docker { null_device zero_device random_device ptmx_device devpts } chr_file *
# runc allocates and unlocks a container PTY for docker exec/run -t.
allowxperm rungic_docker devpts chr_file ioctl { 0x5430 0x5431 0x5441 }
allow rungic_docker selinuxfs dir { open read getattr search }
allow rungic_docker selinuxfs file { open read getattr }
allow rungic_docker proc_net file { open read write getattr }
allow rungic_docker port_type { tcp_socket udp_socket } *
allow rungic_docker node_type { tcp_socket udp_socket rawip_socket } *
# Android labels nsfs namespace handles as unlabeled on this kernel.
allow rungic_docker unlabeled file { open read getattr ioctl }
allow rungic_docker labeledfs filesystem quotaget
# Label Docker-created tmpfs/memfd objects, including runc's sealed self-copy.
type_transition rungic_docker tmpfs file rungic_docker_file
type_transition rungic_docker tmpfs dir rungic_docker_file
type_transition rungic_docker tmpfs chr_file rungic_docker_file
type_transition rungic_docker tmpfs blk_file rungic_docker_file
type_transition rungic_docker tmpfs lnk_file rungic_docker_file
type_transition rungic_docker tmpfs sock_file rungic_docker_file
type_transition rungic_docker tmpfs fifo_file rungic_docker_file
allow rungic_docker tmpfs dir { write add_name remove_name create setattr rmdir }
allow rungic_docker proc_type file mounton
allow rungic_docker unlabeled filesystem { mount remount unmount getattr associate }
allow rungic_docker init file { open read getattr }
allowxperm rungic_docker rungic_docker fifo_file ioctl { 0x5401 0x5413 }
