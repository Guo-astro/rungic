#!/system/bin/sh
# Root-only lifecycle and CLI entry point. Does not expose a TCP Docker API.
set -eu
export PATH=/product/bin:/system/bin:/system/xbin:/vendor/bin
BASE=/data/adb/moto-docker
R=$BASE/runtime
ENTER=$BASE/moto-docker-enter
[ "$(id -u)" = 0 ] || { echo 'Magisk root is required' >&2; exit 1; }

pid_of() {
    file=$R/run/$1.pid
    [ -f "$file" ] || return 1
    p=$(cat "$file")
    case "$p" in ''|*[!0-9]*) return 1;; esac
    [ "/proc/$p/exe" -ef "$R/usr/bin/$1" ] || return 1
    printf '%s\n' "$p"
}

start_engine() {
    if pid_of dockerd >/dev/null; then echo 'Docker is already running'; return; fi
    for helper in containerd bindfs; do
        if pid_of "$helper" >/dev/null; then
            echo "$helper is still running; run stop before start" >&2; return 1
        fi
    done
    [ "$(getenforce)" = Enforcing ] || { echo 'Expected SELinux Enforcing' >&2; return 1; }
    magiskpolicy --live --apply "$BASE/sepolicy.rule"
    chcon u:object_r:moto_docker_image:s0 "$BASE/docker-data.ext4"
    loop=
    for f in /sys/block/loop*/loop/backing_file; do
        [ -r "$f" ] || continue
        if [ "$(cat "$f")" = "$BASE/docker-data.ext4" ]; then
            name=${f#/sys/block/}; name=${name%%/*}; loop=/dev/block/$name; break
        fi
    done
    [ -n "$loop" ] || loop=$(losetup -f -s "$BASE/docker-data.ext4")
    printf '%s\n' "$loop" >"$BASE/data.loop"
    # Docker caches its initial forwarding check; set this before the daemon,
    # even when Wi-Fi has not obtained an uplink route yet.
    if [ ! -e "$BASE/ip-forward.before" ]; then
        cat /proc/sys/net/ipv4/ip_forward >"$BASE/ip-forward.before"
    fi
    echo 1 >/proc/sys/net/ipv4/ip_forward
    rm -f "$R/run/dockerd.pid" "$R/run/containerd.pid" "$R/run/bindfs.pid"
    nohup "$ENTER" /usr/local/sbin/docker-runtime-start </dev/null >>"$R/var/log/dockerd.log" 2>&1 9>&- &
    launcher=$!
    ready=0
    for i in $(seq 1 45); do
        if "$ENTER" /usr/bin/docker info >/dev/null 2>&1; then ready=1; break; fi
        kill -0 "$launcher" 2>/dev/null || break
        sleep 1
    done
    [ "$ready" = 1 ] || { echo 'Docker failed to start; see log' >&2; return 1; }
    "$BASE/network.sh" up || echo 'Network will be retried when Android has an uplink'
    touch "$BASE/running"
    nohup "$BASE/moto-docker" watch-network </dev/null >>"$R/var/log/network.log" 2>&1 9>&- &
    echo 'Docker started; Android SELinux Enforcing'
    printf 'Docker SELinux domain: '; "$ENTER" --selinux-mode
}

stop_engine() {
    rm -f "$BASE/running"
    # Stop the API first so it can shut down containers and shims cleanly.
    for name in dockerd containerd bindfs; do
        if p=$(pid_of "$name"); then
            kill -TERM "$p"
            for i in $(seq 1 45); do
                pid_of "$name" >/dev/null || break
                sleep 1
            done
            if pid_of "$name" >/dev/null; then
                echo "$name did not stop; refusing to kill it forcibly" >&2; return 1
            fi
        fi
    done
    "$BASE/network.sh" down
    echo 'Docker stopped; images and volumes retained'
}

action=${1:-status}
[ "$#" = 0 ] || shift
case "$action" in
    cli) exec "$ENTER" /usr/bin/docker "$@";;
    shell) exec "$ENTER" /bin/sh -l;;
    exec) [ "$#" -gt 0 ] || exit 2; exec "$ENTER" "$@";;
    status)
        printf 'Android SELinux: '; getenforce
        printf 'Docker SELinux domain: '
        "$ENTER" --selinux-mode 2>/dev/null || echo 'not loaded'
        if p=$(pid_of dockerd); then
            echo "Docker PID: $p"
            printf 'Domain: '; tr '\000' '\n' </proc/$p/attr/current
            "$ENTER" /usr/bin/docker ps
        else echo 'Docker stopped'; fi
        if [ -f "$BASE/autostart" ]; then echo 'Autostart: enabled'; else echo 'Autostart: disabled'; fi
        ;;
    log) tail -n 60 "$R/var/log/dockerd.log"; tail -n 20 "$R/var/log/network.log" 2>/dev/null || true;;
    enable) touch "$BASE/autostart"; echo 'Boot autostart enabled';;
    disable) rm -f "$BASE/autostart"; echo 'Boot autostart disabled';;
    watch-network)
        # A separate lock prevents duplicate network watchers across restarts.
        exec 8>"$BASE/network.lock"
        flock -n 8 8>&8 || exit 0
        while [ -f "$BASE/running" ] && pid_of dockerd >/dev/null; do
            "$BASE/network.sh" ensure || true
            sleep 15
        done
        ;;
    start|stop|restart)
        exec 9>"$BASE/service.lock"
        flock -n 9 9>&9 || { echo 'Another lifecycle operation is running' >&2; exit 1; }
        case "$action" in
            start) start_engine;;
            stop) stop_engine;;
            restart) stop_engine; start_engine;;
        esac
        ;;
    *) echo 'Usage: moto-docker {start|stop|restart|status|log|enable|disable|shell|cli ARGS...|exec /PROGRAM...}' >&2; exit 2;;
esac
