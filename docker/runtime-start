#!/bin/sh
# Both engines must share this private mount namespace for snapshot mounts.
set -eu
# Android FUSE rejects arbitrary container UIDs. All backing-file operations
# below use this trusted helper's Android root identity; containers see a
# regular shared-files area. Native Docker volumes keep their Linux semantics.
/usr/bin/bindfs -f --force-user=0 --force-group=0 --perms=a+rwX \
    --create-as-mounter --create-with-perms=a+rwX \
    --chmod-ignore --chown-ignore --chgrp-ignore --xattr-none --direct-io \
    -o nosuid,nodev,noexec,attr_timeout=0,entry_timeout=0 \
    /mnt/android-shared /storage/emulated/0 >>/var/log/shared-storage.log 2>&1 &
printf '%s\n' "$!" >/run/bindfs.pid
shared_ready=0
for i in $(seq 1 50); do
    if grep -q ' /storage/emulated/0 fuse.bindfs ' /proc/mounts; then
        shared_ready=1; break
    fi
    kill -0 "$(cat /run/bindfs.pid)" || exit 1
    sleep 0.2
done
if [ "$shared_ready" != 1 ]; then
    echo 'Shared storage adapter did not become ready' >&2
    kill -TERM "$(cat /run/bindfs.pid)"
    exit 1
fi
/usr/bin/containerd --config /etc/containerd/config.toml >>/var/log/containerd.log 2>&1 &
printf '%s\n' "$!" >/run/containerd.pid
for i in $(seq 1 50); do
    if /usr/bin/ctr --address /run/containerd/containerd.sock version >/dev/null 2>&1; then
        exec /usr/bin/dockerd --config-file /etc/docker/daemon.json
    fi
    kill -0 "$(cat /run/containerd.pid)" || exit 1
    sleep 0.2
done
echo 'containerd did not become ready' >&2
kill -TERM "$(cat /run/containerd.pid)"
exit 1
