{
  "hosts": [
    "unix:///run/docker.sock"
  ],
  "data-root": "/var/lib/docker",
  "exec-root": "/run/docker",
  "pidfile": "/run/dockerd.pid",
  "storage-driver": "vfs",
  "features": {
    "containerd-snapshotter": false
  },
  "iptables": false,
  "ip6tables": false,
  "bridge": "none",
  "ip-forward": false,
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
