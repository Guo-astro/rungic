#!/system/bin/sh
set -eu
BASE=/data/adb/moto-plasma
ENTER=$BASE/moto-plasma-enter
ROOT=/data/adb/moto-lxc/runtime/var/lib/lxc/plasma/rootfs
[ "$(id -u)" = 0 ] || { echo 'Magisk root required' >&2; exit 1; }
action=${1:-status}
[ "$#" = 0 ] || shift
running() { [ "$("$ENTER" /usr/bin/lxc-info -n plasma -sH 2>/dev/null)" = RUNNING ]; }
attach() { "$ENTER" /usr/bin/lxc-attach -n plasma -- "$@"; }
device_rule() (
    # Android can assign different character-device majors after a reboot.
    [ -c "$1" ] || { echo "Missing character device: $1" >&2; exit 1; }
    major_hex=$(stat -c '%t' "$1") || exit 1
    minor_hex=$(stat -c '%T' "$1") || exit 1
    case "$major_hex:$minor_hex" in
      :*|*:|*[!0-9a-fA-F:]*) echo "Invalid device number: $1" >&2; exit 1;;
    esac
    printf 'lxc.cgroup2.devices.allow=c %d:%d %s\n' "0x$major_hex" "0x$minor_hex" "$2"
)
start_container() {
    gpu_rule=$(device_rule /dev/kgsl-3d0 rw)
    heap_rule=$(device_rule /dev/dma_heap/system r)
    label=$(ls -dZ /data/user/0/dev.moto.plasma/files | cut -d ' ' -f 1)
    case "$label" in u:object_r:app_data_file:s0:c*) ;;
      *) echo 'Cannot identify desktop APK SELinux label' >&2; exit 1;;
    esac
    printf '%s\n' "$label" | sed 's/:app_data_file:/:appdomain_tmpfs:/' > "$ROOT/etc/plasma/android-shm-context"
    "$ENTER" /usr/bin/lxc-start -n plasma -d -l INFO -o /var/log/lxc/plasma.log -s "$gpu_rule" -s "$heap_rule" 9>&-
}
case "$action" in
  account-status)
    if [ -f "$ROOT/etc/moto-plasma/account.json" ]; then
      cat "$ROOT/etc/moto-plasma/account.json"
    else
      echo '{"configured":false,"username":"linux"}'
    fi
    ;;
  account-setup)
    exec 9>"$BASE/control.lock"
    flock 9 9>&9
    if ! running; then start_container; fi
    attach /usr/local/libexec/moto-plasma-account-setup 9>&-
    ;;
  lock)
    # Acknowledge before Android suspends the foreground APK on screen-off.
    nohup /system/bin/sh -c 'sleep 0.3; /system/bin/input keyevent 223' >/dev/null 2>&1 </dev/null &
    exit 0
    ;;
  open)
    exec am start --user 0 -n dev.moto.plasma/.MainActivity
    ;;
  start|restart-session|stop)
    exec 9>"$BASE/control.lock"
    # Surface recreation and explicit restarts can overlap; serialize them.
    flock 9 9>&9
    if [ "$action" = stop ]; then
      if running; then "$ENTER" /usr/bin/lxc-stop -n plasma -t 15 9>&-; fi
      "$BASE/android-audio" stop 9>&-
      echo 'Plasma Mobile stopped'
      exit 0
    fi
    "$BASE/android-audio" start 9>&-
    # The container binds /storage/emulated/0/Plasma when it starts. After an Android
    # userspace restart vold remounts storage and that bind goes stale; only a
    # container restart recreates it (moto-plasma-shared otherwise fails forever).
    if running && ! attach /bin/sh -c 'test -r /mnt/android-shared/.' 9>&-; then
      echo 'Android storage was remounted; restarting the Plasma container' >&2
      "$ENTER" /usr/bin/lxc-stop -n plasma -t 15 9>&- || true
    fi
    old_pids=
    if [ "$action" = restart-session ] && running; then
      # The old compositor and shell take a moment to exit: readiness must see new ones.
      old_pids=$(attach /bin/sh -c 'echo $(pidof kwin_wayland) $(pidof plasmashell)' 9>&-) || old_pids=
      attach /bin/sh -c 'systemctl restart moto-plasma-session.service' 9>&-
    fi
    if ! running; then
      start_container
    fi
    ready=0
    for i in $(seq 1 60); do
      pids=$(attach /bin/sh -c 'test -f /run/user/1000/moto-session.env && k=$(pidof kwin_wayland) && p=$(pidof plasmashell) && echo $k $p' 9>&-) || pids=
      if [ -n "$pids" ]; then
        new=1
        for pid in $pids; do case " $old_pids " in *" $pid "*) new=0 ;; esac; done
        if [ "$new" = 1 ]; then ready=1; break; fi
      fi
      sleep 1
    done
    [ "$ready" = 1 ] || { echo 'Desktop did not become ready; use plasma log' >&2; exit 1; }
    echo 'Plasma Mobile ready (native Wayland)'
    ;;
  status) exec "$ENTER" /usr/bin/lxc-info -n plasma ;;
  hide-keyboard|home)
    exec "$ENTER" /usr/bin/lxc-attach -n plasma -- /usr/local/bin/moto-plasma-user-exec /usr/local/libexec/moto-plasma-desktop-action "$action"
    ;;
  shell) exec "$ENTER" /usr/bin/lxc-attach -n plasma -- /bin/sh -l ;;
  exec|user-exec)
    [ "$#" -gt 0 ] || { echo 'Command required' >&2; exit 2; }
    if [ "$action" = user-exec ]; then
      exec "$ENTER" /usr/bin/lxc-attach -n plasma -- /usr/local/bin/moto-plasma-user-exec "$@"
    fi
    exec "$ENTER" /usr/bin/lxc-attach -n plasma -- "$@"
    ;;
  log)
    # The session writes to the container journal; the file holds output from before that change.
    if running; then
      exec "$ENTER" /usr/bin/lxc-attach -n plasma -- journalctl -b -n 70 --no-pager -o short-precise -u moto-plasma-session.service
    fi
    tail -n 70 "$ROOT/var/log/plasma/session.log"
    ;;
  *) echo 'Usage: plasma {open|start|restart-session|stop|status|shell|exec COMMAND...|user-exec COMMAND...|log}' >&2; exit 2 ;;
esac
