#!/bin/sh
set -eu
# The desktop account's home follows its login (/home/<login>, docs/70).
export HOME=$(getent passwd 1000 | cut -d: -f6)
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XDG_MENU_PREFIX=plasma-
export LANG=zh_CN.UTF-8
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QUICK_BACKEND=software
export KWIN_COMPOSE=Q
export RUNGIC_ANDROID_DISPLAY=/mnt/android-wayland/android-display.ini
export PULSE_SERVER=unix:$XDG_RUNTIME_DIR/pulse/native
export PULSE_COOKIE=/var/lib/rungic-host/audio-cookie
[ ! -f /etc/profile.d/proxy.sh ] || . /etc/profile.d/proxy.sh
[ ! -f /etc/plasma/gpu-env ] || . /etc/plasma/gpu-env
unset DISPLAY WAYLAND_DISPLAY
while [ ! -S /mnt/android-wayland/wayland-0 ]; do sleep 1; done
mkdir -p "$HOME/.config"
# plasmashell turns one failed OpenGL start into a permanent software renderer for every Qt Quick
# program (plasma-workspace shell/main.cpp: SceneGraphBackend=software in kdeglobals). Here such a
# failure is transient, the Android display host restarting (an APK update), so it must not outlive
# the session: with the GPU present every session starts on it again. On 2026-09-27 a stale entry
# kept plasmashell software-rendered, and its app drawer (an OpacityMask shader) empty.
if [ -c /dev/kgsl-3d0 ] && [ -n "${QSG_RHI_BACKEND:-}" ] &&
   [ "$(kreadconfig6 --file kdeglobals --group QtQuickRendererSettings --key SceneGraphBackend 2>/dev/null)" = software ]; then
    kwriteconfig6 --file kdeglobals --group QtQuickRendererSettings --key SceneGraphBackend --delete || true
fi
# Fresh accounts need the directories as well as their XDG mappings (docs/69).
# The helper refuses an unmounted Shared and preserves existing user content.
/usr/libexec/rungic-user-dirs
# Android owns device locking: /etc/xdg/kscreenlockerrc (rungic-plasma-config) fixes
# Autolock and LockOnResume off for every user (docs/61).
umask 077
env | python3 -c 'import sys,shlex; print("".join("export "+k+"="+shlex.quote(v)+"\n" for k,v in (line.rstrip("\n").split("=",1) for line in sys.stdin) if k in ("HOME","XDG_RUNTIME_DIR","DBUS_SESSION_BUS_ADDRESS","XDG_SESSION_TYPE","XDG_CURRENT_DESKTOP","XDG_SESSION_DESKTOP","XDG_MENU_PREFIX","LANG","QT_QPA_PLATFORM","QT_QUICK_BACKEND","GDK_BACKEND","MOZ_ENABLE_WAYLAND","MESA_LOADER_DRIVER_OVERRIDE","FD_KGSL_ENABLE_DMABUF","VK_DRIVER_FILES","FLATPAK_GL_DRIVERS","QSG_RHI_BACKEND","GSK_RENDERER","PULSE_SERVER","PULSE_COOKIE","http_proxy","https_proxy","HTTP_PROXY","HTTPS_PROXY","no_proxy")))' > "$XDG_RUNTIME_DIR/rungic-session.env"
printf '%s\n' 'export WAYLAND_DISPLAY=wayland-0' >> "$XDG_RUNTIME_DIR/rungic-session.env"
# The user's settings across the Rungic rename (docs/70), then the project's one-time user
# migrations (rungic-plasma-config, rungic.upd) before KWin reads its configuration; kded
# would run them only after KWin has started.
/usr/libexec/rungic-rebrand-user up || true
/usr/lib/aarch64-linux-gnu/libexec/kf6/kconf_update || true
# Repair stale bootstrap menu caches before the shell reads them.
kbuildsycoca6 --noincremental
# The GPU settings into the user manager before any unit of the session starts: startplasma
# imports its environment too, but a unit (re)started earlier would run without them.
systemctl --user import-environment MESA_LOADER_DRIVER_OVERRIDE FD_KGSL_ENABLE_DMABUF VK_DRIVER_FILES \
    QSG_RHI_BACKEND GSK_RENDERER QT_QUICK_BACKEND KWIN_COMPOSE FLATPAK_GL_DRIVERS 2>/dev/null || true
# A restart of this unit stops its main process, but the previous session's startplasma-wayland
# lives on in its logind scope for a moment. When it quits it puts the user manager's environment
# back as it was before that session (plasma-workspace cleanupPlasmaEnvironment); quitting after
# this session had set its own, it removed PLASMA_DEFAULT_SHELL and plasmashell came up as the
# desktop shell (2026-09-28, the Android host restarting for an APK update). Let it finish first.
for _ in $(seq 100); do
    pgrep -u "$(id -u)" -f '^(/usr/bin/)?startplasma-wayland' >/dev/null || break
    sleep 0.1
done
pkill -KILL -u "$(id -u)" -f '^(/usr/bin/)?startplasma-wayland' 2>/dev/null || true
exec /usr/bin/startplasmamobile
