#!/bin/sh
set -eu
width=720
height=1600
if [ -f /mnt/android-wayland/android-display.ini ]; then
    width=$(sed -n 's/^width=\([0-9]*\)$/\1/p' /mnt/android-wayland/android-display.ini)
    height=$(sed -n 's/^height=\([0-9]*\)$/\1/p' /mnt/android-wayland/android-display.ini)
fi
# The GPU settings (Mesa's KGSL driver) from the file itself, not from the user manager's
# environment: when the unit starts before the session has imported it, Mesa finds no driver and
# KWin falls back to software compositing (2026-09-27, a deploy's session restart).
[ ! -f /etc/plasma/gpu-env ] || . /etc/plasma/gpu-env
# KWin's output buffers in Adreno UBWC: the host allocates them with gralloc and Mesa imports
# them (docs/57). Only KWin needs this; clients keep linear buffers. KWin's Android backend
# (--android-host, docs/72) needs no other settings: it knows the render device, the host's
# buffer lease socket and what the host offers.
export FD_KGSL_DMABUF_UBWC=1
# Mobile input fields should summon the OSK even after a synthetic pointer event.
export KWIN_IM_SHOW_ALWAYS=1
scale=$(awk -v w="$width" -v h="$height" 'BEGIN { edge=(w<h?w:h); print edge / 360 }')
width=$(awk -v w="$width" -v s="$scale" 'BEGIN { printf "%d", w/s }')
height=$(awk -v h="$height" -v s="$scale" 'BEGIN { printf "%d", h/s }')
# --android-host: KWin's Android backend (docs/72), which needs kwin-wayland +moto22 or later (+rungic1 now).
exec /usr/bin/kwin_wayland_wrapper --wayland-display=/mnt/android-wayland/wayland-0 --android-host \
    --width="$width" --height="$height" --scale="$scale" --no-lockscreen
