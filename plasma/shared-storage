#!/bin/sh
set -eu
# A bindfs that died (e.g. when Android restarted underneath it) leaves a
# disconnected FUSE mount; mkdir then fails and the unit would restart forever.
if ! stat /home/linux/Shared >/dev/null 2>&1; then
    fusermount3 -uz /home/linux/Shared 2>/dev/null || umount -l /home/linux/Shared 2>/dev/null || true
fi
mkdir -p /home/linux/Shared
chown root:root /home/linux/Shared
chmod 0755 /home/linux/Shared
# No --direct-io: with it FUSE refuses shared writable mmap (ENODEV), which
# SQLite WAL, LMDB and MMKV need; WeChat's databases in ~/Documents failed
# with I/O errors and were "repaired" on every start (docs/69). Without it
# the kernel page cache is used; FUSE still drops a file's cached pages when
# it is opened again and attr_timeout=0 keeps sizes and times current, so
# changes made on the Android side are seen on the next open.
exec /usr/bin/bindfs -f --force-user=1000 --force-group=1000 --perms=a+rwX \
    --create-as-mounter --create-with-perms=a+rwX \
    --chmod-ignore --chown-ignore --chgrp-ignore --xattr-none \
    -o nosuid,nodev,noexec,attr_timeout=0,entry_timeout=0 \
    /mnt/android-shared /home/linux/Shared
