# One coherent Mesa package family, with the distribution GLVND dispatchers.
export MESA_LOADER_DRIVER_OVERRIDE=kgsl
export FD_KGSL_ENABLE_DMABUF=1
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json
export KWIN_COMPOSE=O2ES
export MOTO_KWIN_RENDER_DEVICE=/dev/kgsl-3d0
export MOTO_GPU_ALLOCATOR=/mnt/android-wayland/moto-gpu-alloc
# Qt Quick renders with Vulkan (Turnip) in every Qt application, the shell included: the
# user's choice after docs/56's re-measurement (2026-09-26). The voice assistant kept its
# cadence at about 40% less CPU; plasmashell used 22% less CPU, its late frames leaning worse.
# KWin itself stays on OpenGL ES (KWIN_COMPOSE above): it has no Vulkan renderer.
export QSG_RHI_BACKEND=vulkan
export GSK_RENDERER=gl
export QT_QUICK_BACKEND=
unset LIBGL_ALWAYS_SOFTWARE LD_LIBRARY_PATH
