[Unit]
Description=Voice assistant overlay (holding the Home button, docs/67)
After=plasma-plasmashell.service rungic-voice-agent.service
Wants=rungic-voice-agent.service
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=com.rungic.VoiceAssistant
# Only once the desktop is there (docs/87): the overlay asks plasmashell for its panels over
# D-Bus while it loads. After= alone let it start while plasmashell's start was still timing
# out (the phone screen off, 2026-09-29); the overlay then hung until systemd killed it. Wait
# for plasmashell's bus name, for up to two minutes; later, Restart= tries again.
ExecStartPre=/bin/sh -c 'for i in $(seq 120); do busctl --user status org.kde.plasmashell >/dev/null 2>&1 && exit 0; sleep 1; done; echo "plasmashell not on the session bus after 120 s" >&2; exit 1'
ExecStart=/usr/bin/rungic-voice-assistant --overlay
TimeoutStartSec=180
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
