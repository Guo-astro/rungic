#!/bin/sh
# Whole desktop goals with JEV choosing every step (docs/64). Runs in its own
# virtualenv (typesafe-sdk, openai, anthropic) over moto-cua's desktop access.
[ -r /etc/profile.d/proxy.sh ] && . /etc/profile.d/proxy.sh
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
: "${DBUS_SESSION_BUS_ADDRESS:=unix:path=$XDG_RUNTIME_DIR/bus}"
: "${WAYLAND_DISPLAY:=wayland-0}"
export XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY
lib=/usr/local/lib/moto-clicker
PYTHONPATH=$lib:/usr/local/lib/moto-cua${PYTHONPATH:+:$PYTHONPATH} exec "$lib/venv/bin/python" -m moto_clicker "$@"
