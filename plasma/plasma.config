# Plasma: Android network namespace, no network-admin/raw capabilities.
lxc.uts.name = moto-plasma
lxc.rootfs.path = dir:/var/lib/lxc/plasma/rootfs
lxc.init.cmd = /usr/sbin/rungic-plasma-init
lxc.signal.halt = SIGRTMIN+3
lxc.signal.reboot = SIGTERM
lxc.mount.auto = proc:mixed sys:ro cgroup:rw
lxc.autodev = 1
lxc.pty.max = 16
lxc.tty.max = 0
lxc.console.path = none
lxc.net.0.type = none
lxc.cap.drop = mac_admin mac_override sys_time sys_module sys_rawio net_admin net_raw sys_boot
lxc.seccomp.profile = /usr/share/lxc/config/common.seccomp
lxc.cgroup2.devices.deny = a
lxc.cgroup2.devices.allow = c 1:3 rwm
lxc.cgroup2.devices.allow = c 1:5 rwm
lxc.cgroup2.devices.allow = c 1:7 rwm
lxc.cgroup2.devices.allow = c 1:8 rwm
lxc.cgroup2.devices.allow = c 1:9 rwm
lxc.cgroup2.devices.allow = c 5:0 rwm
lxc.cgroup2.devices.allow = c 5:1 rwm
lxc.cgroup2.devices.allow = c 5:2 rwm
lxc.cgroup2.devices.allow = c 136:* rwm
lxc.mount.entry = tmpfs tmp tmpfs nosuid,nodev,mode=1777 0 0
lxc.mount.entry = tmpfs run tmpfs nosuid,nodev,mode=0755 0 0
lxc.mount.entry = tmpfs dev/shm tmpfs nosuid,nodev,mode=1777,create=dir 0 0

lxc.cgroup2.devices.allow = c 10:229 rwm
lxc.mount.entry = /mnt/plasma-shared mnt/android-shared none bind,create=dir 0 0
lxc.mount.entry = /mnt/plasma-wayland mnt/android-wayland none bind,create=dir 0 0
lxc.mount.entry = /mnt/plasma-audio mnt/android-audio none bind,ro,create=dir 0 0
# Files from the Android side (shared-memory label, audio cookie, account state) and the host
# tools' transfer directory (docs/61 §7); moto-plasma creates the source before starting.
lxc.mount.entry = /var/lib/lxc/plasma/state/host var/lib/moto-host none bind,create=dir 0 0

# Adreno 710 uses Android's KGSL interface, not the display controller's DRM.
lxc.mount.entry = /dev/kgsl-3d0 dev/kgsl-3d0 none bind,create=file 0 0
lxc.mount.entry = /dev/dma_heap/system dev/dma_heap/system none bind,create=file 0 0
