# Local diversions that the distribution itself makes (usr-merge, minimized images).
SYSTEM_DIVERSION = re.compile(r'\.usr-is-merged$|^/usr/bin/man$|^/usr/bin/man\.REAL$')


def run(*argv, check=False):
    return subprocess.run(argv, capture_output=True, text=True, errors='replace', check=check).stdout


def dpkg_filters():
    """path-exclude/path-include rules in order; the last matching rule wins."""
    rules = []
    for name in sorted(glob.glob('/etc/dpkg/dpkg.cfg.d/*')) + ['/etc/dpkg/dpkg.cfg']:
        try:
            with open(name) as f:
                for line in f:
                    m = re.match(r'\s*(path-exclude|path-include)[= ]\s*(\S+)', line)
                    if m:
                        rules.append((m.group(1) == 'path-exclude', m.group(2)))
        except OSError:
            pass
    return rules


def excluded(path, rules):
    result = False
    for exclude, pattern in rules:
        if fnmatch.fnmatchcase(path, pattern):
            result = exclude
    return result


def usr_merged(path):
    for top in ('/bin/', '/sbin/', '/lib/', '/lib64/', '/lib32/', '/libx32/'):
        if path.startswith(top):
            return '/usr' + path
    return path


def check_packages(rules):
    changed, missing, conffiles = [], [], []
    for line in run('dpkg', '--verify').splitlines():
        m = re.match(r'(\S+)\s+(c\s+)?(/.*)$', line)
        if not m:
            continue
        flags, conf, path = m.group(1), bool(m.group(2)), m.group(3)
        if flags == 'missing':
            if not excluded(path, rules) and not excluded(usr_merged(path), rules):
                missing.append(path)
        elif conf:
            conffiles.append(path)
        else:
            changed.append(path)
    owners = {}
    if changed or missing:
        for line in run('dpkg', '-S', *(changed + missing)[:200]).splitlines():
            pkg, _, path = line.partition(': ')
            if not pkg.startswith('diversion'):
                owners[path] = pkg
    return {
        'changed': [{'path': p, 'package': owners.get(p)} for p in changed],
        'missing': [{'path': p, 'package': owners.get(p)} for p in missing],
        'conffiles_edited': conffiles,
    }


def check_diversions():
    project, system = [], []
    for line in run('dpkg-divert', '--list').splitlines():
        m = re.match(r'(local )?diversion (?:of|from) (\S+) to (\S+)(?: by (\S+))?', line)
        if not m:
            continue
        entry = {'path': m.group(2), 'divert_to': m.group(3), 'by': m.group(4) or 'local'}
        if m.group(4) or SYSTEM_DIVERSION.search(m.group(2)) or SYSTEM_DIVERSION.search(m.group(3)):
            system.append(entry)
        else:
            project.append(entry)
    return {'project': project, 'system_count': len(system)}


def installed_packages():
    packages = {}
    for line in run('dpkg-query', '-W', '-f', '${db:Status-Abbrev}\t${Package}\t${Version}\n').splitlines():
        status, name, version = line.split('\t')
        if status.startswith('ii') or status.startswith('hi'):
            packages[name] = version
    return packages


def release_info():
    try:
        with open(RELEASE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def release_dependencies():
    """Exact dependencies of the installed release metapackage."""
    text = run('dpkg-query', '-W', '-f', '${Depends}', 'rungic-release')
    deps = {}
    for item in text.split(','):
        m = re.match(r'\s*(\S+)\s*\(=\s*([^)]+)\)', item)
        if m:
            deps[m.group(1)] = m.group(2).strip()
    return deps


def check_rebuilt(packages, deps):
    held = set(run('apt-mark', 'showhold').split())
    # This project's rebuilds: +rungicN, or +motoN from before the Rungic rename (docs/70).
    rebuilt = [name for name, version in packages.items() if '+rungic' in version or '+moto' in version]
    policy = run('apt-cache', 'policy', *rebuilt) if rebuilt else ''
    candidates = {}
    for block in re.split(r'\n(?=\S)', policy):
        m = re.match(r'(\S+):\n\s+Installed: (\S+)\n\s+Candidate: (\S+)', block)
        if m:
            candidates[m.group(1)] = m.group(3)
    result = []
    for name in sorted(rebuilt):
        candidate = candidates.get(name)
        result.append({
            'package': name, 'version': packages[name],
            'protected_by': 'release' if name in deps else 'hold' if name in held else None,
            'archive_would_replace': bool(candidate and candidate not in ('(none)', packages[name])
                                          and '+rungic' not in candidate and '+moto' not in candidate),
            'candidate': candidate,
        })
    return result


def check_release(packages, deps):
    info = release_info()
    if not deps and not info:
        return {'installed': False}
    mismatch = [{'package': p, 'want': v, 'have': packages.get(p)} for p, v in sorted(deps.items())
                if packages.get(p) != v]
    return {'installed': 'rungic-release' in packages, 'version': packages.get('rungic-release'),
            'info': info, 'mismatch': mismatch}


def owned_paths():
    owned = set()
    for name in glob.glob('/var/lib/dpkg/info/*.list'):
        with open(name, errors='replace') as f:
            for line in f:
                path = line.rstrip('\n')
                owned.add(path)
                owned.add(usr_merged(path))
    for line in run('dpkg-divert', '--list').splitlines():
        m = re.match(r'(?:local )?diversion (?:of|from) (\S+) to (\S+)', line)
        if m:
            owned.update((m.group(1), m.group(2)))
    return owned


def declared_local(manifest):
    home = pwd.getpwuid(DESKTOP_UID).pw_dir
    paths = set()
    for item in manifest.get('files', []):
        for p in [item['path']] + item.get('alternatives', []):
            paths.add(p.replace('~', home, 1))
    return paths


def check_unowned(owned, local):
    found = {'/usr': [], '/etc': []}
    masks = []
    for top in found:
        for dirpath, dirnames, filenames in os.walk(top):
            if dirpath == '/usr' and 'local' in dirnames:
                dirnames.remove('local')   # /usr/local is reported by its own count
            for name in filenames + [d for d in dirnames if os.path.islink(os.path.join(dirpath, d))]:
                path = os.path.join(dirpath, name)
                if path in owned or path in local:
                    continue
                if os.path.islink(path) and os.readlink(path).startswith('/etc/alternatives/'):
                    continue   # update-alternatives
                if os.path.islink(path) and dirpath in ('/etc/systemd/system', '/etc/systemd/user'):
                    if os.readlink(path) == '/dev/null':
                        masks.append(path)
                    continue   # enable aliases are generated; masks are listed apart
                if any(fnmatch.fnmatchcase(path, g) for g in GENERATED):
                    continue
                found[top].append(path)
    usr_local = sum(len(f) for _, _, f in os.walk('/usr/local'))
    # /usr/local comes first in PATH and XDG_DATA_DIRS: a leftover there silently replaces a
    # packaged program or desktop entry (the old plasma-settings and portal did after 20260926.4).
    shadowing = []
    for local_dir, packaged_dirs in (('/usr/local/bin', ('/usr/bin', '/bin')), ('/usr/local/sbin', ('/usr/sbin', '/sbin')),
                                     ('/usr/local/libexec', ('/usr/libexec',)),
                                     ('/usr/local/share/applications', ('/usr/share/applications',)),
                                     ('/usr/local/share/dbus-1/services', ('/usr/share/dbus-1/services',))):
        try:
            names = os.listdir(local_dir)
        except OSError:
            continue
        for name in names:
            if name in ('mimeinfo.cache', 'icon-theme.cache'):
                continue   # caches regenerated by triggers for every data directory
            if any(os.path.lexists(os.path.join(d, name)) for d in packaged_dirs):
                shadowing.append(os.path.join(local_dir, name))
    return {'usr': sorted(found['/usr']), 'etc': sorted(found['/etc']), 'systemd_masks': sorted(masks),
            'usr_local_files': usr_local, 'usr_local_shadowing': sorted(shadowing)}


def check_ownership(local):
    problems = []
    for path in ('/', '/usr', '/usr/bin', '/usr/lib', '/usr/share', '/etc', '/var', '/var/lib', '/opt'):
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if st.st_uid != 0 or st.st_gid != 0 or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            problems.append({'path': path, 'uid': st.st_uid, 'gid': st.st_gid, 'mode': oct(st.st_mode & 0o7777)})
    user_owned = run('sh', '-c', "find /usr /etc -xdev ! -uid 0 ! -path '/usr/local/*' 2>/dev/null | head -50")
    return {'top_level': problems, 'non_root_files': [p for p in user_owned.split() if p not in local]}


def check_local(manifest):
    home = pwd.getpwuid(DESKTOP_UID).pw_dir
    result = []
    for item in manifest.get('files', []):
        candidates = [item['path']] + item.get('alternatives', [])
        path = next((p.replace('~', home, 1) for p in candidates if os.path.exists(p.replace('~', home, 1))),
                    None)
        entry = {'path': item['path'], 'present': path is not None, 'required': item.get('required', False)}
        if path:
            st = os.stat(path)
            owner = str(st.st_uid) if item.get('owner', '').isdigit() else pwd.getpwuid(st.st_uid).pw_name
            problems = []
            if item.get('owner') and owner != item['owner']:
                problems.append(f"owner {owner}, want {item['owner']}")
            if item.get('mode') and oct(st.st_mode & 0o7777) != oct(int(item['mode'], 8)):
                problems.append(f"mode {oct(st.st_mode & 0o7777)}, want {item['mode']}")
            if path != item['path'].replace('~', home, 1):
                entry['found_at'] = path
            entry['problems'] = problems
        result.append(entry)
    return result


def check_units():
    """Units the project's packages enable (/usr/share/rungic/units/*.list) that are not enabled: an
    upgrade once removed their enable links while the running session hid it (docs/61)."""
    problems = []
    for listing in sorted(glob.glob('/usr/share/rungic/units/*.list')):
        for line in open(listing):
            scope, _, unit = line.strip().partition(' ')
            if not unit:
                continue
            if scope == 'system':
                state = run('systemctl', 'is-enabled', unit).strip()
            else:
                state = run('systemctl', '--global', 'is-enabled', unit).strip()
            if state not in ('enabled', 'enabled-runtime', 'static', 'alias', 'indirect'):
                problems.append({'unit': unit, 'scope': scope, 'state': state or 'unknown',
                                 'package': os.path.basename(listing)[:-5]})
    return problems


def check_user_overrides():
    """User settings that silently take the desktop off the GPU. On 2026-09-26 a kdeglobals
    [QtQuickRendererSettings] SceneGraphBackend=software (writer not found) left the app drawer grid
    blank while the search field and panels still drew (docs/61)."""
    home = pwd.getpwuid(DESKTOP_UID).pw_dir
    problems = []
    for name in ('kdeglobals', 'plasma-mobile/kdeglobals'):
        path = os.path.join(home, '.config', name)
        group = None
        try:
            lines = open(path, errors='replace').read().splitlines()
        except OSError:
            continue
        for line in lines:
            line = line.strip()
            if line.startswith('['):
                group = line.split(']')[0][1:]
            elif group == 'QtQuickRendererSettings' and line.split('=')[0].split('[')[0] == 'SceneGraphBackend':
                problems.append(f"{path}: [QtQuickRendererSettings] {line}")
    env = run('sh', '-c', f'cat {home}/.config/environment.d/*.conf 2>/dev/null')
    for line in env.splitlines():
        if re.match(r'\s*(QT_QUICK_BACKEND|QSG_RHI_BACKEND|LIBGL_ALWAYS_SOFTWARE)=', line):
            problems.append(f'{home}/.config/environment.d: {line.strip()}')
    return problems


def check_crash():
    problems = []
    drkonqi = run('dpkg-query', '-W', '-f', '${db:Status-Abbrev}', 'drkonqi').startswith('ii')
    if drkonqi:
        env = run('sh', '-c', 'cat /etc/environment /etc/environment.d/*.conf /usr/lib/environment.d/*.conf '
                  '2>/dev/null')
        if not re.search(r'^\s*KCRASH_DUMP_ONLY=1', env, re.M):
            problems.append('drkonqi is installed without KCRASH_DUMP_ONLY=1: KDE crashes leave no core')
    # Services that hold credentials must not dump core (docs/61).
    for unit in ('rungic-voice-agent.service',):
        text = run('sh', '-c', f'cat /usr/lib/systemd/user/{unit} /etc/systemd/user/{unit} '
                   f'/etc/systemd/user/{unit}.d/*.conf 2>/dev/null')
        if text and not re.search(r'^\s*LimitCORE=0\s*$', text, re.M):
            problems.append(f'{unit} holds API keys but has no LimitCORE=0')
    mask = '/etc/sysctl.d/50-coredump.conf'
    if os.path.exists('/usr/lib/sysctl.d/50-coredump.conf') and os.path.realpath(mask) != '/dev/null':
        problems.append(f'{mask} is not masked: systemd-sysctl could redirect Android\'s core_pattern')
    return problems


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--manifest', default=LOCAL_MANIFEST)
    args = parser.parse_args()
    if os.geteuid() != 0:
        sys.exit('rungic-integrity: run as root in the container')
    try:
        with open(args.manifest) as f:
            manifest = json.load(f)
    except (OSError, ValueError):
        manifest = {}
    rules = dpkg_filters()
    packages = installed_packages()
    deps = release_dependencies()
    local = check_local(manifest)
    declared = declared_local(manifest)
    report = {
        'packages': check_packages(rules),
        'diversions': check_diversions(),
        'rebuilt': check_rebuilt(packages, deps),
        'release': check_release(packages, deps),
        'unowned': check_unowned(owned_paths(), declared),
        'ownership': check_ownership(declared),
        'local': local,
        'crash': check_crash(),
        'units': check_units(),
        'user_overrides': check_user_overrides(),
    }
    drift = {
        'changed_files': len(report['packages']['changed']),
        'missing_files': len(report['packages']['missing']),
        'unprotected_rebuilt': sum(1 for r in report['rebuilt'] if not r['protected_by']),
        'replaceable_rebuilt': sum(1 for r in report['rebuilt']
                                   if r['archive_would_replace'] and r['protected_by'] != 'hold'),
        'release_mismatch': len(report['release'].get('mismatch', [])),
        'unowned_usr': len(report['unowned']['usr']),
        'unowned_etc': len(report['unowned']['etc']),
        'unowned_systemd_masks': len(report['unowned']['systemd_masks']),
        'usr_local_shadowing': len(report['unowned']['usr_local_shadowing']),
        'ownership': len(report['ownership']['top_level']) + len(report['ownership']['non_root_files']),
        'local_missing_required': sum(1 for e in local if e['required'] and not e['present']),
        'local_permissions': sum(1 for e in local if e.get('problems')),
        'crash_chain': len(report['crash']),
        'units_not_enabled': len(report['units']),
        'user_overrides': len(report['user_overrides']),
    }
    development = bool(report['diversions']['project'])
    state = 'drift' if any(drift.values()) else 'development' if development else 'clean'
    report['summary'] = {'state': state, 'development': development,
                         'project_diversions': len(report['diversions']['project']), **drift}
    if args.json:
        json.dump(report, sys.stdout, ensure_ascii=False, indent=1)
        print()
    else:
        s = report['summary']
        print(f"state: {s['state']}")
        for key, value in s.items():
            if key not in ('state',) and value:
                print(f'  {key}: {value}')
        for p in report['packages']['changed']:
            print(f"changed  {p['path']} ({p['package']})")
        for p in report['packages']['missing']:
            print(f"missing  {p['path']} ({p['package']})")
        for p in report['packages']['conffiles_edited']:
            print(f'conffile {p}')
        for d in report['diversions']['project']:
            print(f"divert   {d['path']}")
        for r in report['rebuilt']:
            flag = '' if r['protected_by'] else '  UNPROTECTED'
            flag += f"  archive would replace with {r['candidate']}" if r['archive_would_replace'] else ''
            print(f"rebuilt  {r['package']} {r['version']} [{r['protected_by'] or '-'}]{flag}")
        for m in report['release'].get('mismatch', []):
            print(f"release  {m['package']}: want {m['want']}, have {m['have']}")
        for top in ('usr', 'etc'):
            for p in report['unowned'][top]:
                print(f'unowned  {p}')
        for p in report['unowned']['systemd_masks']:
            print(f'mask     {p} (no package)')
        print(f"/usr/local files: {report['unowned']['usr_local_files']}")
        for p in report['unowned']['usr_local_shadowing']:
            print(f'shadows  {p} (a packaged file of the same name)')
        for p in report['ownership']['top_level']:
            print(f"owner    {p['path']} uid={p['uid']} gid={p['gid']} mode={p['mode']}")
        for p in report['ownership']['non_root_files']:
            print(f'owner    {p} (not root)')
        for p in report['crash']:
            print(f'crash    {p}')
        for p in report['user_overrides']:
            print(f'override {p}')
        for u in report['units']:
            print(f"unit     {u['unit']} ({u['scope']}, {u['package']}) is {u['state']}")
        for e in local:
            if not e['present']:
                print(f"local    {e['path']} absent{' (required)' if e['required'] else ''}")
            for problem in e.get('problems', []):
                print(f"local    {e['path']}: {problem}")
    sys.exit(1 if state == 'drift' else 2 if state == 'development' else 0)


if __name__ == '__main__':
    main()
