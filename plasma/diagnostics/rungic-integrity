#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Integrity and drift check of the Plasma container rootfs (docs/61).

Read-only. Compares the installed system with what dpkg, the release
metapackage and the local-configuration manifest say it should be:

  packages   files of installed packages changed or missing (dpkg --verify,
             honouring dpkg path-exclude/path-include); edited conffiles
  diversions local dpkg diversions by this project (a development state)
  rebuilt    +rungic (+moto) packages: protected by the release or a hold, and whether
             an archive version would replace them
  release    installed versions against rungic-release's dependencies
  unowned    files in /usr and /etc that no package owns and that are not
             known generated state or declared local configuration; files in
             /usr/local that shadow a packaged command, libexec program,
             desktop entry or D-Bus service
  ownership  owner/mode of the top-level directories; files in /usr, /etc
             owned by a non-root user
  local      declared machine-local configuration: presence and permissions
  units      units the project's packages enable (/usr/share/rungic/units) are enabled
  crash      the crash chain's preconditions: no DrKonqi without
             KCRASH_DUMP_ONLY (it would take over KDE crashes and leave no
             core), systemd-coredump's core_pattern sysctl masked

  rungic-integrity            text report
  rungic-integrity --json     machine-readable result

Exit status: 0 clean, 1 drift found, 2 development state (project diversions)
and no other drift.
"""
import argparse
import fnmatch
import glob
import json
import os
import pwd
import re
import stat
import subprocess
import sys

LOCAL_MANIFEST = '/usr/share/rungic/local-config.json'
RELEASE = '/usr/share/rungic/release.json'
DESKTOP_UID = 1000

