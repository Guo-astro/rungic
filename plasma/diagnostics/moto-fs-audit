# SPDX-License-Identifier: MIT
"""Filesystem and container capability audit (docs/69).

Runs the file operations that desktop applications rely on in each directory
they store data in, and reports what does not work and which kind of
application it breaks. A mount that fails here breaks every application
using that operation there, so fixes belong to the mount, not the app.

  moto-fs-audit                     the standard targets (home, XDG user dirs, /tmp, ...)
  moto-fs-audit DIR...              only these directories
  moto-fs-audit --json              machine-readable result
  moto-fs-audit --env               also the container limits (inotify, fds, namespaces, ...)

Run as the desktop user. Exit status 1 when a check marked essential fails.
"""
import argparse
import ctypes
import errno
import fcntl
import json
import mmap
import os
import resource
import shutil
import socket
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time

libc = ctypes.CDLL(None, use_errno=True)
F_OFD_SETLK = 37
IN_CREATE, IN_CLOSE_WRITE, IN_MOVED_TO = 0x100, 0x8, 0x80
RENAME_NOREPLACE, RENAME_EXCHANGE = 1, 2
AT_FDCWD = -100

# name: (essential, what breaks when it fails)
CHECKS = {}


def check(name, essential, breaks):
    def register(fn):
        CHECKS[name] = (fn, essential, breaks)
        return fn
    return register


def fail_from(e):
    return f'{type(e).__name__}: {e}'


@check('mmap_shared', True, 'SQLite WAL (WeChat, browsers, Akonadi, many apps), LMDB, MMKV, Qt/Chromium caches')
def mmap_shared(d):
    p = os.path.join(d, 'm')
    fd = os.open(p, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.ftruncate(fd, 65536)
        m = mmap.mmap(fd, 65536, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
        m[100:104] = b'moto'
        m.flush()
        m.close()
        return os.pread(fd, 4, 100) == b'moto' or 'written data not visible through read()'
    finally:
        os.close(fd)


@check('sqlite_wal', True, 'SQLite in WAL mode: WeChat, Firefox/Chromium profiles, Signal, Telegram, KDE PIM, Zotero')
def sqlite_wal(d):
    p = os.path.join(d, 'wal.db')
    a = sqlite3.connect(p, timeout=2)
    try:
        if a.execute('pragma journal_mode=wal').fetchone()[0] != 'wal':
            return 'journal_mode stays non-WAL'
        a.execute('create table t(x)')
        a.executemany('insert into t values(?)', [(i,) for i in range(500)])
        a.commit()
        b = sqlite3.connect(p, timeout=2)
        n = b.execute('select count(*) from t').fetchone()[0]
        b.close()
        ok = a.execute('pragma integrity_check').fetchone()[0]
        return (n == 500 and ok == 'ok') or f'rows {n}, integrity {ok}'
    finally:
        a.close()


@check('sqlite_rollback', True, 'SQLite with a rollback journal (the default mode)')
def sqlite_rollback(d):
    c = sqlite3.connect(os.path.join(d, 'j.db'), timeout=2)
    try:
        c.execute('create table t(x)')
        c.execute('insert into t values(1)')
        c.commit()
        return c.execute('select count(*) from t').fetchone()[0] == 1
    finally:
        c.close()


def _lock_contended(d, take, probe):
    """take(fd) in this process, then probe(fd) in a child must fail with EAGAIN/EACCES."""
    p = os.path.join(d, 'lock')
    fd = os.open(p, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        take(fd)
        pid = os.fork()
        if pid == 0:
            fd2 = os.open(p, os.O_RDWR)
            try:
                probe(fd2)
                os._exit(1)          # got the lock: not exclusive
            except OSError as e:
                os._exit(0 if e.errno in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK) else 2)
        status = os.waitpid(pid, 0)[1]
        code = os.waitstatus_to_exitcode(status)
        return code == 0 or ('second process also got the lock' if code == 1 else 'lock probe failed in child')
    finally:
        os.close(fd)


@check('posix_lock', True, 'fcntl record locks: SQLite, LibreOffice, Qt QLockFile, git, dpkg-style tools')
def posix_lock(d):
    return _lock_contended(d, lambda fd: fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB),
                           lambda fd: fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB))


@check('flock', True, 'flock(): Chromium/Electron singleton, KDE KConfig lock files, many CLIs')
def flock_(d):
    return _lock_contended(d, lambda fd: fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB),
                           lambda fd: fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB))


@check('ofd_lock', False, 'open-file-description locks: newer SQLite builds, systemd tools, glib')
def ofd_lock(d):
    import struct
    fd = os.open(os.path.join(d, 'ofd'), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        arg = struct.pack('hhqqi4x', fcntl.F_WRLCK, 0, 0, 0, 0)
        fcntl.fcntl(fd, F_OFD_SETLK, arg)
        return True
    finally:
        os.close(fd)


@check('atomic_replace', True, 'save-by-rename (write temp, rename over the file): nearly every editor and settings store')
def atomic_replace(d):
    a, b = os.path.join(d, 'a'), os.path.join(d, 'b')
    for p, t in ((a, b'old'), (b, b'new')):
        with open(p, 'wb') as f:
            f.write(t)
    os.rename(b, a)
    with open(a, 'rb') as f:
        return f.read() == b'new'


@check('renameat2', False, 'RENAME_NOREPLACE/EXCHANGE: GLib/GIO safe saves, some package managers')
def renameat2(d):
    a, b = os.path.join(d, 'x'), os.path.join(d, 'y')
    for p in (a, b):
        open(p, 'w').close()
    r = libc.renameat2(AT_FDCWD, a.encode(), AT_FDCWD, b.encode(), RENAME_EXCHANGE)
    if r != 0:
        e = ctypes.get_errno()
        return f'RENAME_EXCHANGE: {os.strerror(e)}'
    return True


@check('symlink', False, 'symlinks in data dirs: Electron/Chromium SingletonLock, npm/pip trees, Wine prefixes, archives')
def symlink(d):
    t = os.path.join(d, 'target')
    open(t, 'w').close()
    os.symlink('target', os.path.join(d, 'link'))
    return os.readlink(os.path.join(d, 'link')) == 'target'


@check('hardlink', False, 'hard links: git, rsync --link-dest, backup tools, some installers')
def hardlink(d):
    t = os.path.join(d, 'h1')
    open(t, 'w').close()
    os.link(t, os.path.join(d, 'h2'))
    return os.stat(t).st_nlink == 2 or 'link count not 2'


@check('chmod', False, 'permission bits: ssh keys (must be 0600), gpg, apps that verify their own files are private')
def chmod_(d):
    p = os.path.join(d, 'c')
    fd = os.open(p, os.O_CREAT | os.O_WRONLY, 0o600)
    os.close(fd)
    created = stat.S_IMODE(os.stat(p).st_mode)
    os.chmod(p, 0o600)
    after = stat.S_IMODE(os.stat(p).st_mode)
    return after == 0o600 or f'create 0600 -> {oct(created)}, chmod 0600 -> {oct(after)}'


@check('exec', False, 'running programs stored there: AppImages, downloaded installers, scripts, game launchers')
def exec_(d):
    p = os.path.join(d, 'run.sh')
    with open(p, 'w') as f:
        f.write('#!/bin/sh\necho ok\n')
    os.chmod(p, 0o755)
    r = subprocess.run([p], capture_output=True, text=True, timeout=5)
    return r.stdout.strip() == 'ok' or (r.stderr.strip() or f'exit {r.returncode}')


@check('xattr', False, 'extended attributes: download origin (Dolphin/Firefox), KDE file tags, Wine DOS attributes')
def xattr_(d):
    p = os.path.join(d, 'xa')
    open(p, 'w').close()
    os.setxattr(p, 'user.moto.test', b'1')
    return os.getxattr(p, 'user.moto.test') == b'1'


@check('unix_socket', False, 'sockets in app dirs: Chromium/Electron SingletonSocket, IDE language servers, gpg-agent')
def unix_socket(d):
    s = socket.socket(socket.AF_UNIX)
    try:
        s.bind(os.path.join(d, 'sock'))
        return True
    finally:
        s.close()


@check('fifo', False, 'named pipes: some IPC setups, shell tools')
def fifo(d):
    os.mkfifo(os.path.join(d, 'fifo'))
    return True


@check('inotify', True, 'change notification: Dolphin, file pickers, IDEs, sync clients, music libraries')
def inotify(d):
    fd = libc.inotify_init1(os.O_NONBLOCK)
    if fd < 0:
        return 'inotify_init1: ' + os.strerror(ctypes.get_errno())
    try:
        wd = libc.inotify_add_watch(fd, d.encode(), IN_CREATE | IN_CLOSE_WRITE | IN_MOVED_TO)
        if wd < 0:
            return 'inotify_add_watch: ' + os.strerror(ctypes.get_errno())
        with open(os.path.join(d, 'notify'), 'w') as f:
            f.write('x')
        deadline = time.monotonic() + 1
        while time.monotonic() < deadline:
            try:
                if os.read(fd, 4096):
                    return True
            except BlockingIOError:
                time.sleep(0.02)
        return 'no event for a file created in the directory'
    finally:
        os.close(fd)


@check('fallocate', False, 'preallocation: torrent clients, VM images, downloaders, databases growing files')
def fallocate(d):
    fd = os.open(os.path.join(d, 'fa'), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.posix_fallocate(fd, 0, 1 << 20)
        return os.fstat(fd).st_size == 1 << 20 or 'size not extended'
    finally:
        os.close(fd)


@check('sparse', False, 'sparse files: VM/disk images, torrent downloads (space use)')
def sparse(d):
    p = os.path.join(d, 'sp')
    with open(p, 'wb') as f:
        f.truncate(256 << 20)
    st = os.stat(p)
    return st.st_blocks * 512 < (16 << 20) or f'256 MiB hole uses {st.st_blocks * 512 >> 20} MiB'


@check('o_direct', False, 'O_DIRECT: databases and VM tools that bypass the page cache')
def o_direct(d):
    fd = os.open(os.path.join(d, 'od'), os.O_RDWR | os.O_CREAT | os.O_DIRECT, 0o600)
    try:
        buf = mmap.mmap(-1, 4096)
        buf.write(b'x' * 4096)
        return os.write(fd, buf) == 4096
    finally:
        os.close(fd)


@check('o_tmpfile', False, 'anonymous temp files (O_TMPFILE): systemd tools, some safe-save code')
def o_tmpfile(d):
    fd = os.open(d, os.O_TMPFILE | os.O_WRONLY, 0o600)
    try:
        os.write(fd, b'x')
        os.link(f'/proc/self/fd/{fd}', os.path.join(d, 'linked'), follow_symlinks=True)
        return True
    finally:
        os.close(fd)


@check('mtime', False, 'setting timestamps: rsync, archive extraction, build tools, sync clients')
def mtime(d):
    p = os.path.join(d, 't')
    open(p, 'w').close()
    os.utime(p, ns=(1_600_000_000_123_456_789, 1_600_000_000_123_456_789))
    got = os.stat(p).st_mtime_ns
    return abs(got - 1_600_000_000_123_456_789) < 2_000_000_000 or f'mtime {got}'


@check('case_sensitive', False, 'two names differing only in case (Linux software assumes this works)')
def case_sensitive(d):
    for n in ('Case', 'case'):
        with open(os.path.join(d, n), 'w') as f:
            f.write(n)
    with open(os.path.join(d, 'Case')) as f:
        return f.read() == 'Case' or 'names differing in case refer to the same file'


@check('names', False, 'Linux-legal file names with : ? * " < > | and trailing dots/spaces')
def names(d):
    bad = []
    for n in ('a:b', 'what?', 'star*', 'q"uote', 'lt<gt>', 'pi|pe', 'dot.', 'space ', '中文 名称', 'x' * 255):
        try:
            open(os.path.join(d, n), 'w').close()
        except OSError as e:
            bad.append(f'{n[:12]!r}: {e.strerror}')
    return not bad or '; '.join(bad)


@check('statvfs', False, 'free space reporting: installers and downloaders refusing to run')
def statvfs(d):
    s = os.statvfs(d)
    free = s.f_bavail * s.f_frsize
    return free > (64 << 20) or f'reports {free >> 20} MiB free'


def audit(target):
    result = {'target': target}
    try:
        real = os.path.realpath(target)
        result['realpath'] = real
        mount = subprocess.run(['findmnt', '-n', '-T', real, '-o', 'TARGET,FSTYPE,OPTIONS'],
                               capture_output=True, text=True).stdout.split()
        result['mount'] = {'target': mount[0], 'fstype': mount[1], 'options': mount[2]} if len(mount) >= 3 else None
        base = tempfile.mkdtemp(dir=real, prefix='.moto-fs-audit-')
    except OSError as e:
        result['error'] = fail_from(e)
        return result
    checks = {}
    try:
        for name, (fn, essential, breaks) in CHECKS.items():
            d = os.path.join(base, name)
            os.mkdir(d)
            try:
                r = fn(d)
                ok = r is True
                detail = '' if ok else (r if isinstance(r, str) else 'failed')
            except Exception as e:  # noqa: BLE001 - every failure is a finding
                ok, detail = False, fail_from(e)
            checks[name] = {'ok': ok, 'essential': essential, 'detail': detail, 'breaks': breaks}
    finally:
        shutil.rmtree(base, ignore_errors=True)
    result['checks'] = checks
    return result


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError as e:
        return fail_from(e)


def environment():
    env = {}
    env['inotify.max_user_watches'] = read('/proc/sys/fs/inotify/max_user_watches')
    env['inotify.max_user_instances'] = read('/proc/sys/fs/inotify/max_user_instances')
    env['vm.max_map_count'] = read('/proc/sys/vm/max_map_count')
    env['fs.file-max'] = read('/proc/sys/fs/file-max')
    env['kernel.max_user_namespaces'] = read('/proc/sys/user/max_user_namespaces')
    env['nofile (soft/hard)'] = '/'.join(map(str, resource.getrlimit(resource.RLIMIT_NOFILE)))
    env['memlock (soft/hard)'] = '/'.join(map(str, resource.getrlimit(resource.RLIMIT_MEMLOCK)))
    env['nproc (soft/hard)'] = '/'.join(map(str, resource.getrlimit(resource.RLIMIT_NPROC)))
    for name, argv in (('unshare --user', ['unshare', '--user', '--map-root-user', 'true']),
                       ('unshare --user --pid --mount', ['unshare', '--user', '--map-root-user', '--pid', '--fork', '--mount', 'true']),
                       ('bwrap (Flatpak sandbox)', ['bwrap', '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc', 'true'])):
        if shutil.which(argv[0]) is None:
            env[name] = 'not installed'
            continue
        r = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        env[name] = 'ok' if r.returncode == 0 else (r.stderr.strip().splitlines() or [f'exit {r.returncode}'])[-1]
    env['memfd_create'] = 'ok' if libc.memfd_create(b'moto', 0) >= 0 else os.strerror(ctypes.get_errno())
    for path in ('/dev/shm', '/tmp', os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())):
        s = os.statvfs(path)
        env[f'free {path}'] = f'{s.f_bavail * s.f_frsize >> 20} MiB'
    return env


def default_targets():
    home = os.path.expanduser('~')
    targets = [home, os.path.join(home, '.cache'), os.path.join(home, '.local/share')]
    for key in ('DESKTOP', 'DOCUMENTS', 'DOWNLOAD', 'MUSIC', 'PICTURES', 'VIDEOS'):
        try:
            p = subprocess.run(['xdg-user-dir', key], capture_output=True, text=True).stdout.strip()
        except OSError:
            p = ''
        if p and p != home and os.path.isdir(p):
            targets.append(p)
    runtime = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    targets += ['/tmp', '/var/tmp', '/dev/shm', runtime]
    seen, unique = set(), []
    for t in targets:
        r = os.path.realpath(t)
        if os.path.isdir(t) and r not in seen:
            seen.add(r)
            unique.append(t)
    return unique


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('targets', nargs='*')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--env', action='store_true', help='also report container limits')
    args = parser.parse_args()
    results = [audit(t) for t in (args.targets or default_targets())]
    env = environment() if args.env else None
    if args.json:
        print(json.dumps({'targets': results, 'environment': env}, ensure_ascii=False, indent=1))
    else:
        for r in results:
            m = r.get('mount') or {}
            print(f"== {r['target']}  ({m.get('fstype', '?')} at {m.get('target', '?')})")
            if 'error' in r:
                print('   cannot test:', r['error'])
                continue
            failed = {k: v for k, v in r['checks'].items() if not v['ok']}
            print(f"   {len(r['checks']) - len(failed)}/{len(r['checks'])} ok")
            for k, v in failed.items():
                print(f"   {'FAIL*' if v['essential'] else 'fail '} {k}: {v['detail']}")
                print(f"         breaks: {v['breaks']}")
        if env:
            print('== environment')
            for k, v in env.items():
                print(f'   {k}: {v}')
    essential_failed = any(not c['ok'] and c['essential'] for r in results for c in r.get('checks', {}).values())
    return 1 if essential_failed else 0


if __name__ == '__main__':
    sys.exit(main())
