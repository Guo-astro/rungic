# Rootless Docker for each desktop user (docs/85). Off by default: Settings -> Services turns it
# on (service-policy.json, group "docker"). Based on Docker's dockerd-rootless-setuptool.sh unit.
[Unit]
Description=Docker (rootless)
Documentation=https://docs.docker.com/go/rootless/

[Service]
Environment=PATH=/usr/share/docker.io/contrib:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# dockerd-rootless.sh runs DOCKERD inside RootlessKit's namespaces (dockerd-child).
Environment=DOCKERD=/usr/libexec/rungic-docker/dockerd-child
# slirp4netns with RootlessKit's own port forwarding: pasta is experimental in RootlessKit and
# allows only its implicit port driver, under which published ports were unreachable.
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=builtin
# On the root filesystem (ext4): /home is Android's f2fs, which overlayfs refuses. By UID, so
# the data stays with the account when its login name changes.
Environment=RUNGIC_DOCKER_DATA=/var/lib/rungic-docker/%U
ExecStartPre=/bin/sh -c 'test -O "$$RUNGIC_DOCKER_DATA" || { echo "$$RUNGIC_DOCKER_DATA is missing or not ours: rungic-docker-prepare.service creates it" >&2; exit 1; }'
ExecStart=/usr/share/docker.io/contrib/dockerd-rootless.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=notify
NotifyAccess=all
KillMode=mixed

[Install]
WantedBy=default.target
