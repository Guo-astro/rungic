#!/bin/sh
# DOCKERD for dockerd-rootless.sh (docs/85): runs in RootlessKit's user, mount and network
# namespaces, right before dockerd.
set -eu
# Docker writes its containers' network sysctls (disable_ipv6 and others), but the container
# keeps /proc/sys read-only. Only this mount namespace gets a writable /proc/sys/net, from the
# unmasked proc the container config mounts for nesting; the desktop keeps the read-only one,
# so nothing else writes Android's network parameters.
if [ -d /dev/.lxc/proc/sys/net ]; then
    mount --bind /dev/.lxc/proc/sys/net /proc/sys/net
else
    echo "rungic-docker: no /dev/.lxc/proc (the container config has no nesting mounts); containers will not start" >&2
fi
sysctl -qw net.ipv4.ip_forward=1 || true
# Docker's own NAT rules use xt_addrtype, which the kernel lacks (docs/19): dockerd runs with
# --iptables=false, and container traffic leaving through RootlessKit's tap0 is masqueraded here.
iptables -t nat -C POSTROUTING -o tap0 -j MASQUERADE 2>/dev/null ||
    iptables -t nat -A POSTROUTING -o tap0 -j MASQUERADE
# Image pulls go through the phone's proxy when one is configured (rungic-firstboot.sh).
if [ -r /etc/profile.d/proxy.sh ]; then . /etc/profile.d/proxy.sh; fi
exec dockerd --data-root "$RUNGIC_DOCKER_DATA" --iptables=false --ip6tables=false "$@"
