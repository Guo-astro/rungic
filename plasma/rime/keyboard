#!/bin/sh
set -eu
# Only this process receives the QML plugin and layout search paths.
export QML_IMPORT_PATH=/usr/lib/rungic-rime/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}
export XDG_DATA_DIRS=/usr/share/rungic-rime:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
export QT_LOGGING_RULES='qt.virtualkeyboard.*.debug=false'
exec /usr/bin/plasma-keyboard "$@"   # plasma-keyboard +moto (vendor/plasma-keyboard)
