[Unit]
Description=Android and Plasma plain-text clipboard
After=plasma-kwin_wayland.service
PartOf=graphical-session.target

[Service]
# wl-copy/wl-paste 2.3.0 (ext-data-control) come from the rebuilt wl-clipboard package (docs/61).
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/moto-clipboard
Restart=on-failure
RestartSec=5

[Install]
WantedBy=plasma-workspace.target
