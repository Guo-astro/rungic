#!/bin/sh
# Codex for the Plasma desktop (docs/59). Every Codex process -- login, CLI,
# app-server, the realtime WebSocket -- must reach OpenAI through the user's
# proxy, whoever starts it; reqwest and Codex's WebSocket dialer both read these.
. /etc/profile.d/proxy.sh
exec /usr/lib/codex/current/bin/codex "$@"
