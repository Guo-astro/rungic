{
  "name": "rungic-plasma-session",
  "formerly": "moto-plasma-session",
  "architecture": "arm64",
  "build": "device",
  "paths": [
    "plasma/init",
    "plasma/session",
    "plasma/user-dirs",
    "plasma/shared-storage",
    "plasma/kwin",
    "plasma/user-exec",
    "plasma/desktop-action.py",
    "plasma/rebrand-user.py",
    "plasma/rebrand-system.sh",
    "plasma/display.py",
    "plasma/brightness.py",
    "plasma/power-policy.py",
    "plasma/account",
    "plasma/screen-metrics.cpp",
    "plasma/rungic-plasma-session.service",
    "plasma/rungic-plasma-shared.service",
    "plasma/rungic-plasma-display.service",
    "plasma/rungic-plasma-brightness.service",
    "plasma/kwin-override.conf",
    "plasma/pulse-override.conf"
  ],
  "depends": "rungic-plasma-config, python3, python3-gi, bindfs, xdg-user-dirs, kwin-wayland (>= 4:6.6.6-0ubuntu0.1+rungic7~), plasma-mobile, pulseaudio",
  "build_depends": [
    "qt6-base-dev",
    "pkgconf",
    "g++"
  ],
  "description": "Plasma Mobile on Android: session\nContainer init, the Plasma Mobile session on the Android Wayland host, the KWin and\nPulseAudio service overrides, Android display insets, brightness and power policy,\nshared storage, the first-run account setup and the desktop user command wrapper.",
  "units": {
    "system": [
      "rungic-plasma-session.service",
      "rungic-plasma-shared.service"
    ],
    "user": [
      "rungic-plasma-display.service",
      "rungic-plasma-brightness.service"
    ]
  },
  "obsolete": [
    "/usr/local/sbin/moto-plasma-init",
    "/usr/local/libexec/moto-plasma-session",
    "/usr/local/libexec/moto-plasma-shared",
    "/usr/local/libexec/moto-plasma-kwin",
    "/usr/local/libexec/moto-plasma-desktop-action",
    "/usr/local/libexec/moto-plasma-display",
    "/usr/local/libexec/moto-plasma-brightness",
    "/usr/local/libexec/moto-power-policy.py",
    "/usr/local/libexec/moto-plasma-account-setup",
    "/usr/local/libexec/__pycache__",
    "/usr/local/bin/moto-plasma-user-exec",
    "/usr/local/bin/moto-plasma-screen-metrics",
    "/usr/local/share/applications/moto-account.desktop",
    "/etc/systemd/system/moto-plasma-session.service",
    "/etc/systemd/system/moto-plasma-shared.service",
    "/etc/systemd/system/multi-user.target.wants/moto-plasma-session.service",
    "/etc/systemd/system/multi-user.target.wants/moto-plasma-shared.service",
    "/etc/systemd/user/moto-plasma-display.service",
    "/etc/systemd/user/moto-plasma-brightness.service",
    "/etc/systemd/user/plasma-kwin_wayland.service.d",
    "/etc/systemd/user/pulseaudio.service.d",
    "/usr/lib/aarch64-linux-gnu/qt6/plugins/kwin/plugins/screencast.so.moto3",
    "/etc/plasma/android-shm-context",
    "/etc/plasma/audio-cookie",
    "/etc/moto-plasma/account.json",
    "/etc/moto-plasma"
  ],
  "user_systemd": true
}
