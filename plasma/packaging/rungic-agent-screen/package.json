{
  "name": "rungic-agent-screen",
  "formerly": "moto-agent-screen",
  "architecture": "arm64",
  "build": "device",
  "paths": ["plasma/agent-screen"],
  "depends": "python3, kwin-wayland, plasma-mobile",
  "build_depends": ["cmake", "qt6-base-dev", "qt6-declarative-dev", "qt6-wayland-dev", "liblayershellqtinterface-dev",
                    "plasma-wayland-protocols"],
  "description": "Plasma Mobile on Android: desktop mode and the assistant's screen\nDesktop mode (a full desktop on a second screen) and the agent's workspace, each in a floating\nwindow that folds to the edge (docs/65, docs/research/91); desktop mode's quick setting.",
  "obsolete": ["/usr/local/bin/moto-agent-screen", "/usr/local/libexec/moto-agent-screen-window",
               "/usr/local/bin/moto-virtual-screen", "/usr/share/applications/dev.moto.VirtualScreen.desktop",
               "/etc/xdg/autostart/dev.moto.VirtualScreen.desktop",
               "/usr/share/plasma/quicksettings/com.rungic.quicksetting.agentscreen"]
}
