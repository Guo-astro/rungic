#!/bin/sh
# account.json moved to /var/lib/moto-host (state/host on the Android side, docs/61 §7): keep the old
# copy until the new one exists, so the obsolete list never removes the only copy.
if [ "$1" = configure ] && [ -f /etc/moto-plasma/account.json ] && [ ! -f /var/lib/moto-host/account.json ] \
        && mountpoint -q /var/lib/moto-host; then
    cp -p /etc/moto-plasma/account.json /var/lib/moto-host/account.json
fi
