[Unit]
Description=Plasma Mobile on Android Wayland
After=systemd-logind.service dbus.service rungic-plasma-shared.service
Wants=systemd-logind.service rungic-plasma-shared.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
User=1000
PAMName=login
WorkingDirectory=/home/linux
Environment=XDG_SESSION_TYPE=wayland
# The phone is the local seat. Without a seat logind marks the session non-local
# and polkit applies its "any" defaults: a password for every Flatpak ref and
# PackageKit step, never retained, even for the admin (sudo) user.
Environment=XDG_SEAT=seat0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/libexec/rungic-plasma-session
ExecStop=-/usr/bin/systemctl --user stop graphical-session.target
ExecStopPost=-/usr/bin/systemctl --user stop graphical-session.target
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
# Journal, so session messages share the merged, timestamped agent timeline.
StandardOutput=journal
StandardError=inherit
SyslogIdentifier=rungic-plasma-session

[Install]
WantedBy=multi-user.target
