[Unit]
Description=Plasma Mobile on Android Wayland
After=systemd-logind.service dbus.service moto-plasma-shared.service
Wants=systemd-logind.service moto-plasma-shared.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
User=1000
PAMName=login
WorkingDirectory=/home/linux
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/local/libexec/moto-plasma-session
ExecStop=-/usr/bin/systemctl --user stop graphical-session.target
ExecStopPost=-/usr/bin/systemctl --user stop graphical-session.target
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StandardOutput=append:/var/log/plasma/session.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
