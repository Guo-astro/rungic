#!/system/bin/sh
# Root Wi-Fi Display control (docs/58). Installed as /data/adb/moto-wfd/moto-cast.
[ "$(id -u)" = 0 ] || { echo '{"error":"moto-cast needs root"}'; exit 2; }
RUN=/data/adb/moto-wfd/run
mkdir -p "$RUN"
case "$1" in
connect|disconnect)
    # The newest request wins: stop a connect still in progress and, for a
    # request from the user, an automatic reconnect (moto-cast-watch).
    pid=$(cat "$RUN/connect.pid" 2>/dev/null)
    if [ -n "$pid" ] && grep -q dev.moto.cast "/proc/$pid/cmdline" 2>/dev/null; then kill "$pid"; fi
    rm -f "$RUN/connect.pid"
    [ -n "$MOTO_CAST_AUTO" ] || touch "$RUN/cancel-reconnect"
    [ "$1" = connect ] && echo $$ > "$RUN/connect.pid"
    ;;
esac
CLASSPATH=/data/adb/moto-wfd/moto-cast.jar exec app_process /system/bin dev.moto.cast.Main "$@"
