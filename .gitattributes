# Keep original bytes/line endings for source imports and existing patches.
# Deliberately no LFS filters: firmware and build artifacts are outside Git.
*.apk binary
*.deb binary
*.img binary
*.zip binary
*.png binary
*.webp binary
*.rgba binary
*.dmabuf binary
*.p12 binary

# Patch context includes blank lines prefixed with a space and original CRLF bytes.
# Preserve these verbatim; check source formatting in the prepared upstream tree.
*.patch -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
