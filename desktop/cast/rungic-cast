#!/usr/bin/python3
"""Cast the desktop to a TV (docs/58): Android's Wi-Fi Display, driven by the
host app's root tool rungic-cast through the platform bridge.

  rungic-cast status              connected TV, known TVs, automatic reconnect
  rungic-cast capabilities        backend support and selected firmware adapter
  rungic-cast settings            Android's receiver selection page
  rungic-cast scan [seconds]      look for TVs (default 8 s); lists them as "receivers"
  rungic-cast connect [TV]        the TV used last, or one by name/address
  rungic-cast modes               current video mode and receiver/source compatible modes
  rungic-cast resolution MAC/1920x1080@30 change the active video mode and reconnect
  rungic-cast disconnect          stop casting (no automatic reconnect follows)
  rungic-cast tv [director | desktop | button N]
                                  what the TV shows (the Rungic app, docs/58): the director (the assistant's
                                  screens) or the desktop in computer mode; or the cast button of screen N
                                  (0 computer mode): no TV yet the app's TV picker, else its cast controls
  rungic-cast director [N | next | prev | level 0|1|2]
                                  the director: assistant screen N in focus, the next or previous one, the
                                  focus standard, enlarged or solo

Prints the tool's JSON; exits 1 with {"error": ...} on failure.
"""
import os
import json
import socket
import sys

SOCKET = os.environ.get('RUNGIC_PLATFORM_SOCKET', '/mnt/android-wayland/platform.sock')
COMMANDS = ('status', 'capabilities', 'settings', 'scan', 'connect', 'disconnect', 'modes', 'resolution')


def validate_result(command: str, result: dict) -> dict:
    """A mismatched host must not look like a successful scan with no TVs."""
    if not isinstance(result, dict):
        return {'error': 'Invalid casting response', 'code': 'backend-incompatible'}
    if 'error' in result or command not in ('status', 'capabilities', 'scan'):
        return result
    if result.get('protocol_version') != 1 or not isinstance(result.get('receivers'), list):
        return {'error': 'Casting components need to be updated together',
                'code': 'backend-incompatible'}
    return result


def host_answers() -> bool:
    """The Rungic app answers at all: asleep (frozen, docs/research/97) it takes connections and
    never replies, and a cast command waited its whole 350 s for nothing."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(3)
            conn.connect(SOCKET)
            conn.sendall(b'{"op": "status"}\n')
            with conn.makefile('rb') as stream:
                return bool(json.loads(stream.readline(1 << 20) or b'null'))
    except (OSError, ValueError):
        return False


def request(args: list[str]) -> dict:
    if not host_answers():
        return {'error': 'The phone is asleep or Rungic is not responding', 'code': 'host-unreachable'}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(350)
        conn.connect(SOCKET)
        conn.sendall(json.dumps({'op': 'cast', 'args': args}, ensure_ascii=False).encode() + b'\n')
        with conn.makefile('rb') as stream:
            return validate_result(args[0], json.loads(stream.readline(1 << 20)))


def tv(args: list[str]) -> dict:
    if not args:
        req = {'op': 'tv'}
    elif args in (['director'], ['desktop']):
        req = {'op': 'tv', 'content': args[0]}
    elif args[0] == 'button' and len(args) == 2 and args[1].isdigit():
        req = {'op': 'tv', 'button': True, 'source': int(args[1])}
    else:
        raise ValueError('usage')
    return bridge(req)


def director(args: list[str]) -> dict:
    if not args:
        req = {}
    elif args in (['next'], ['prev']):
        req = {'step': 1 if args[0] == 'next' else -1}
    elif args[0] == 'level' and len(args) == 2 and args[1] in ('0', '1', '2'):
        req = {'level': int(args[1])}
    elif len(args) == 1 and args[0].isdigit():
        req = {'focus': int(args[0])}
    else:
        raise ValueError('usage')
    return bridge({'op': 'director', **req})


def bridge(req: dict) -> dict:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(10)
        conn.connect(SOCKET)
        conn.sendall(json.dumps(req).encode() + b'\n')
        with conn.makefile('rb') as stream:
            return json.loads(stream.readline(1 << 20))


def main() -> int:
    args = sys.argv[1:] or ['status']
    if args[0] in ('tv', 'director'):
        try:
            result = (tv if args[0] == 'tv' else director)(args[1:])
        except ValueError:
            print(__doc__.strip(), file=sys.stderr)
            return 2
        except OSError as e:
            result = {'error': f'Plasma Mobile host not reachable: {e}'}
        print(json.dumps(result, ensure_ascii=False))
        return 1 if 'error' in result else 0
    if args[0] not in COMMANDS or len(args) > (2 if args[0] in ('connect', 'scan', 'resolution') else 1):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        result = request(args)
    except OSError as e:
        result = {'error': f'Plasma Mobile host not reachable: {e}'}
    print(json.dumps(result, ensure_ascii=False))
    return 1 if 'error' in result else 0


if __name__ == '__main__':
    raise SystemExit(main())
