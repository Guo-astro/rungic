#!/usr/bin/python3
"""The screens beside the phone's own (docs/65, docs/research/91), each in a floating window on the
phone, fullscreen, or on the TV:

  rungic-desktop-mode on | off | toggle | status | ensure        desktop mode: the user's desktop
      gets a second output (KWin's CAST-n), a full desktop. A TV shows it: casting is desktop mode
      on the TV.
  rungic-agent-screen on | off | close [--force] | toggle | status | ensure [tv]   the assistant's
      screen: the agent's own workspace, `rungic-workspace@N` ($RUNGIC_WORKSPACE, else 1), started
      when needed. `off` hides it and the workspace goes on; `close` also closes the workspace and
      the apps in it (rungic-cua close-workspace). `dismiss` is the floating window's close button:
      only `off` while the agent is at work there, else `close`, and a notification when an app
      kept the workspace open (unsaved work).
      `tv`: show it on the TV instead of the desktop, connecting the TV if none is (`notv` gives
      the TV back to the desktop).

Each prints one JSON object. `on` turns the screen on and opens its floating window; `off` turns
it off and the window quits by itself. `ensure` is `status` that also brings back the window of a
screen that is on (after the Android host restarted, say); the quick settings poll it. The
floating windows always open on the phone, also when the agent runs this from inside its
workspace (RUNGIC_USER_* are the user's session).
"""
import gettext
import json
import os
import socket
import subprocess
import sys
import time

# The floating window's catalog (po/<language>/rungic-agent-screen.po), for the notification.
_ = gettext.translation('rungic-agent-screen', fallback=True).pgettext

SOCKET = '/mnt/android-wayland/platform.sock'
WINDOW = '/usr/libexec/rungic-agent-screen-window'
DESKTOP = os.path.basename(sys.argv[0]) == 'rungic-desktop-mode'
OP = 'desktop-mode' if DESKTOP else 'agent-screen'
APP = 'com.rungic.DesktopMode' if DESKTOP else 'com.rungic.AgentScreen'


def bridge(request, timeout=5):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(timeout)
        conn.connect(SOCKET)
        conn.sendall(json.dumps(request).encode() + b'\n')
        reply = b''
        while not reply.endswith(b'\n'):
            chunk = conn.recv(65536)
            if not chunk:
                break
            reply += chunk
    result = json.loads(reply)
    if 'error' in result:
        raise SystemExit(json.dumps({'error': result['error']}, ensure_ascii=False))
    return result


def window_running(slot=None):
    """This screen's floating window (desktop mode's and the assistant's are two): workspace `slot`'s,
    or any workspace's. Each workspace can have one out at once (docs/research/91: a team's)."""
    pattern = (f'^{WINDOW} --desktop' if DESKTOP else f'^{WINDOW} --workspace {slot}$' if slot
               else f'^{WINDOW} --workspace')
    return subprocess.run(['pgrep', '-f', pattern], capture_output=True).returncode == 0


def windows_shown():
    """The workspaces whose floating windows are out."""
    out = subprocess.run(['pgrep', '-af', f'^{WINDOW} --workspace '], capture_output=True, text=True).stdout
    return sorted({int(line.split()[-1]) for line in out.splitlines() if line.split()[-1].isdigit()})


def workspace():
    """The workspace the assistant's screen shows, or 0 when the host offers none."""
    slot = int(os.environ.get('RUNGIC_WORKSPACE') or 1)
    return slot if os.path.exists(f'/mnt/android-wayland/ws-{slot}') else 0


def user_env():
    """The user's session: the floating window belongs on the phone, not in a workspace. What the
    caller's environment lacks comes from the session's (the systemd user manager's), as for the
    desktop's own apps: without its GPU variables the window found no EGL display and drew nothing."""
    env = dict(os.environ)
    runtime = env.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    if env.get('RUNGIC_USER_WAYLAND_DISPLAY') or env.get('RUNGIC_WORKSPACE'):
        # From inside a workspace without them (a float opened in the workspace once): the
        # user's session's usual display and bus.
        env['WAYLAND_DISPLAY'] = env.get('RUNGIC_USER_WAYLAND_DISPLAY') or 'wayland-0'
        env['DBUS_SESSION_BUS_ADDRESS'] = (env.get('RUNGIC_USER_DBUS_SESSION_BUS_ADDRESS')
                                           or f'unix:path={runtime}/bus')
    for name in ('RUNGIC_WORKSPACE', 'DISPLAY', 'XAUTHORITY', 'PULSE_SINK'):  # PULSE_SINK: the workspace's sound
        env.pop(name, None)
    try:
        session = subprocess.run(['systemctl', '--user', 'show-environment'], capture_output=True, text=True,
                                 timeout=5).stdout
        for line in session.splitlines():
            name, _, value = line.partition('=')
            if name and name not in ('RUNGIC_WORKSPACE', 'DISPLAY', 'XAUTHORITY'):
                env.setdefault(name, value)
    except (OSError, subprocess.SubprocessError):
        pass
    return env


def workspace_up(slot, timeout=15):
    """Start workspace `slot` if it is not running; True once its KWin is there."""
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    socket_path = os.path.join(runtime, f'wayland-ws-{slot}')
    if not os.path.exists(socket_path):
        subprocess.run(['systemctl', '--user', 'start', '--no-block', f'rungic-workspace@{slot}.service'],
                       capture_output=True, env=user_env(), timeout=10)
    deadline = time.monotonic() + timeout
    while not os.path.exists(socket_path):
        if time.monotonic() > deadline:
            return False
        time.sleep(0.2)
    return True


def output():
    """KWin's name for desktop mode's screen, or None while it has none."""
    out = subprocess.run(['kscreen-doctor', '-j'], capture_output=True, text=True, timeout=10, env=user_env()).stdout
    try:
        outputs = json.loads(out).get('outputs', [])
    except ValueError:
        return None
    return next((o['name'] for o in outputs if o.get('name', '').startswith('CAST') and o.get('enabled')), None)


def status():
    state = bridge({'op': OP})
    shown_on = 'tv' if state.get('tv') else 'phone fullscreen' if state.get('fullscreen') else 'floating window'
    result = {'enabled': state['enabled'], 'shown_on': shown_on, 'size': f"{state['width']}x{state['height']}",
              'window_running': window_running()}
    if DESKTOP:
        result['output'] = output() if state['enabled'] else None
    else:
        slot = state.get('workspace', 1)
        runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
        result['workspace'] = slot
        result['windows'] = windows_shown()
        result['output'] = (f'workspace {slot}' if state['enabled'] and
                            os.path.exists(os.path.join(runtime, f'wayland-ws-{slot}')) else None)
    return result


def start_window(slot=None):
    """One floating window per screen (per workspace for the assistant's): callers at the same
    moment (the quick setting's poll, the agent's tools) take turns, and the second finds the first's
    window (two were started once). The assistant's names its workspace: its desktop file's Exec
    says workspace 1 (the window showed workspace 1 whatever was asked, until 2026-10-01)."""
    import fcntl
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    name = f'rungic-{OP}' + (f'-{slot}' if slot else '')
    with open(os.path.join(runtime, f'{name}.lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if window_running(slot):
            return
        if DESKTOP or not slot:
            command = ['kstart', '--application', APP]
        else:
            # An app scope as kstart makes one; the same executable, so the same grants (its desktop file).
            # Bound to its workspace: closed with it (a team's windows stayed after their workspaces closed).
            command = ['systemd-run', '--user', '--scope', '--collect', '--quiet', '--slice=app.slice',
                       '--unit', f'app-{APP}-ws{slot}-{os.getpid()}{time.monotonic_ns()}',
                       '-p', f'BindsTo=rungic-workspace@{slot}.service', '-p', f'After=rungic-workspace@{slot}.service',
                       WINDOW, '--workspace', str(slot)]
        # Nothing of the caller's: systemd-run --scope stays as the window, and an inherited pipe kept
        # the caller (an adb shell) waiting for it.
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, env=user_env())
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline and not window_running(slot):
            time.sleep(0.1)


def ensure():
    state = bridge({'op': OP})
    if state['enabled']:
        if not DESKTOP:
            slot = workspace()
            if not slot:
                raise SystemExit(json.dumps({'error': 'the host offers no workspaces (APK 2.14 or later)'}))
            workspace_up(slot)
            thaw(slot)
            if state.get('workspace') != slot:
                bridge({'op': OP, 'workspace': slot})
        start_window(None if DESKTOP else slot)
    return status()


def on():
    if DESKTOP:
        bridge({'op': OP, 'enabled': True})
        start_window()
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not output():
            time.sleep(0.3)
        return status()
    slot = workspace()
    if not slot:
        raise SystemExit(json.dumps({'error': 'the host offers no workspaces (APK 2.14 or later)'}))
    workspace_up(slot)
    thaw(slot)
    bridge({'op': OP, 'workspace': slot, 'enabled': True})
    start_window(slot)
    return status()


def off():
    bridge({'op': OP, 'enabled': False})
    return status()


def close(slot=None, force=None):
    """`off` only hides the assistant's screen: its workspace and the apps in it go on. `close`
    also closes the workspace: its apps are asked to close (one asking about unsaved work keeps
    it open, reported under `workspace`), then it stops (rungic-cua close-workspace)."""
    if DESKTOP:
        raise SystemExit(json.dumps({'error': 'desktop mode has no workspace of its own; use off'}))
    result = off()
    slot = slot or int(os.environ.get('RUNGIC_WORKSPACE') or 1)
    force = '--force' in sys.argv if force is None else force
    thaw(slot)
    args = ['rungic-cua', 'close-workspace', str(slot)] + (['--force'] if force else [])
    done = subprocess.run(args, capture_output=True, text=True, timeout=180)
    try:
        result['workspace'] = json.loads(done.stdout)
    except ValueError:
        result['workspace'] = {'closed': False, 'error': (done.stderr or done.stdout).strip()[-500:]}
    return result


def workspace_stopped():
    """rungic-agent-screen workspace-stopped N (the workspace unit's ExecStopPost): its floating
    window ended with it. If the screen showed it, the screen shows another workspace whose window
    is still out, or none: else a later `ensure` would start the stopped workspace again."""
    slot = int(sys.argv[2])
    state = bridge({'op': OP})
    if not state.get('enabled') or int(state.get('workspace') or 1) != slot:
        return status()
    others = [n for n in windows_shown() if n != slot]
    if others and not (state.get('tv') or state.get('fullscreen')):
        bridge({'op': OP, 'workspace': others[0]})
        return status()
    return off()


def voice_state():
    """The voice agent's State (agentBusy, workspace), {} when it does not answer."""
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    env = dict(os.environ, DBUS_SESSION_BUS_ADDRESS=os.environ.get('RUNGIC_USER_DBUS_SESSION_BUS_ADDRESS')
               or (os.environ.get('DBUS_SESSION_BUS_ADDRESS') if not os.environ.get('RUNGIC_WORKSPACE') else None)
               or f'unix:path={runtime}/bus')
    try:
        done = subprocess.run(['busctl', '--user', '--json=short', 'call', 'com.rungic.VoiceAgent',
                               '/com/rungic/VoiceAgent', 'com.rungic.VoiceAgent', 'State'],
                              capture_output=True, text=True, timeout=5, env=env)
        return json.loads(json.loads(done.stdout)['data'][0])
    except (OSError, ValueError, KeyError, IndexError, subprocess.SubprocessError):
        return {}


def dismissed_marker(slot):
    """While it exists, the agent's tools do not bring the screen back (rungic_cua show_workspace);
    the voice agent removes it when the task ends."""
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    return os.path.join(runtime, f'rungic-agent-screen-dismissed-{slot}')


def thaw(slot):
    """The workspace's apps running again, if its keeper froze them (rungic-workspace-keeper)."""
    uid = os.getuid()
    events = (f'/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/app.slice/'
              f'app-rungicws{slot}.slice/cgroup.events')
    try:
        frozen = 'frozen 1' in open(events).read()
    except OSError:
        return
    if frozen:
        # On the user's bus: a workspace's own has no systemd (freeze and thaw ask it for a reference).
        runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{uid}'
        env = dict(os.environ, DBUS_SESSION_BUS_ADDRESS=os.environ.get('RUNGIC_USER_DBUS_SESSION_BUS_ADDRESS')
                   or f'unix:path={runtime}/bus')
        subprocess.run(['systemctl', '--user', 'thaw', f'app-rungicws{slot}.slice'], capture_output=True, timeout=15,
                       env=env)


def busy(slot):
    """An agent other than the voice agent's works in workspace `slot` (a sub-agent, a team member,
    docs/research/91): its window's close button only hides it. The claim rungic-workspace-N.busy
    (rungic_cua.workspace): empty from a runner (tools/team), held until removed; else the holding
    process's record, held while it lives and touches the claim (20 minutes)."""
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    path = os.path.join(runtime, f'rungic-workspace-{slot}.busy')
    try:
        text = open(path).read().strip()
        age = time.time() - os.stat(path).st_mtime
    except OSError:
        return False
    try:
        pid = int(json.loads(text)['pid']) if text else None
    except (ValueError, KeyError, TypeError):
        return True
    return pid is None or (age < 20 * 60 and os.path.exists(f'/proc/{pid}'))


def dismiss():
    """rungic-agent-screen dismiss [N]: workspace N's floating window's close button (docs/research/91).
    An agent at work there: only hidden, and not brought back during this task; else the workspace
    closed, its apps asked first. One that stays (unsaved work) keeps the workspace, and the user is
    told. The assistant's screen stays on while other workspaces' windows are out."""
    if DESKTOP:
        return off()
    state = bridge({'op': OP})
    slot = int(sys.argv[2] if len(sys.argv) > 2 else state.get('workspace') or os.environ.get('RUNGIC_WORKSPACE') or 1)
    others = [n for n in windows_shown() if n != slot]
    hide = (lambda: status()) if others else off
    voice = voice_state()
    if (voice.get('agentBusy') and int(voice.get('workspace') or 1) == slot) or busy(slot):
        open(dismissed_marker(slot), 'w').close()
        return {**hide(), 'workspace': {'closed': False, 'hidden': 'an agent is at work'}}
    if others:
        # Another window stays out: close only this workspace (close() would turn the screen off).
        thaw(slot)
        done = subprocess.run(['rungic-cua', 'close-workspace', str(slot)], capture_output=True, text=True, timeout=180)
        try:
            result = {**status(), 'workspace': json.loads(done.stdout)}
        except ValueError:
            result = {**status(), 'workspace': {'closed': False, 'error': (done.stderr or done.stdout).strip()[-500:]}}
    else:
        result = close(slot, force=False)
    if result['workspace'].get('remaining'):
        subprocess.Popen([sys.argv[0], 'notify-unsaved', str(slot), json.dumps(result['workspace'])],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return result


def notify_unsaved():
    """rungic-agent-screen notify-unsaved N RESULT: the apps that kept workspace N open, with
    View (the assistant's screen again) and Close without saving."""
    slot, result = int(sys.argv[2]), json.loads(sys.argv[3])
    apps = []
    for item in result.get('remaining') or []:
        name = item.get('app') or item.get('caption') or '?'
        if name not in apps:
            apps.append(name)
    # TRANSLATORS: joins the names of apps in a list
    names = _('@item:intext list separator', ', ').join(apps)
    done = subprocess.run(
        ['notify-send', '--app-name', _('@title the floating window', "Assistant's screen"), '--wait',
         f"--action=view={_('@action:button show the assistant screen again', 'View')}",
         f"--action=force={_('@action:button close the workspace losing unsaved work', 'Close without saving')}",
         _('@title notification', "The assistant's screen is still open"),
         _('@info notification, {apps} lists apps',
           '{apps} did not close, maybe with unsaved work, so its workspace is still open.').format(apps=names)],
        capture_output=True, text=True)
    choice = done.stdout.strip()
    if choice == 'view':
        os.environ['RUNGIC_WORKSPACE'] = str(slot)
        return on()
    if choice == 'force':
        return close(slot, force=True)
    return {'notified': True}


def tv(show=True):
    """The assistant's screen on the TV instead of the desktop (or back to the desktop). The TV's
    source is set first and a TV is connected if none is: the TV shows the assistant's screen
    from its first frame, never the desktop on the way (it took a connect, then a switch)."""
    if DESKTOP:
        raise SystemExit(json.dumps({'error': 'a TV shows desktop mode anyway; rungic-cast connects one'}))
    if show:
        on()
    state = bridge({'op': OP, 'tv': show})
    if show and not state.get('tv'):
        # No TV yet: the last one, as the quick setting and the floating window connect it
        # (seconds to a minute).
        result = bridge({'op': 'cast', 'args': ['connect']}, timeout=75)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not bridge({'op': OP}).get('tv'):
            time.sleep(0.3)
        if not bridge({'op': OP}).get('tv'):
            raise SystemExit(json.dumps({'error': 'the TV did not connect', 'cast': result}, ensure_ascii=False))
    return status()


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if command == 'toggle':
        command = 'off' if bridge({'op': OP})['enabled'] else 'on'
    actions = {'on': on, 'off': off, 'close': close, 'dismiss': dismiss, 'notify-unsaved': notify_unsaved,
               'status': status, 'ensure': ensure, 'tv': tv, 'notv': lambda: tv(False),
               'workspace-stopped': workspace_stopped}
    if command not in actions:
        raise SystemExit(__doc__)
    print(json.dumps(actions[command](), ensure_ascii=False))


if __name__ == '__main__':
    main()
