#!/usr/bin/python3
"""The screens beside the phone's own (docs/65, docs/research/91), each in a floating window on the
phone, fullscreen, or on the TV:

  rungic-desktop-mode on | off | toggle | status | ensure        desktop mode: the user's desktop
      gets a second output (KWin's CAST-n), a full desktop. A TV shows it: casting is desktop mode
      on the TV.
  rungic-agent-screen on | off | toggle | status | ensure [tv]   the assistant's screen: the
      agent's own workspace, `rungic-workspace@N` ($RUNGIC_WORKSPACE, else 1), started when needed.
      `tv`: show it on the TV instead of the desktop, connecting the TV if none is (`notv` gives
      the TV back to the desktop).

Each prints one JSON object. `on` turns the screen on and opens its floating window; `off` turns
it off and the window quits by itself. `ensure` is `status` that also brings back the window of a
screen that is on (after the Android host restarted, say); the quick settings poll it. The
floating windows always open on the phone, also when the agent runs this from inside its
workspace (RUNGIC_USER_* are the user's session).
"""
import json
import os
import socket
import subprocess
import sys
import time

SOCKET = '/mnt/android-wayland/platform.sock'
WINDOW = '/usr/libexec/rungic-agent-screen-window'
DESKTOP = os.path.basename(sys.argv[0]) == 'rungic-desktop-mode'
OP = 'desktop-mode' if DESKTOP else 'agent-screen'
APP = 'com.rungic.DesktopMode' if DESKTOP else 'com.rungic.AgentScreen'


def bridge(request, timeout=5):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
        conn.settimeout(timeout)
        conn.connect(SOCKET)
        conn.sendall(json.dumps(request).encode() + b'\n')
        reply = b''
        while not reply.endswith(b'\n'):
            chunk = conn.recv(65536)
            if not chunk:
                break
            reply += chunk
    result = json.loads(reply)
    if 'error' in result:
        raise SystemExit(json.dumps({'error': result['error']}, ensure_ascii=False))
    return result


def window_running():
    """This screen's floating window (desktop mode's and the assistant's are two)."""
    pattern = f'^{WINDOW} --desktop' if DESKTOP else f'^{WINDOW} --workspace'
    return subprocess.run(['pgrep', '-f', pattern], capture_output=True).returncode == 0


def workspace():
    """The workspace the assistant's screen shows, or 0 when the host offers none."""
    slot = int(os.environ.get('RUNGIC_WORKSPACE') or 1)
    return slot if os.path.exists(f'/mnt/android-wayland/ws-{slot}') else 0


def user_env():
    """The user's session: the floating window belongs on the phone, not in a workspace. What the
    caller's environment lacks comes from the session's (the systemd user manager's), as for the
    desktop's own apps: without its GPU variables the window found no EGL display and drew nothing."""
    env = dict(os.environ)
    runtime = env.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    if env.get('RUNGIC_USER_WAYLAND_DISPLAY') or env.get('RUNGIC_WORKSPACE'):
        # From inside a workspace without them (a float opened in the workspace once): the
        # user's session's usual display and bus.
        env['WAYLAND_DISPLAY'] = env.get('RUNGIC_USER_WAYLAND_DISPLAY') or 'wayland-0'
        env['DBUS_SESSION_BUS_ADDRESS'] = (env.get('RUNGIC_USER_DBUS_SESSION_BUS_ADDRESS')
                                           or f'unix:path={runtime}/bus')
    for name in ('RUNGIC_WORKSPACE', 'DISPLAY', 'XAUTHORITY'):
        env.pop(name, None)
    try:
        session = subprocess.run(['systemctl', '--user', 'show-environment'], capture_output=True, text=True,
                                 timeout=5).stdout
        for line in session.splitlines():
            name, _, value = line.partition('=')
            if name and name not in ('RUNGIC_WORKSPACE', 'DISPLAY', 'XAUTHORITY'):
                env.setdefault(name, value)
    except (OSError, subprocess.SubprocessError):
        pass
    return env


def workspace_up(slot, timeout=15):
    """Start workspace `slot` if it is not running; True once its KWin is there."""
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    socket_path = os.path.join(runtime, f'wayland-ws-{slot}')
    if not os.path.exists(socket_path):
        subprocess.run(['systemctl', '--user', 'start', '--no-block', f'rungic-workspace@{slot}.service'],
                       capture_output=True, env=user_env(), timeout=10)
    deadline = time.monotonic() + timeout
    while not os.path.exists(socket_path):
        if time.monotonic() > deadline:
            return False
        time.sleep(0.2)
    return True


def output():
    """KWin's name for desktop mode's screen, or None while it has none."""
    out = subprocess.run(['kscreen-doctor', '-j'], capture_output=True, text=True, timeout=10, env=user_env()).stdout
    try:
        outputs = json.loads(out).get('outputs', [])
    except ValueError:
        return None
    return next((o['name'] for o in outputs if o.get('name', '').startswith('CAST') and o.get('enabled')), None)


def status():
    state = bridge({'op': OP})
    shown_on = 'tv' if state.get('tv') else 'phone fullscreen' if state.get('fullscreen') else 'floating window'
    result = {'enabled': state['enabled'], 'shown_on': shown_on, 'size': f"{state['width']}x{state['height']}",
              'window_running': window_running()}
    if DESKTOP:
        result['output'] = output() if state['enabled'] else None
    else:
        slot = state.get('workspace', 1)
        runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
        result['workspace'] = slot
        result['output'] = (f'workspace {slot}' if state['enabled'] and
                            os.path.exists(os.path.join(runtime, f'wayland-ws-{slot}')) else None)
    return result


def start_window():
    """One floating window per screen: callers at the same moment (the quick setting's poll, the
    agent's tools) take turns, and the second finds the first's window (two were started once)."""
    import fcntl
    runtime = os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'
    with open(os.path.join(runtime, f'rungic-{OP}.lock'), 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if window_running():
            return
        subprocess.Popen(['kstart', '--application', APP], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, env=user_env())
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline and not window_running():
            time.sleep(0.1)


def ensure():
    state = bridge({'op': OP})
    if state['enabled']:
        if not DESKTOP:
            slot = workspace()
            if not slot:
                raise SystemExit(json.dumps({'error': 'the host offers no workspaces (APK 2.14 or later)'}))
            workspace_up(slot)
            if state.get('workspace') != slot:
                bridge({'op': OP, 'workspace': slot})
        start_window()
    return status()


def on():
    if DESKTOP:
        bridge({'op': OP, 'enabled': True})
        start_window()
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not output():
            time.sleep(0.3)
        return status()
    slot = workspace()
    if not slot:
        raise SystemExit(json.dumps({'error': 'the host offers no workspaces (APK 2.14 or later)'}))
    workspace_up(slot)
    bridge({'op': OP, 'workspace': slot, 'enabled': True})
    start_window()
    return status()


def off():
    bridge({'op': OP, 'enabled': False})
    return status()


def tv(show=True):
    """The assistant's screen on the TV instead of the desktop (or back to the desktop). The TV's
    source is set first and a TV is connected if none is: the TV shows the assistant's screen
    from its first frame, never the desktop on the way (it took a connect, then a switch)."""
    if DESKTOP:
        raise SystemExit(json.dumps({'error': 'a TV shows desktop mode anyway; rungic-cast connects one'}))
    if show:
        on()
    state = bridge({'op': OP, 'tv': show})
    if show and not state.get('tv'):
        # No TV yet: the last one, as the quick setting and the floating window connect it
        # (seconds to a minute).
        result = bridge({'op': 'cast', 'args': ['connect']}, timeout=75)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not bridge({'op': OP}).get('tv'):
            time.sleep(0.3)
        if not bridge({'op': OP}).get('tv'):
            raise SystemExit(json.dumps({'error': 'the TV did not connect', 'cast': result}, ensure_ascii=False))
    return status()


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if command == 'toggle':
        command = 'off' if bridge({'op': OP})['enabled'] else 'on'
    actions = {'on': on, 'off': off, 'status': status, 'ensure': ensure, 'tv': tv, 'notv': lambda: tv(False)}
    if command not in actions:
        raise SystemExit(__doc__)
    print(json.dumps(actions[command](), ensure_ascii=False))


if __name__ == '__main__':
    main()
