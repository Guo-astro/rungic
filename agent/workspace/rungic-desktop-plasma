#!/usr/bin/env python3
"""rungic-desktop-plasma [--needed]: what the independent desktop's Plasma layout needs set
(docs/research/97 §19.6), in workspace 0's environment.

The volume applet shows only devices with a sound card unless told otherwise (showVirtualDevices,
plasma-pa 6.6): every output and input of the phone is virtual (the Android tunnel and pipes, the
workspaces' null sinks), and the desktop's sound panel showed none at all. Plasma's scripting
cannot reach the applets inside the system tray (6.6 keeps them in the tray's own groups), so the
layout file is set, before the shell starts: rungic-workspace runs this before each start, and once
the shell has made a new layout, `--needed` says it lacks the setting (the shell is started again).
"""
import os
import re
import subprocess
import sys
from pathlib import Path

LAYOUT = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'plasma-org.kde.plasma.desktop-appletsrc'
SETTINGS = {'showVirtualDevices': 'true'}


def volume_applets(text: str) -> list[list[str]]:
    """The group paths of the volume applets (in a panel, or in the system tray)."""
    found, group = [], None
    for line in text.splitlines():
        if line.startswith('['):
            group = re.findall(r'\[([^\]]*)\]', line)
        elif line.strip() == 'plugin=org.kde.plasma.volume' and group:
            found.append(group)
    return found


def lacking(text: str) -> list[list[str]]:
    """The applets' settings groups that lack a setting."""
    out = []
    for group in volume_applets(text):
        settings = group + ['Configuration', 'General']
        header = ''.join(f'[{g}]' for g in settings)
        block = text.split(header + '\n', 1)[1].split('\n[', 1)[0] if header + '\n' in text else ''
        if any(f'{key}={value}' not in block.splitlines() for key, value in SETTINGS.items()):
            out.append(settings)
    return out


def main() -> None:
    try:
        text = LAYOUT.read_text()
    except OSError:
        sys.exit(1 if '--needed' in sys.argv else 0)   # no layout yet: the shell makes one
    groups = lacking(text)
    if '--needed' in sys.argv:
        sys.exit(0 if groups else 1)
    for settings in groups:
        for key, value in SETTINGS.items():
            subprocess.run(['kwriteconfig6', '--file', str(LAYOUT), *[a for g in settings for a in ('--group', g)],
                            '--key', key, '--type', 'bool', value], check=True)
    print(f'set {len(groups)} volume applets')


if __name__ == '__main__':
    main()
