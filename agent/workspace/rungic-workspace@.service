[Unit]
Description=Agent workspace %i (a KWin of its own, headless by default, docs/research/91, 97)
# Not part of the user's graphical session: the phone's Plasma restarting (an app update, a
# crash) must not end an agent's work (docs/research/97). The workspace ends by the agent's tools
# or its keeper (idle, docs/research/91 §10); on the Android host it also ends with the host.
After=plasma-kwin_wayland.service

[Service]
ExecStart=/usr/bin/rungic-workspace %i
ExecStopPost=/bin/sh -c 'rm -f "$${XDG_STATE_HOME:-$$HOME/.local/state}/rungic-workspaces/%i/bus" "$${XDG_STATE_HOME:-$$HOME/.local/state}/rungic-workspaces/%i/display"'
ExecStopPost=-/usr/bin/rungic-workspace-sound %i down
ExecStopPost=-/usr/bin/rungic-agent-screen workspace-stopped %i
Restart=on-failure
RestartSec=3
