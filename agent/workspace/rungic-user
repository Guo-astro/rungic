#!/bin/sh
# rungic-user COMMAND...: run COMMAND in the user's session (the phone's KWin and session bus) from
# inside an agent workspace (docs/research/91): a notification the user should read, say. The
# workspace's programs get the user's session as RUNGIC_USER_* (rungic-voice-agent).
set -eu
[ $# -gt 0 ] || { echo "usage: rungic-user COMMAND..." >&2; exit 2; }
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export WAYLAND_DISPLAY="${RUNGIC_USER_WAYLAND_DISPLAY:-wayland-0}"
export DBUS_SESSION_BUS_ADDRESS="${RUNGIC_USER_DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime/bus}"
# What the workspace sets as a desktop does (docs/103): the user's session's own values again.
for name in PLASMA_INTEGRATION_USE_PORTAL QT_QPA_PLATFORMTHEME; do
    eval "value=\${RUNGIC_USER_$name:-}"
    if [ -n "$value" ]; then export "$name=$value"; else unset "$name"; fi
    unset "RUNGIC_USER_$name"
done
unset RUNGIC_WORKSPACE DISPLAY XAUTHORITY
exec "$@"
