#!/bin/sh
# rungic-workspace-env N COMMAND...: run COMMAND in agent workspace N (docs/research/91): its
# display, its session bus; its windows open there and nowhere else.
set -eu
slot=${1:?usage: rungic-workspace-env N COMMAND...}
shift
state=${XDG_STATE_HOME:-$HOME/.local/state}/rungic-workspaces/$slot
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
if [ ! -s "$state/bus" ] || [ ! -S "$runtime/wayland-ws-$slot" ]; then
    echo "workspace $slot is not running (systemctl --user start rungic-workspace@$slot)" >&2
    exit 1
fi
# The user's session goes along, for what belongs on the phone (rungic-user, the floating window):
# from a caller outside any workspace, its own display and bus.
if [ -z "${RUNGIC_WORKSPACE:-}" ]; then
    export RUNGIC_USER_WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    export RUNGIC_USER_DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime/bus}"
    export RUNGIC_USER_PLASMA_INTEGRATION_USE_PORTAL="${PLASMA_INTEGRATION_USE_PORTAL:-}"
    export RUNGIC_USER_QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-}"
fi
export WAYLAND_DISPLAY=wayland-ws-$slot DBUS_SESSION_BUS_ADDRESS="$(cat "$state/bus")" RUNGIC_WORKSPACE=$slot
export QT_QPA_PLATFORM=wayland XDG_CURRENT_DESKTOP=KDE XDG_SESSION_TYPE=wayland
# As in Plasma's session, whoever calls: programs tell a KDE session by these (Krita's OpenGL
# probe then leaves the desktop theme out, docs/103).
export KDE_FULL_SESSION=true KDE_SESSION_VERSION=6
# A desktop, set up as Plasma's desktop session is (docs/103): in-process file dialogs, not the
# phone's portal picker, and the platform theme Qt picks from XDG_CURRENT_DESKTOP. A forced
# QT_QPA_PLATFORMTHEME reached the temporary applications programs make at start (Krita's OpenGL
# probe) and left their session bus deaf.
export PLASMA_INTEGRATION_USE_PORTAL=0
unset QT_QPA_PLATFORMTHEME
# Its sound in its own sink, while there is one (rungic-workspace-sound).
if pactl list short sinks 2>/dev/null | cut -f2 | grep -qx "rungic_ws$slot"; then
    export PULSE_SINK=rungic_ws$slot
else
    unset PULSE_SINK
fi
# Its own Xwayland for X11 programs; none at all rather than the phone's.
if [ -s "$state/display" ]; then
    export DISPLAY="$(cat "$state/display")"
else
    unset DISPLAY
fi
unset XAUTHORITY
exec "$@"
