#!/bin/sh
# rungic-workspace N: agent workspace N (docs/research/91), a KWin of its own on the Android host.
# N 0: the independent desktop (desktop mode, docs/research/97 §19): the user's own desktop in a KWin
# of its own, with Plasma's desktop shell, the user's settings and data, for as long as it is on.
#
# Its own D-Bus session, its own Wayland socket (wayland-ws-N), its own Xwayland, its own KWin
# settings; its only output is the one the host offers on /mnt/android-wayland/ws-N, which the
# TV, fullscreen or a floating window can show. Everything started in it (rungic-workspace-env)
# lands there and nowhere else; its input never touches the phone's.
set -eu
slot=${1:?usage: rungic-workspace N}
case "$slot" in [0-9]) ;; *) echo "workspace: a slot 0..9" >&2; exit 2 ;; esac
host=/mnt/android-wayland/ws-$slot
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
failed=$runtime/rungic-workspace-$slot.failed
rm -f "$failed"
fail() { echo "workspace $slot: $1" >&2; echo "$1" > "$failed"; exit 1; }
# Headless, the default (docs/research/97): KWin's virtual backend on the phone's GPU, with no
# Android host, so the workspace runs while the phone is asleep and the Rungic app frozen. Its
# picture reaches the phone's windows and remote viewers by screencast (PipeWire), and the host
# (TV, fullscreen) by its presenter (rungic-workspace-present, started by the keeper).
# RUNGIC_WORKSPACE_BACKEND=android: on the Android host as before. Its helpers (the keeper) are told.
backend=${RUNGIC_WORKSPACE_BACKEND:-virtual}
export RUNGIC_WORKSPACE_BACKEND=$backend
if [ "$backend" = virtual ]; then :; else
[ -S "$host" ] || fail "the host does not offer $host (APK 2.14 or later)"
# The host must answer before KWin connects: a frozen Rungic app (the phone asleep: Motorola's
# freezer, docs/research/97) takes the connection but never the first roundtrip, and KWin and every
# app started in it would hang there with no end.
python3 - <<'PROBE' || fail "the Android host is not responding (the phone is asleep or Rungic is frozen, docs/research/97)"
import json, socket, sys
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.settimeout(3)
        c.connect('/mnt/android-wayland/platform.sock')
        c.sendall(b'{"op": "status"}\n')
        sys.exit(0 if json.loads(c.makefile('rb').readline() or b'null') else 1)
except (OSError, ValueError):
    sys.exit(1)
PROBE
fi

# The GPU as the phone's KWin has it (desktop/kwin): Mesa's KGSL driver, and the host's output
# buffers in Adreno UBWC, which KWin cannot render into without FD_KGSL_DMABUF_UBWC (EGL_BAD_MATCH).
[ ! -f /etc/plasma/gpu-env ] || . /etc/plasma/gpu-env
export FD_KGSL_DMABUF_UBWC=1

# KWin keeps its settings apart from the user's (kwinrc, the output configuration); the look
# (kdeglobals) is the user's.
state=${XDG_STATE_HOME:-$HOME/.local/state}/rungic-workspaces/$slot
mkdir -p "$state/config"
export RUNGIC_USER_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
if [ "$slot" = 0 ]; then
    # The desktop shares the user's settings and data with the phone's session, all but each
    # session's own (KWin's and the shell's, whose file names are fixed, its daemons', the clipboard
    # history): links to the user's files, kept in step while it runs (rungic-desktop-dirs).
    export RUNGIC_USER_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
    rungic-desktop-dirs build "$state"
    export XDG_DATA_HOME="$state/data" XDG_STATE_HOME="$state/state"
    mkdir -p "$XDG_STATE_HOME"
    # A desktop's programs, not the phone's: Plasma Mobile's shell and form factor stay with it,
    # and Qt Quick's mobile controls (Kirigami's isMobile layouts).
    unset PLASMA_DEFAULT_SHELL PLASMA_PLATFORM QT_QUICK_CONTROLS_MOBILE
else
    [ -e "$state/config/kdeglobals" ] || ln -s "$RUNGIC_USER_CONFIG_HOME/kdeglobals" "$state/config/kdeglobals"
fi
export XDG_CONFIG_HOME="$state/config"
# A desktop's window behaviour, not the phone's: Plasma Mobile's configuration leaves the search
# path, the workspace defaults come first (defaults/kwinrc).
dirs=$(printf '%s' "${XDG_CONFIG_DIRS:-/etc/xdg}" | tr ':' '\n' | grep -v '/plasma-mobile/*$' | grep . | paste -sd: -)
export XDG_CONFIG_DIRS="/usr/share/rungic-workspace/defaults:$dirs"
# And a cache of its own: KDE's application database (ksycoca) records the settings directory it
# was built for, and one file shared with the user's session was rebuilt by each side in turn,
# several times a second; every rebuild made the phone's home screen reload its apps, and it
# lost its dock and widgets (2026-09-29).
export XDG_CACHE_HOME="$state/cache"
mkdir -p "$XDG_CACHE_HOME"

# What the private bus starts (portals) inherits the bus daemon's environment: this workspace's
# display. Never dbus-update-activation-environment here: it also sets the systemd user
# manager's environment, the user's session's (WAYLAND_DISPLAY=wayland-ws-1 reached the
# user's services that way, 2026-09-29).
export RUNGIC_WORKSPACE=$slot WAYLAND_DISPLAY=wayland-ws-$slot
unset DISPLAY XAUTHORITY
export QT_QPA_PLATFORM=wayland XDG_CURRENT_DESKTOP=KDE XDG_SESSION_TYPE=wayland
# As in Plasma's session, whoever calls: programs tell a KDE session by these (Krita's OpenGL
# probe then leaves the desktop theme out, docs/103).
export KDE_FULL_SESSION=true KDE_SESSION_VERSION=6
# A desktop, set up as Plasma's desktop session is (docs/103): KDE programs open their file
# dialogs in process, not the phone's portal picker, and Qt picks the platform theme from
# XDG_CURRENT_DESKTOP (a forced one left Krita's session bus deaf).
export PLASMA_INTEGRATION_USE_PORTAL=0
unset QT_QPA_PLATFORMTHEME
# Its sound in a sink of its own, heard while the workspace is shown (rungic-workspace-sound); none
# if the sound server is not there (a missing PULSE_SINK would fail every stream).
if rungic-workspace-sound "$slot" up; then
    export PULSE_SINK=rungic_ws$slot
else
    unset PULSE_SINK
fi

# In a session bus of its own, at a fixed address: conversations and tools that already know
# it (the agent's Codex threads and their desktop tools, docs/research/91) reach the workspace
# again after it restarted (dbus-run-session's address changed with every start, and they failed
# with "Could not connect"). KWin starts its Xwayland on the first X client and picks a free
# display itself; the X socket it listens on is written to $state/display for rungic-workspace-env.
bus=$runtime/rungic-workspace-$slot.bus
rm -f "$state/bus" "$state/display" "$bus"
# Its own configuration: the workspace's accessibility bus (rungic-workspace-a11y) must not take
# the user's over; the desktop's passes the secret service to the user's session (rungic-bus-forward:
# one ksecretd for the passwords' files).
conf=session.conf
[ "$slot" != 0 ] || conf=desktop.conf
dbus-daemon --config-file=/usr/share/rungic-workspace/dbus-1/$conf --nofork --nopidfile \
    --address="unix:path=$bus" &
dbusd=$!
for i in $(seq 50); do [ -S "$bus" ] && break; sleep 0.1; done
export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"
if [ "$backend" = virtual ]; then
    # The size the host gives a workspace (the app's AGENT_SCREEN_SIZE); the GPU named, as KGSL is
    # not a DRM device (KWin's virtual-render-device patch).
    RUNGIC_KWIN_RENDER_DEVICE=/dev/kgsl-3d0 kwin_wayland --virtual --width 1920 --height 1080 \
        --socket "wayland-ws-$slot" --xwayland --no-lockscreen --no-global-shortcuts --no-kactivities &
else
    kwin_wayland --android-host --android-workspace --wayland-display="$host" \
        --socket "wayland-ws-$slot" --xwayland --no-lockscreen --no-global-shortcuts --no-kactivities &
fi
kwin=$!
# Stopped while its keeper had frozen the apps: thawed first, or they would not end on their signal.
# (On the user's bus: this one's has no systemd.)
thaw() {
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" systemctl --user thaw "app-rungicws$slot.slice" 2>/dev/null || true
}
# systemd signals the whole unit at once: KWin or the bus may be gone already, and a failed kill
# under set -e ended the script with 1 (the unit failed, 2026-10-01).
trap 'stopping=1; thaw; kill $kwin $dbusd 2>/dev/null || true' TERM INT
for i in $(seq 100); do
    inodes=$(ls -l /proc/$kwin/fd 2>/dev/null | sed -n 's/.*socket:\[\([0-9]*\)\].*/\1/p' | tr '\n' ' ')
    display=$(awk -v inodes=" $inodes" 'index(inodes, " " $7 " ") && $8 ~ /^\/tmp\/.X11-unix\/X/ { sub(/.*X/, "", $8); print ":" $8; exit }' /proc/net/unix)
    if [ -n "$display" ]; then
        echo "$display" > "$state/display"
        break
    fi
    sleep 0.1
done
echo "$DBUS_SESSION_BUS_ADDRESS" > "$state/bus"
# Its wallpaper: without Plasma's shell an empty workspace is transparent.
while [ ! -S "$runtime/wayland-ws-$slot" ] && kill -0 $kwin 2>/dev/null; do sleep 0.1; done
# One of the device's screens for remote viewing (RemoteSurface's screen registry, docs/research/97
# §15): the device's one RDP Host lists it and a viewer switches to it. Removed when it stops.
screens=$runtime/remote-surface/screens.d
mkdir -p "$screens"
name="Assistant screen $slot" kind=workspace
[ "$slot" != 0 ] || { name="Computer desktop" kind=desktop; }
printf '{"version": 1, "id": "ws-%s", "name": "%s", "kind": "%s", "order": %s, "wayland": "%s", "dbus": "%s", "desktop": "plasma", "resizable": false, "wake": false, "available": true, "reason": ""}\n' \
    "$slot" "$name" "$kind" "$slot" "$runtime/wayland-ws-$slot" "$DBUS_SESSION_BUS_ADDRESS" > "$screens/.ws-$slot.json.tmp"
mv "$screens/.ws-$slot.json.tmp" "$screens/ws-$slot.json"
if [ "$slot" = 0 ]; then
    # Plasma's desktop shell (taskbar, desktop, notifications, tray), again if it ends; the desktop
    # ends when it is turned off, never for being idle.
    rungic-desktop-dirs watch "$state" >"$state/dirs.log" 2>&1 &
    # Heard whenever it runs, where the user is (audio-follow: the TV in computer mode, else the phone);
    # its loopback back if the sound server lost it.
    if [ -n "${PULSE_SINK:-}" ]; then
        ( while kill -0 $kwin 2>/dev/null; do rungic-workspace-sound 0 listen || true; sleep 30; done ) &
    fi
    # Its clipboard in step with Android's, as the phone session's is (rungic-clipboard, one per
    # display): what is copied on the phone, in an Android app or on the desktop is pasted on the others.
    ( while kill -0 $kwin 2>/dev/null; do rungic-clipboard 2>>"$state/clipboard.log"; sleep 3; done ) &
    ( while kill -0 $kwin 2>/dev/null; do
          # Its layout set first (rungic-desktop-plasma: the volume applet shows the phone's devices);
          # a layout the shell has just made lacks it, and the shell starts once more.
          rungic-desktop-plasma >>"$state/plasmashell.log" 2>&1 || true
          plasmashell -p org.kde.plasma.desktop --no-respawn >"$state/plasmashell.log" 2>&1 &
          shell=$!
          ( sleep 20; ! rungic-desktop-plasma --needed || kill $shell ) &
          wait $shell
          sleep 2
      done ) &
else
    /usr/libexec/rungic-workspace-desktop &
    # Its apps frozen while nobody uses it, the workspace closed after long (keeper.cpp).
    /usr/libexec/rungic-workspace-keeper "$slot" 2>"$state/keeper.log" &
fi
status=0
wait $kwin || status=$?
# Stopped (systemctl stop, the workspace closed): the wait above ends at the signal with 143;
# KWin is still on its way out. A stop is a clean end, not a failure (the unit showed failed).
if [ -n "${stopping:-}" ]; then
    wait $kwin 2>/dev/null || true
    status=0
fi
kill $dbusd 2>/dev/null || true
exit $status
