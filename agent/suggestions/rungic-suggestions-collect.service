[Unit]
Description=Collect bounded, non-private system diagnostic summaries

[Service]
Type=oneshot
ExecStart=/usr/bin/rungic-suggestions --collect
StateDirectory=rungic-suggestions
StateDirectoryMode=0755
Nice=15
IOSchedulingClass=idle
MemoryMax=128M
TimeoutStartSec=40
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
