From: kevinzhow <kevinzhow@local>
Date: Wed, 23 Sep 2026 21:00:53 +0800
Subject: Idle inhibition is forwarded to the Android power service

On the Android host (MOTO_KWIN_RENDER_DEVICE set) an idle-inhibiting window keeps the phone screen on
through dev.moto.Android.Power.SetWaylandInhibition instead of KWin's own idle timers.

Forwarded: not-needed
Last-Update: 2026-09-26
X-Rungic-Status: Inappropriate [Android host specific: runs nested in the Android APK compositor]
X-Rungic-Tests: none (gap: no scenario plays a video and checks the screen stays on)
X-Rungic-Docs: docs/42
---
 src/idle_inhibition.cpp | 32 +++++++++++++++++++++++++++++++-
 src/idle_inhibition.h   |  3 +++
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/src/idle_inhibition.cpp b/src/idle_inhibition.cpp
index 8923a59..fe25c1f 100644
--- a/src/idle_inhibition.cpp
+++ b/src/idle_inhibition.cpp
@@ -14,6 +14,11 @@
 #include "window.h"
 #include "workspace.h"
 
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCall>
+#include <QTimer>
+
 #include <algorithm>
 #include <functional>
 
@@ -23,6 +28,13 @@ namespace KWin
 IdleInhibition::IdleInhibition(QObject *parent)
     : QObject(parent)
 {
+    if (qEnvironmentVariableIsSet("MOTO_KWIN_RENDER_DEVICE")) {
+        // Re-publish after the Android power bridge restarts independently.
+        auto timer = new QTimer(this);
+        timer->setInterval(5000);
+        connect(timer, &QTimer::timeout, this, &IdleInhibition::syncAndroidInhibition);
+        timer->start();
+    }
     // Workspace is created after the wayland server is initialized.
     connect(kwinApp(), &Application::workspaceCreated, this, &IdleInhibition::slotWorkspaceCreated);
 }
@@ -58,12 +70,30 @@ void IdleInhibition::registerClient(Window *client)
 void IdleInhibition::inhibit(Window *client)
 {
     input()->addIdleInhibitor(client);
-    // TODO: notify powerdevil?
+    if (!m_androidInhibitors.contains(client)) {
+        m_androidInhibitors.insert(client);
+        syncAndroidInhibition();
+    }
 }
 
 void IdleInhibition::uninhibit(Window *client)
 {
     input()->removeIdleInhibitor(client);
+    if (m_androidInhibitors.remove(client)) {
+        syncAndroidInhibition();
+    }
+}
+
+void IdleInhibition::syncAndroidInhibition()
+{
+    if (!qEnvironmentVariableIsSet("MOTO_KWIN_RENDER_DEVICE")) {
+        return;
+    }
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("org.kde.Solid.PowerManagement"),
+        QStringLiteral("/org/kde/Solid/PowerManagement/PolicyAgent"),
+        QStringLiteral("dev.moto.Android.Power"), QStringLiteral("SetWaylandInhibition"));
+    message << !m_androidInhibitors.isEmpty();
+    QDBusConnection::sessionBus().asyncCall(message);
 }
 
 void IdleInhibition::update(Window *client)
diff --git a/src/idle_inhibition.h b/src/idle_inhibition.h
index 6c3492a..1fd8e03 100644
--- a/src/idle_inhibition.h
+++ b/src/idle_inhibition.h
@@ -12,6 +12,7 @@
 #include <QList>
 #include <QMap>
 #include <QObject>
+#include <QSet>
 
 namespace KWin
 {
@@ -35,6 +36,8 @@ private:
     void uninhibit(Window *client);
     void update(Window *client);
 
+    void syncAndroidInhibition();
+    QSet<Window *> m_androidInhibitors;
     QMap<Window *, QMetaObject::Connection> m_connections;
 };
 }
