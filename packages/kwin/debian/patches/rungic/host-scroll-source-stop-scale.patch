From: clawd20130 <clawd20130@gmail.com>
Date: Sat, 26 Sep 2026 18:47:33 +0900
Subject: KWin moto17: host scrolling keeps its source,
 its stop and the output scale

The nested Wayland backend forwarded host axis events as a wheel of unknown
source without axis_stop, and in host pixels while positions are mapped from host coordinates: two-finger scrolling on the TV (CAST-1 at 1.75) went 1.75
times too far and clients scrolled it as a wheel. Now axis_source is kept, a
stop goes on as a zero delta (as libinput reports finger scrolling), the delta
is divided by the scale, and host finger scrolling is marked natural.

The scale and the natural direction come from the backend (WaylandOutput::hostScale(),
WaylandBackend::hostFingerScrollIsNatural()) since the round-2 fold (docs/72).

Forwarded: no
Last-Update: 2026-09-26
X-Rungic-Status: Pending [axis source and stop are generic for nested KWin; the scale and direction come from the backend]
X-Rungic-Tests: none (gap: no scenario scrolls on a scaled output)
X-Rungic-Docs: docs/66 docs/72
Origin: vendor, commit:02db74e1
---
 src/backends/wayland/wayland_backend.cpp | 42 ++++++++++++++++++++++++++++++--
 src/backends/wayland/wayland_backend.h   |  4 +++
 2 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/src/backends/wayland/wayland_backend.cpp b/src/backends/wayland/wayland_backend.cpp
index 1997533..713bac0 100644
--- a/src/backends/wayland/wayland_backend.cpp
+++ b/src/backends/wayland/wayland_backend.cpp
@@ -124,7 +124,28 @@ WaylandInputDevice::WaylandInputDevice(KWayland::Client::Pointer *pointer, Wayla
         }
         Q_EMIT pointerButtonChanged(button, state, std::chrono::milliseconds(time), this);
     });
-    // TODO: Send discreteDelta and source as well.
+    // TODO: Send discreteDelta as well.
+    // The source arrives before the values of its frame; finger scrolling ends with a stop, which
+    // goes on as a zero delta, the way libinput reports it, so clients can scroll kinetically.
+    connect(pointer, &Pointer::axisSourceChanged, this, [this](Pointer::AxisSource source) {
+        switch (source) {
+        case Pointer::AxisSource::Wheel:
+            m_axisSource = PointerAxisSource::Wheel;
+            break;
+        case Pointer::AxisSource::Finger:
+            m_axisSource = PointerAxisSource::Finger;
+            break;
+        case Pointer::AxisSource::Continuous:
+            m_axisSource = PointerAxisSource::Continuous;
+            break;
+        case Pointer::AxisSource::WheelTilt:
+            m_axisSource = PointerAxisSource::WheelTilt;
+            break;
+        default:
+            m_axisSource = PointerAxisSource::Unknown;
+            break;
+        }
+    });
     connect(pointer, &Pointer::axisChanged, this, [this](quint32 time, Pointer::Axis nativeAxis, qreal delta) {
         PointerAxis axis;
         switch (nativeAxis) {
@@ -137,11 +158,16 @@ WaylandInputDevice::WaylandInputDevice(KWayland::Client::Pointer *pointer, Wayla
         default:
             Q_UNREACHABLE();
         }
-        Q_EMIT pointerAxisChanged(axis, delta, 0, PointerAxisSource::Unknown, false, std::chrono::milliseconds(time), this);
+        Q_EMIT pointerAxisChanged(axis, delta / hostPixelsPerLogical(), 0, m_axisSource, naturalScroll(), std::chrono::milliseconds(time), this);
+    });
+    connect(pointer, &Pointer::axisStopped, this, [this](quint32 time, Pointer::Axis nativeAxis) {
+        const PointerAxis axis = nativeAxis == Pointer::Axis::Horizontal ? PointerAxis::Horizontal : PointerAxis::Vertical;
+        Q_EMIT pointerAxisChanged(axis, 0, 0, m_axisSource, naturalScroll(), std::chrono::milliseconds(time), this);
     });
 
     connect(pointer, &Pointer::frame, this, [this]() {
         Q_EMIT pointerFrame(this);
+        m_axisSource = PointerAxisSource::Unknown;
     });
 
     KWayland::Client::PointerGestures *pointerGestures = m_seat->backend()->display()->pointerGestures();
@@ -276,6 +302,18 @@ bool WaylandInputDevice::isLidSwitch() const
     return false;
 }
 
+qreal WaylandInputDevice::hostPixelsPerLogical() const
+{
+    // Host scroll distances are in host coordinates, like positions (WaylandOutput::mapFromHost).
+    const WaylandOutput *output = m_seat->backend()->findOutput(m_pointer->enteredSurface());
+    return output ? output->scale() / output->hostScale() : 1.0;
+}
+
+bool WaylandInputDevice::naturalScroll() const
+{
+    return m_axisSource == PointerAxisSource::Finger && m_seat->backend()->hostFingerScrollIsNatural();
+}
+
 KWayland::Client::Pointer *WaylandInputDevice::nativePointer() const
 {
     return m_pointer.get();
diff --git a/src/backends/wayland/wayland_backend.h b/src/backends/wayland/wayland_backend.h
index fb2bbd4..5733377 100644
--- a/src/backends/wayland/wayland_backend.h
+++ b/src/backends/wayland/wayland_backend.h
@@ -87,6 +87,9 @@ public:
     KWayland::Client::Pointer *nativePointer() const;
 
 private:
+    qreal hostPixelsPerLogical() const;
+    bool naturalScroll() const;
+
     WaylandSeat *const m_seat;
 
     std::unique_ptr<KWayland::Client::Keyboard> m_keyboard;
@@ -97,6 +100,7 @@ private:
     std::unique_ptr<KWayland::Client::PointerSwipeGesture> m_swipeGesture;
 
     QSet<quint32> m_pressedKeys;
+    PointerAxisSource m_axisSource = PointerAxisSource::Unknown;
 };
 
 class WaylandInputBackend : public InputBackend
