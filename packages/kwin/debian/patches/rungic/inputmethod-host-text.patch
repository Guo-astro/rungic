     connect(textInputV2, &TextInputV2Interface::contentTypeChanged, this, &InputMethod::contentTypeChanged);
@@ -196,10 +197,33 @@ void InputMethod::hide()
 bool InputMethod::shouldShowOnActive() const
 {
     static bool alwaysShowIm = qEnvironmentVariableIntValue("KWIN_IM_SHOW_ALWAYS") != 0;
-    return alwaysShowIm || input()->touch() == input()->lastInputHandler()
+    return (alwaysShowIm && !textInputOnExternalOutput()) || input()->touch() == input()->lastInputHandler()
         || input()->tablet() == input()->lastInputHandler();
 }
 
+bool InputMethod::textInputOnExternalOutput() const
+{
+    // docs/58: on an external output such as a Miracast TV the phone is its touchpad
+    // and keyboard; KWIN_IM_SHOW_ALWAYS (for the phone's touch screen) does not apply.
+    const Window *window = nullptr;
+    if (auto surface = waylandServer()->seat()->focusedTextInputSurface()) {
+        window = waylandServer()->findWindow(surface);
+    }
+    const LogicalOutput *output = window ? window->output() : workspace()->activeOutput();
+    return output && !output->isInternal();
+}
+
+void InputMethod::showForTextInput()
+{
+    // The panel's permission to show is sticky once granted, so a text field on the
+    // external output must not request it unless the user is touching (docs/58).
+    if (!shouldShowOnActive()) {
+        hide();
+        return;
+    }
+    show();
+}
+
 void InputMethod::refreshActive()
 {
     auto seat = waylandServer()->seat();
@@ -526,7 +550,7 @@ void InputMethod::textInputInterfaceV3EnabledChanged()
     auto t3 = waylandServer()->seat()->textInputV3();
     refreshActive();
     if (t3->isEnabled()) {
-        show();
+        showForTextInput();
     } else {
