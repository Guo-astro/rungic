+zwp_linux_surface_synchronization_v1 *WaylandOutput::surfaceSynchronization()
+{
+    if (!m_surfaceSynchronization) {
+        if (auto manager = m_backend->display()->explicitSynchronization()) {
+            m_surfaceSynchronization = zwp_linux_explicit_synchronization_v1_get_synchronization(manager, *m_surface);
+        }
+    }
+    return m_surfaceSynchronization;
+}
