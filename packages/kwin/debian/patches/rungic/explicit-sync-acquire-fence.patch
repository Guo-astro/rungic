diff --git a/src/backends/wayland/wayland_egl_backend.cpp b/src/backends/wayland/wayland_egl_backend.cpp
index eb6d594..6c4f32d 100644
--- a/src/backends/wayland/wayland_egl_backend.cpp
+++ b/src/backends/wayland/wayland_egl_backend.cpp
@@ -22,6 +22,7 @@
 #include "wayland_display.h"
 #include "wayland_logging.h"
 #include "wayland_output.h"
+#include "wayland-linux-explicit-synchronization-unstable-v1-client-protocol.h"
 
 #include <KWayland/Client/subsurface.h>
 #include <KWayland/Client/surface.h>
@@ -103,20 +104,39 @@ bool WaylandEglLayer::doEndFrame(const Region &renderedDeviceRegion, const Regio
 {
     m_query->end();
     frame->addRenderTimeQuery(std::move(m_query));
-    // Flush rendering commands to the dmabuf.
-    if (qEnvironmentVariableIsSet("MOTO_GPU_ALLOCATOR")) {
-        // Android vendor import has no explicit synchronization protocol yet.
+    // The Android host samples or scans out the buffer as soon as it is committed.
+    // With explicit synchronization the GPU completion fence travels with the
+    // commit (acquire fence) and this thread does not wait; otherwise wait here.
+    auto output = static_cast<WaylandOutput *>(m_output.get());
+    zwp_linux_surface_synchronization_v1 *sync = nullptr;
+    if (qEnvironmentVariableIsSet("MOTO_GPU_ALLOCATOR") && qEnvironmentVariableIsSet("MOTO_KWIN_FLAT_OUTPUT")
+        && qEnvironmentVariableIntValue("MOTO_KWIN_EXPLICIT_SYNC") != -1) {
+        sync = output->surfaceSynchronization();
+    }
+    if (qEnvironmentVariableIsSet("MOTO_GPU_ALLOCATOR") && !sync) {
         fTraceDuration("GpuWait (", m_output->name(), ")");
         glFinish();
-    } else {
-        glFlush();
     }
     EGLNativeFence releaseFence{m_backend->eglDisplayObject()};
+    if (sync && !releaseFence.isValid()) {
+        fTraceDuration("GpuWait (", m_output->name(), ")");
+        glFinish(); // no native fence: fall back to waiting
+        sync = nullptr;
+    }
+    if (!qEnvironmentVariableIsSet("MOTO_GPU_ALLOCATOR") || sync) {
+        glFlush();
+    }
 
     {
         fTraceDuration("Import (", m_output->name(), ")");
         setBuffer(m_backend->backend()->importBuffer(m_buffer->buffer()), damagedDeviceRegion);
     }
+    if (sync) {
+        // Double-buffered: applies to the buffer attached above at the output's next commit.
+        // libwayland duplicates the fd while marshalling.
+        fTrace("AcquireFence (", m_output->name(), ")");
+        zwp_linux_surface_synchronization_v1_set_acquire_fence(sync, releaseFence.fileDescriptor().get());
+    }
     m_swapchain->release(m_buffer, releaseFence.takeFileDescriptor());
 
     m_damageJournal.add(damagedDeviceRegion);
