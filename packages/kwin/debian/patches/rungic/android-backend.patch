+void HostOutput::handleScale(void *, wl_output *, int32_t)
+{
+}
+
+void HostOutput::handleName(void *, wl_output *, const char *)
+{
+}
+
+void HostOutput::handleDescription(void *, wl_output *, const char *)
+{
+}
