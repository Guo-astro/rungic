+/**
+ * KWin nested in the Android host compositor (`kwin_wayland --android-host`, docs/72): the
+ * Wayland backend plus what only that host needs. The phone's display settings go to Android;
+ * idle inhibition reaches the host as a standard zwp_idle_inhibitor_v1 on the phone output's
+ * surface (the host keeps the screen on while it exists).
+ */
+class KWIN_EXPORT AndroidBackend : public Wayland::WaylandBackend
+{
+    Q_OBJECT
+public:
+    explicit AndroidBackend(const Wayland::WaylandBackendOptions &options, QObject *parent = nullptr);
+    ~AndroidBackend() override;
+
+    bool initialize() override;
+    OutputConfigurationError applyOutputChanges(const OutputConfiguration &config) override;
+
+protected:
+    Wayland::WaylandOutput *createOutputObject(const QString &name, Wayland::HostOutput *hostOutput) override;
+
+private:
+    void bindHostGlobals();
+    void setIdleInhibited(bool inhibited);
+
+    wl_event_queue *m_queue = nullptr;
+    zwp_idle_inhibit_manager_v1 *m_idleInhibitManager = nullptr;
+    zwp_idle_inhibitor_v1 *m_idleInhibitor = nullptr;
+};
+
+} // namespace Android
+} // namespace KWin
