+*/
+#pragma once
+
+#include "backends/wayland/wayland_output.h"
+
+namespace KWin
+{
+namespace Android
+{
+
+class HostOutput;
+
+/**
+ * An output of KWin nested in the Android host (docs/72). The phone output offers the Android
+ * display's resolutions and refresh rates and is internal; a cast output (a Miracast TV or the
+ * assistant's screen, docs/58, docs/65) is shown fullscreen on its host output and has no cursor
+ * layer, since the host draws no cursor there. On every output of the host KWin owns the scale,
+ * since the host shows KWin's buffer 1:1.
+ */
+class AndroidOutput : public Wayland::WaylandOutput
+{
+    Q_OBJECT
+public:
+    /// hostOutput: the host output of a cast output; none for the phone.
+    AndroidOutput(const QString &name, Wayland::WaylandBackend *backend, HostOutput *hostOutput);
+
+    bool isPhone() const;
+
+    /// The host shows KWin's buffer pixel for pixel; KWin decides the scale; the primary layer
+    /// draws into the output surface, which the host presents (SurfaceControl) without copies.
+    qreal hostScale() const override;
+    bool ownsScale() const override;
+    bool singleSurface() const override;
+    bool hasCursorLayer() const override;
+
+protected:
+    QList<std::shared_ptr<OutputMode>> modesFor(const QSize &size, uint32_t rate) const override;
+    void applyExtraChanges(State &next, const OutputChangeSet &props, OutputConfiguration::Source source) override;
+
+private:
+    const bool m_phone;
+};
+
+} // namespace Android
+} // namespace KWin
