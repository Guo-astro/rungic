+HostOutput::HostOutput(wl_output *output, uint32_t version, QObject *parent)
+    : QObject(parent)
+    , m_output(output)
+    , m_version(version)
+{
+    static const wl_output_listener listener{
+        .geometry = &HostOutput::handleGeometry,
+        .mode = &HostOutput::handleMode,
+        .done = &HostOutput::handleDone,
+        .scale = &HostOutput::handleScale,
+        .name = &HostOutput::handleName,
+        .description = &HostOutput::handleDescription,
+    };
+    wl_output_add_listener(m_output, &listener, this);
