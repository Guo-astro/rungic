+*/
+#include "android_output.h"
+#include "android-display-client.h"
+#include "core/outputconfiguration.h"
+#include "core/renderloop.h"
+
+#include <QJsonArray>
+
+namespace KWin
+{
+namespace Android
+{
+
+AndroidOutput::AndroidOutput(const QString &name, Wayland::WaylandBackend *backend, Wayland::HostOutput *hostOutput)
+    : WaylandOutput(name, backend, hostOutput)
+    , m_phone(hostOutput == nullptr)
+{
+    if (m_phone) {
+        const QJsonObject info = MotoDisplay::info();
+        Information information = m_information;
+        information.physicalSize = QSize(info.value("physicalWidthMM").toInt(-1), info.value("physicalHeightMM").toInt(-1));
+        information.internal = true;
+        setInformation(information);
+    }
+}
+
+bool AndroidOutput::isPhone() const
+{
+    return m_phone;
+}
+
+QList<std::shared_ptr<OutputMode>> AndroidOutput::modesFor(const QSize &size, uint32_t rate) const
+{
+    if (!m_phone) {
+        return WaylandOutput::modesFor(size, rate);
+    }
+    const QJsonObject info = MotoDisplay::info();
+    QJsonArray resolutions = info.value(QStringLiteral("renderModes")).toArray();
+    QJsonArray rates = info.value(QStringLiteral("refreshRates")).toArray();
+    if (resolutions.isEmpty()) resolutions.append(QJsonObject{{"width", size.width()}, {"height", size.height()}});
+    if (rates.isEmpty()) rates.append(int(rate / 1000));
+    QList<std::shared_ptr<OutputMode>> result;
+    const auto add = [&](QSize dimensions, uint32_t refresh) {
+        for (const auto &mode : result) {
+            if (mode->size() == dimensions && mode->refreshRate() == refresh) return;
+        }
+        for (const auto &mode : m_state.modes) {
+            if (mode->size() == dimensions && mode->refreshRate() == refresh) {
+                result.append(mode);
+                return;
+            }
+        }
+        result.append(std::make_shared<OutputMode>(dimensions, refresh));
+    };
+    for (const auto &resolution : resolutions) {
+        const QJsonObject item = resolution.toObject();
+        const QSize dimensions(item.value("width").toInt(), item.value("height").toInt());
+        if (dimensions.width() < 320 || dimensions.height() < 320 || dimensions.width() > 8192 || dimensions.height() > 8192) continue;
+        for (const auto &entry : rates) {
+            const int refresh = entry.toInt();
+            if (refresh >= 20 && refresh <= 240) add(dimensions, refresh * 1000);
+        }
+    }
+    add(size, rate);
+    return result;
+}
+
+void AndroidOutput::applyExtraChanges(State &next, const OutputChangeSet &props, OutputConfiguration::Source source)
+{
+    next.scale = props.scale.value_or(m_state.scale);
+    next.scaleSetting = props.scaleSetting.value_or(m_state.scaleSetting);
+    // The Android host owns the buffer size and physical refresh. Only explicit user changes
+    // may override it; replaying saved system state must not undo rotation, automatic
+    // refresh or the host preference.
+    if (source == OutputConfiguration::Source::User && props.mode) {
+        if (const auto mode = props.mode->lock()) {
+            next.currentMode = mode;
+            setRefreshRate(mode->refreshRate());
+        }
+    }
+}
+
+} // namespace Android
+} // namespace KWin
