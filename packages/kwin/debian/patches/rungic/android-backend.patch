+    std::unique_ptr<GraphicsBufferAllocator> createShmAllocator() const override;
+
+protected:
+    Wayland::WaylandOutput *createOutputObject(const QString &name, wl_output *fullscreenOn) override;
+    void configureDisplay(Wayland::WaylandDisplay *display) override;
+    QString renderDevicePath() const override;
+    void setUpRenderDevice(DrmDevice *device) override;
+
+private:
+    void bindHostGlobals();
+    void handleGlobal(wl_registry *registry, uint32_t name, const QByteArray &interface, uint32_t version);
+    void handleGlobalRemoved(uint32_t name);
+    void handleHostOutput(HostOutput *hostOutput);
+    void handleHostOutputRemoved(HostOutput *hostOutput);
+    void setIdleInhibited(bool inhibited);
+
+    const AndroidBackendOptions m_android;
+    wl_event_queue *m_queue = nullptr;
+    zwp_idle_inhibit_manager_v1 *m_idleInhibitManager = nullptr;
+    zwp_idle_inhibitor_v1 *m_idleInhibitor = nullptr;
+    /// wl_output globals of the host by name: the phone's and one per cast display.
+    QHash<uint32_t, HostOutput *> m_hostOutputs;
+    QHash<HostOutput *, Wayland::WaylandOutput *> m_castOutputs;
+    bool m_initialized = false;
+    zwp_text_input_manager_v3 *m_textInputManager = nullptr;
+    std::unique_ptr<HostTextInput> m_textInput;
+};
+
