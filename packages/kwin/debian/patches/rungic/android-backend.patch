+    QString renderDevice = QStringLiteral("/dev/kgsl-3d0");
+    /// The host's buffer lease socket (docs/57).
+    QByteArray allocator = QByteArrayLiteral("/mnt/android-wayland/moto-gpu-alloc");
+};
