+
+void HostOutput::handleGeometry(void *data, wl_output *, int32_t, int32_t, int32_t physicalWidth, int32_t physicalHeight,
+                                int32_t, const char *make, const char *model, int32_t)
+{
+    auto self = static_cast<HostOutput *>(data);
+    self->m_physicalSize = QSize(physicalWidth, physicalHeight);
+    self->m_manufacturer = QString::fromUtf8(make);
+    self->m_model = QString::fromUtf8(model);
+}
+
+void HostOutput::handleMode(void *data, wl_output *, uint32_t flags, int32_t width, int32_t height, int32_t refresh)
+{
+    if (flags & WL_OUTPUT_MODE_CURRENT) {
+        auto self = static_cast<HostOutput *>(data);
+        self->m_pixelSize = QSize(width, height);
+        self->m_refreshRate = refresh;
+    }
+}
+
+void HostOutput::handleDone(void *data, wl_output *)
+{
+    Q_EMIT static_cast<HostOutput *>(data)->changed();
+}
