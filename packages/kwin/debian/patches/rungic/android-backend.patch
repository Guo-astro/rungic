+*/
+#include "android_backend.h"
+#include "android-display-client.h"
+#include "android_allocator.h"
+#include "android_output.h"
+#include "host_output.h"
+#include "host_text_input.h"
+#include "core/drmdevice.h"
+#include "core/gbmgraphicsbufferallocator.h"
+#include "core/shmgraphicsbufferallocator.h"
+#include "backends/wayland/wayland_display.h"
+#include "backends/wayland/wayland_logging.h"
+#include "core/outputconfiguration.h"
+#include "input.h"
+#include "main.h"
+
+#include "wayland-idle-inhibit-unstable-v1-client-protocol.h"
+#include "wayland-text-input-unstable-v3-client-protocol.h"
+
+#include <KWayland/Client/seat.h>
+
+#include <KWayland/Client/surface.h>
+
+#include <cmath>
+#include <cstring>
+#include <unistd.h>
+#include <wayland-client.h>
+
+namespace KWin
+{
+namespace Android
+{
+
+AndroidBackend::AndroidBackend(const Wayland::WaylandBackendOptions &options, const AndroidBackendOptions &android, QObject *parent)
+    : WaylandBackend(options, parent)
+    , m_android(android)
+{
+    // Input exists once the workspace does.
+    connect(kwinApp(), &Application::workspaceCreated, this, [this]() {
+        connect(input(), &InputRedirection::idleInhibitedChanged, this, &AndroidBackend::setIdleInhibited);
+        setIdleInhibited(!input()->idleInhibitors().isEmpty());
+    });
+}
+
+AndroidBackend::~AndroidBackend()
+{
+    // Everything bound on the host goes before the connection does (~WaylandBackend).
+    m_textInput.reset();
+    if (m_textInputManager) {
+        zwp_text_input_manager_v3_destroy(m_textInputManager);
+    }
+    qDeleteAll(m_hostOutputs);
+    m_hostOutputs.clear();
+    if (m_idleInhibitor) {
+        zwp_idle_inhibitor_v1_destroy(m_idleInhibitor);
+    }
+    if (m_idleInhibitManager) {
+        zwp_idle_inhibit_manager_v1_destroy(m_idleInhibitManager);
+    }
+    if (m_queue) {
+        wl_event_queue_destroy(m_queue);
+    }
+}
+
+bool AndroidBackend::initialize()
+{
+    if (!WaylandBackend::initialize()) {
+        return false;
+    }
+    bindHostGlobals();
+    if (m_textInputManager) {
+        m_textInput = std::make_unique<HostTextInput>(m_textInputManager, *display()->seat());
+    }
+    // Cast displays (Miracast TV, the assistant's screen) announced so far, now that the phone's
+    // output exists; later ones as they come.
+    m_initialized = true;
+    for (HostOutput *hostOutput : std::as_const(m_hostOutputs)) {
+        handleHostOutput(hostOutput);
+    }
+    return true;
+}
+
+void AndroidBackend::handleGlobal(wl_registry *registry, uint32_t name, const QByteArray &interface, uint32_t version)
+{
+    if (interface == wl_output_interface.name) {
+        // v3 at most: release on destruction exists from v3; name/description (v4) are not needed.
+        const uint32_t bound = std::min(version, 3u);
+        auto hostOutput = new HostOutput(static_cast<wl_output *>(wl_registry_bind(registry, name, &wl_output_interface, bound)), bound, this);
+        m_hostOutputs.insert(name, hostOutput);
+        connect(hostOutput, &HostOutput::changed, this, [this, hostOutput]() {
+            if (m_initialized) {
+                handleHostOutput(hostOutput);
+            }
+        });
+    } else if (interface == zwp_text_input_manager_v3_interface.name) {
+        m_textInputManager = static_cast<zwp_text_input_manager_v3 *>(wl_registry_bind(registry, name, &zwp_text_input_manager_v3_interface, 1));
+    }
+}
+
+void AndroidBackend::handleGlobalRemoved(uint32_t name)
+{
+    if (HostOutput *hostOutput = m_hostOutputs.take(name)) {
+        handleHostOutputRemoved(hostOutput);
+        hostOutput->deleteLater();
+    }
+}
+
+static bool isCastHostOutput(HostOutput *hostOutput)
+{
+    // The host names its cast outputs so (native/plasma cast.rs).
+    return hostOutput->manufacturer() == QLatin1String("Moto") && hostOutput->model() == QLatin1String("Cast");
+}
+
+void AndroidBackend::handleHostOutput(HostOutput *hostOutput)
+{
+    if (!isCastHostOutput(hostOutput) || m_castOutputs.contains(hostOutput) || hostOutput->pixelSize().isEmpty()) {
+        return;
+    }
+    // The first scale of a cast output; KWin keeps the user's by the output's name.
+    const qreal scale = 1.5;
+    // Reuse the lowest free number: KWin keeps an output's settings (scale) by its name, and the
+    // same TV reconnects as a new host output every time.
+    int number = 1;
+    while (std::ranges::any_of(m_castOutputs, [number](Wayland::WaylandOutput *cast) {
+        return cast->name() == QStringLiteral("CAST-%1").arg(number);
+    })) {
+        number++;
+    }
+    Wayland::WaylandOutput *output = createOutput(QStringLiteral("CAST-%1").arg(number), hostOutput->pixelSize(), scale, true, hostOutput->output());
+    qCInfo(KWIN_WAYLAND_BACKEND) << "Cast output added" << output->name() << hostOutput->pixelSize() << "scale" << scale;
+    m_castOutputs.insert(hostOutput, output);
+    addOutput(output);
+}
+
+void AndroidBackend::handleHostOutputRemoved(HostOutput *hostOutput)
+{
+    if (Wayland::WaylandOutput *output = m_castOutputs.take(hostOutput)) {
+        qCInfo(KWIN_WAYLAND_BACKEND) << "Cast output removed" << output->name();
+        removeOutput(output);
+    }
+}
+
+static void registryGlobal(void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+    auto manager = static_cast<zwp_idle_inhibit_manager_v1 **>(data);
+    if (std::strcmp(interface, zwp_idle_inhibit_manager_v1_interface.name) == 0) {
+        *manager = static_cast<zwp_idle_inhibit_manager_v1 *>(
+            wl_registry_bind(registry, name, &zwp_idle_inhibit_manager_v1_interface, 1));
+    }
+}
+
+static void registryGlobalRemove(void *, wl_registry *, uint32_t)
+{
+}
+
+static const wl_registry_listener s_registryListener = {registryGlobal, registryGlobalRemove};
+
+void AndroidBackend::bindHostGlobals()
+{
+    // A registry of our own on a queue of our own: the Wayland backend's event thread keeps
+    // dispatching the default queue, and nothing bound here sends events after the roundtrip.
+    wl_display *display = this->display()->nativeDisplay();
+    m_queue = wl_display_create_queue(display);
+    auto wrapper = static_cast<wl_display *>(wl_proxy_create_wrapper(display));
+    wl_proxy_set_queue(reinterpret_cast<wl_proxy *>(wrapper), m_queue);
+    wl_registry *registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_registry_add_listener(registry, &s_registryListener, &m_idleInhibitManager);
+    wl_display_roundtrip_queue(display, m_queue);
+    wl_registry_destroy(registry);
+    if (!m_idleInhibitManager) {
+        qCWarning(KWIN_WAYLAND_BACKEND) << "Android host without zwp_idle_inhibit_manager_v1: idle inhibition stays local";
+    }
+}
+
+void AndroidBackend::setIdleInhibited(bool inhibited)
+{
+    if (!m_idleInhibitManager || inhibited == (m_idleInhibitor != nullptr)) {
+        return;
+    }
+    if (!inhibited) {
+        zwp_idle_inhibitor_v1_destroy(m_idleInhibitor);
+        m_idleInhibitor = nullptr;
+    } else {
+        for (Wayland::WaylandOutput *output : waylandOutputs()) {
+            if (static_cast<AndroidOutput *>(output)->isPhone()) {
+                m_idleInhibitor = zwp_idle_inhibit_manager_v1_create_inhibitor(m_idleInhibitManager, *output->surface());
+                break;
+            }
+        }
+    }
+    wl_display_flush(display()->nativeDisplay());
+    qCDebug(KWIN_WAYLAND_BACKEND) << "idle inhibition on the Android host:" << (m_idleInhibitor != nullptr);
+}
+
+Wayland::WaylandOutput *AndroidBackend::createOutputObject(const QString &name, wl_output *fullscreenOn)
+{
+    HostOutput *hostOutput = nullptr;
+    for (HostOutput *candidate : std::as_const(m_hostOutputs)) {
+        if (candidate->output() == fullscreenOn) {
+            hostOutput = candidate;
+        }
+    }
+    return new AndroidOutput(name, this, fullscreenOn ? hostOutput : nullptr);
+}
+
+void AndroidBackend::configureDisplay(Wayland::WaylandDisplay *display)
+{
+    // The host goes away whenever its app is updated or restarted. Waiting for its socket and
+    // asking kwin_wayland_wrapper for a restart (exit code 133) replaces an abort per host
+    // restart: no core dump, and the wrapper's crash counter (it gives up after ten) is not
+    // consumed. Clients stay on the wrapper's socket and reconnect.
+    connect(display, &Wayland::WaylandDisplay::globalAnnounced, this, &AndroidBackend::handleGlobal);
+    connect(display, &Wayland::WaylandDisplay::globalRemoved, this, &AndroidBackend::handleGlobalRemoved);
+    display->setConnectTimeout(std::chrono::seconds(60));
+    const QByteArray socket = options().socketName.toUtf8();
+    display->setConnectionLostHandler([socket]() {
+        qCWarning(KWIN_WAYLAND_BACKEND) << "Host connection lost; waiting for the Android host to restart";
+        for (int waited = 0; waited < 120000; waited += 250) {
+            if (wl_display *probe = wl_display_connect(socket.constData())) {
+                wl_display_disconnect(probe);
+                break;
+            }
+            usleep(250 * 1000);
+        }
+        ::_exit(133); // kwin_wayland_wrapper: restart without counting a crash
+    });
+}
+
+QString AndroidBackend::renderDevicePath() const
+{
+    return m_android.renderDevice;
+}
+
+void AndroidBackend::setUpRenderDevice(DrmDevice *device)
+{
+    // Output buffers come from the host (AHardwareBuffer leases), which presents them itself.
+    device->setAllocator(std::make_unique<AndroidGraphicsBufferAllocator>(
+        m_android.allocator, std::make_unique<GbmGraphicsBufferAllocator>(device->gbmDevice())));
+}
+
+int AndroidBackend::maxLinuxDmabufVersion() const
+{
+    // v4 and later name the render node as main device; clients' Mesa cannot use a KGSL node.
+    return 3;
+}
+
+bool AndroidBackend::implicitSync() const
+{
+    return false; // AHardwareBuffers: the host waits for nothing unless given a fence
+}
+
+bool AndroidBackend::hostImportsClientBuffers() const
+{
+    return false; // the host presents only buffers it leased
+}
+
+bool AndroidBackend::hostFingerScrollIsNatural() const
+{
+    return true; // the host scrolls with fingers as a touch screen does
+}
+
+std::unique_ptr<GraphicsBufferAllocator> AndroidBackend::createShmAllocator() const
+{
+    // Software buffers the host maps need the APK's SELinux label, which the container's private
+    // /dev/shm mount supplies; a memfd's would not do.
+    return std::make_unique<ShmGraphicsBufferAllocator>(QByteArrayLiteral("/dev/shm"));
+}
+
+OutputConfigurationError AndroidBackend::applyOutputChanges(const OutputConfiguration &config)
+{
+    if (config.source == OutputConfiguration::Source::User) {
+        for (Wayland::WaylandOutput *output : waylandOutputs()) {
+            const auto props = config.constChangeSet(output);
+            // A cast output (TV) has the host's size: nothing to ask Android for.
+            if (!props || !static_cast<AndroidOutput *>(output)->isPhone()) continue;
+            if (props->scale && (!std::isfinite(*props->scale) || *props->scale < 0.5 || *props->scale > 3.0)) {
+                return OutputConfigurationError::Unknown;
+            }
+            const auto mode = props->mode ? props->mode->lock() : nullptr;
+            if (!mode || (mode->size() == output->modeSize() && mode->refreshRate() == output->refreshRate())) continue;
+            QJsonObject request{{"width", mode->size().width()}, {"height", mode->size().height()}};
+            if (mode->refreshRate() != output->refreshRate()) {
+                request.insert(QStringLiteral("refreshPolicy"), int(std::round(mode->refreshRate() / 1000.0)));
+            }
+            const auto reply = RungicDisplay::request(request);
+            if (reply.contains(QStringLiteral("error"))) {
+                qCWarning(KWIN_WAYLAND_BACKEND) << "Android display rejected configuration:" << reply;
+                return OutputConfigurationError::Unknown;
+            }
+        }
+    }
+    return OutputBackend::applyOutputChanges(config);
+}
+
+} // namespace Android
+} // namespace KWin
