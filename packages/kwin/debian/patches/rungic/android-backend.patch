+
+/**
+ * An output of KWin nested in the Android host (docs/72). The phone output (no host output
+ * behind it) offers the Android display's resolutions and refresh rates and is internal; on
+ * every output of the host KWin owns the scale, since the host shows KWin's buffer 1:1.
+ */
+class AndroidOutput : public Wayland::WaylandOutput
+{
+    Q_OBJECT
+public:
+    AndroidOutput(const QString &name, Wayland::WaylandBackend *backend, Wayland::HostOutput *hostOutput);
+
+    bool isPhone() const;
+
+protected:
+    QList<std::shared_ptr<OutputMode>> modesFor(const QSize &size, uint32_t rate) const override;
+    void applyExtraChanges(State &next, const OutputChangeSet &props, OutputConfiguration::Source source) override;
+
+private:
+    const bool m_phone;
+};
+
+} // namespace Android
+} // namespace KWin
