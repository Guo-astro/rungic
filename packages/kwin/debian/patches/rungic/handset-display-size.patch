+std::optional<double> AndroidOutput::recommendedScale(const QSize &size) const
+{
+    if (!m_phone) return std::nullopt;
+    using namespace Rungic::Display;
+    double nativeEdge = shortEdge(size.width(), size.height());
+    for (const auto &mode : modes()) nativeEdge = std::max(nativeEdge, shortEdge(mode->size().width(), mode->size().height()));
+    const auto p = policy();
+    return presets(shortEdge(size.width(), size.height()), dpi(size, physicalSize(), p), nativeEdge, p, androidReference())[2];
+}
+
+std::optional<double> AndroidOutput::logicalDpi() const { return m_logicalDpi; }
+
+void AndroidOutput::prepareDisplaySize(OutputChangeSet &change, bool userRequest) const
+{
+    if (!m_phone || !currentMode()) return;
+    using namespace Rungic::Display;
+    const auto requestedMode = change.mode ? change.mode->lock() : nullptr;
+    const QSize oldSize = modeSize();
+    // System replay must follow the Android host, not force an old rendering mode/rotation.
+    const QSize target = userRequest && requestedMode ? requestedMode->size() : oldSize;
+    const double newDpi = dpi(target, physicalSize());
+    double density = 0;
+    if (userRequest) {
+        const double requested = change.scaleSetting.value_or(scaleSetting());
+        if (!validScale(requested)) return; // applyOutputChanges returns a failure, not a clamp
+        density = requestedDensity(dpi(oldSize, physicalSize()), newDpi, scaleSetting(), requested,
+                                   m_logicalDpi.value_or(0), shortEdge(oldSize.width(), oldSize.height()) != shortEdge(target.width(), target.height()));
+    } else {
+        const QSize reference = change.desiredModeSize.value_or(requestedMode ? requestedMode->size() : oldSize);
+        const double savedScale = change.scaleSetting.value_or(scaleSetting());
+        density = change.logicalDpi.value_or(m_logicalDpi.value_or(dpi(reference, physicalSize()) / savedScale));
+    }
+    if (!validDensity(density)) return;
+    double effective = effectiveScale(newDpi, density);
+    if (!userRequest && !validScale(effective)) {
+        // A host mode change can make an old custom preference unrepresentable. Keep the
+        // session usable within the persistent format's limits; explicit requests still fail.
+        effective = std::clamp(effective, minimumScale, maximumScale);
+        density = newDpi / effective;
+    }
+    change.logicalDpi = density;
+    change.scaleSetting = effective;
+    change.scale = effective;
+    // Save the scale together with the actual render mode for old readers and migration.
+    change.desiredModeSize = target;
+    if (!userRequest) {
+        change.mode = currentMode();
+        change.desiredModeRefreshRate = refreshRate();
+        change.desiredModeFlags = currentMode()->flags();
+    }
+}
+
+bool AndroidOutput::requestsFixedRefresh(const OutputChangeSet &change) const
+{
+    const auto mode = change.mode ? change.mode->lock() : nullptr;
+    // Standard clients may submit a stale current Hz together with another change while
+    // Android varies its automatic rate. Only a rate-only request implies a fixed policy.
+    return m_phone && !change.vrrPolicy && mode && mode->size() == modeSize()
+        && mode->refreshRate() != refreshRate()
+        && Rungic::Display::sameScale(change.scale.value_or(scale()), scale());
+}
