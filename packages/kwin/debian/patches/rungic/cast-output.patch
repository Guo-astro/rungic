 {
-    WaylandOutput *waylandOutput = new WaylandOutput(name, this);
+    WaylandOutput *waylandOutput = new WaylandOutput(name, this, hostOutput);
     waylandOutput->init(size, scale, fullscreen);
 
     // Wait until the output window is configured by the host compositor.
@@ -494,6 +502,40 @@ WaylandOutput *WaylandBackend::createOutput(const QString &name, const QSize &si
     return waylandOutput;
 }
 
+static bool isCastHostOutput(KWayland::Client::Output *hostOutput)
+{
+    return hostOutput->manufacturer() == QLatin1String("Moto") && hostOutput->model() == QLatin1String("Cast");
+}
+
+void WaylandBackend::handleHostOutput(KWayland::Client::Output *hostOutput)
+{
+    if (!isCastHostOutput(hostOutput) || m_castOutputs.contains(hostOutput) || hostOutput->pixelSize().isEmpty()) {
+        return;
+    }
+    bool ok = false;
+    qreal scale = qEnvironmentVariable("MOTO_KWIN_CAST_SCALE").toDouble(&ok);
+    if (!ok || scale < 0.5 || scale > 4.0) {
+        scale = 1.5;
+    }
+    WaylandOutput *output = createOutput(QStringLiteral("CAST-%1").arg(++m_castOutputSerial), hostOutput->pixelSize(), scale, true, hostOutput);
+    qCInfo(KWIN_WAYLAND_BACKEND) << "Cast output added" << output->name() << hostOutput->pixelSize() << "scale" << scale;
+    m_castOutputs.insert(hostOutput, output);
+    m_outputs << output;
+    Q_EMIT outputAdded(output);
+    Q_EMIT outputsQueried();
+}
+
+void WaylandBackend::handleHostOutputRemoved(KWayland::Client::Output *hostOutput)
+{
+    WaylandOutput *output = m_castOutputs.take(hostOutput);
+    if (output && m_outputs.removeAll(output)) {
+        qCInfo(KWIN_WAYLAND_BACKEND) << "Cast output removed" << output->name();
+        Q_EMIT outputRemoved(output);
+        Q_EMIT outputsQueried();
+        output->unref();
+    }
+}
+
 void WaylandBackend::destroyOutputs()
 {
     while (!m_outputs.isEmpty()) {
@@ -565,7 +607,7 @@ OutputConfigurationError WaylandBackend::applyOutputChanges(const OutputConfigur
     if (qEnvironmentVariableIsSet("MOTO_KWIN_FLAT_OUTPUT") && config.source == OutputConfiguration::Source::User) {
         for (WaylandOutput *output : m_outputs) {
             const auto props = config.constChangeSet(output);
-            if (!props) continue;
+            if (!props || output->isCast()) continue;
             if (props->scale && (!std::isfinite(*props->scale) || *props->scale < 0.5 || *props->scale > 3.0)) {
                 return OutputConfigurationError::Unknown;
             }
