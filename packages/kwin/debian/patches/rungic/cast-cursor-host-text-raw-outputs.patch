+// The Android host delivers text from the Android keyboard that no key can type
+// (Chinese, emoji...) over text-input-v3 to the focused surface, which is one of
+// KWin's output windows. Keep text input enabled on them and pass each commit to
+// KWin's input method, which gives it to the focused client's text input or,
+// failing that, types it with a temporary keymap (docs/58 step 3).
+void WaylandSeat::createTextInput()
+{
+    zwp_text_input_manager_v3 *manager = m_backend->display()->textInputManager();
+    if (!manager) {
+        return;
+    }
+    static const auto enable = [](zwp_text_input_v3 *textInput) {
+        zwp_text_input_v3_enable(textInput);
+        zwp_text_input_v3_set_content_type(textInput, ZWP_TEXT_INPUT_V3_CONTENT_HINT_NONE, ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NORMAL);
+        zwp_text_input_v3_commit(textInput);
+    };
+    static const zwp_text_input_v3_listener listener{
+        .enter = [](void *, zwp_text_input_v3 *textInput, wl_surface *) {
+            enable(textInput);
+        },
+        .leave = [](void *, zwp_text_input_v3 *, wl_surface *) {},
+        .preedit_string = [](void *, zwp_text_input_v3 *, const char *, int32_t, int32_t) {},
+        .commit_string = [](void *data, zwp_text_input_v3 *, const char *text) {
+            static_cast<WaylandSeat *>(data)->m_pendingCommit = QString::fromUtf8(text);
+        },
+        .delete_surrounding_text = [](void *, zwp_text_input_v3 *, uint32_t, uint32_t) {},
+        .done = [](void *data, zwp_text_input_v3 *, uint32_t) {
+            auto seat = static_cast<WaylandSeat *>(data);
+            const QString text = std::exchange(seat->m_pendingCommit, QString());
+            if (!text.isEmpty() && kwinApp()->inputMethod()) {
+                kwinApp()->inputMethod()->commitHostText(text);
+            }
+        },
+    };
+    m_textInput = zwp_text_input_manager_v3_get_text_input(manager, *m_seat);
+    zwp_text_input_v3_add_listener(m_textInput, &listener, this);
+    // The host sends enter only when its keyboard focus changes; it may already be on
+    // one of our surfaces. It accepts enable from the focused client.
+    enable(m_textInput);
+}
