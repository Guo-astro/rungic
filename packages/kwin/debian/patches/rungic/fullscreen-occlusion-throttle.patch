+
+// A window below one whose opaque content covers the whole output gets frame callbacks only once
+// a second and its commits make the output composite nothing; partly covered windows and windows
+// below a translucent one are not affected.
+// covers[system]: desktop-mode.fullscreen/E6
+class TestFullscreenOcclusion : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase();
+    void init();
+    void cleanup();
+
+    void testCoveredWindowThrottled();
+    void testTranslucentCover();
+    void testPartialCover();
+    void testPingCoveredWindow();
+};
+
+void TestFullscreenOcclusion::initTestCase()
+{
+    qRegisterMetaType<KWin::Window *>();
+    QVERIFY(waylandServer()->init(s_socketName));
+
+    // no effects: an opening animation transforms the covering window for a while
+    auto config = KSharedConfig::openConfig(QString(), KConfig::SimpleConfig);
+    KConfigGroup plugins(config, QStringLiteral("Plugins"));
+    const auto builtinNames = EffectLoader().listOfKnownEffects();
+    for (const QString &name : builtinNames) {
+        plugins.writeEntry(name + QStringLiteral("Enabled"), false);
+    }
+    config->sync();
+    kwinApp()->setConfig(config);
+
+    kwinApp()->start();
+    Test::setOutputConfig({
+        Rect(0, 0, 1280, 1024),
+    });
+}
+
+void TestFullscreenOcclusion::init()
+{
+    QVERIFY(Test::setupWaylandConnection());
+}
+
+void TestFullscreenOcclusion::cleanup()
+{
+    Test::destroyWaylandConnection();
+}
+
+// The client draws its next frame whenever the compositor says the last one was shown.
+static void animate(KWayland::Client::Surface *surface, const QSize &size)
+{
+    QObject::connect(surface, &KWayland::Client::Surface::frameRendered, surface, [surface, size]() {
+        surface->setupFrameCallback();
+        Test::render(surface, size, Qt::blue);
+        Test::flushWaylandConnection();
+    });
+    surface->setupFrameCallback();
+    Test::render(surface, size, Qt::blue);
+    Test::flushWaylandConnection();
+}
+
+static int framesIn(KWayland::Client::Surface *surface, std::chrono::milliseconds duration)
+{
+    QSignalSpy spy(surface, &KWayland::Client::Surface::frameRendered);
+    QElapsedTimer elapsed;
+    elapsed.start();
+    while (elapsed.elapsed() < duration.count()) {
+        spy.wait(duration.count() - elapsed.elapsed());
+    }
+    qDebug() << "frame callbacks in" << duration.count() << "ms:" << spy.count();
+    return spy.count();
+}
+
+static Window *showFullscreen(KWayland::Client::Surface *surface, Test::XdgToplevel *toplevel, QImage::Format format)
+{
+    QSignalSpy toplevelConfigureRequestedSpy(toplevel, &Test::XdgToplevel::configureRequested);
+    QSignalSpy surfaceConfigureRequestedSpy(toplevel->xdgSurface(), &Test::XdgSurface::configureRequested);
+    toplevel->set_fullscreen(nullptr);
+    surface->commit(KWayland::Client::Surface::CommitFlag::None);
+    if (!surfaceConfigureRequestedSpy.wait()) {
+        return nullptr;
+    }
+    toplevel->xdgSurface()->ack_configure(surfaceConfigureRequestedSpy.last().at(0).value<quint32>());
+    return Test::renderAndWaitForShown(surface, toplevelConfigureRequestedSpy.last().at(0).value<QSize>(), Qt::red, format);
+}
+
+void TestFullscreenOcclusion::testCoveredWindowThrottled()
+{
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> toplevel(Test::createXdgToplevelSurface(surface.get()));
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    animate(surface.get(), QSize(100, 50));
+    QVERIFY(framesIn(surface.get(), 500ms) >= 15);
+
+    // an opaque fullscreen window on top
+    std::unique_ptr<KWayland::Client::Surface> coverSurface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> coverToplevel(Test::createXdgToplevelSurface(coverSurface.get(), Test::CreationSetup::CreateOnly));
+    Window *cover = showFullscreen(coverSurface.get(), coverToplevel.get(), QImage::Format_RGB32);
+    QVERIFY(cover);
+    QVERIFY(cover->isFullScreen());
+    QTest::qWait(100);
+
+    QSignalSpy presentedSpy(window->output()->backendOutput()->renderLoop(), &RenderLoop::framePresented);
+    const int coveredFrames = framesIn(surface.get(), 2500ms);
+    QVERIFY2(coveredFrames >= 1 && coveredFrames <= 4, qPrintable(QString::number(coveredFrames)));
+    QVERIFY2(presentedSpy.count() <= 1, qPrintable(QString::number(presentedSpy.count())));
+
+    // uncovered: its pending frame callback at once, then the full rate again
+    QSignalSpy frameSpy(surface.get(), &KWayland::Client::Surface::frameRendered);
+    QElapsedTimer elapsed;
+    elapsed.start();
+    coverToplevel.reset();
+    coverSurface.reset();
+    QVERIFY(Test::waitForWindowClosed(cover));
+    if (frameSpy.isEmpty()) {
+        QVERIFY(frameSpy.wait(500));
+    }
+    QVERIFY2(elapsed.elapsed() < 300, qPrintable(QString::number(elapsed.elapsed())));
+    QVERIFY(framesIn(surface.get(), 500ms) >= 15);
+}
+
+void TestFullscreenOcclusion::testTranslucentCover()
+{
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> toplevel(Test::createXdgToplevelSurface(surface.get()));
+    QVERIFY(Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue));
+    animate(surface.get(), QSize(100, 50));
+
+    // a fullscreen window with alpha and no opaque region does not hide what is below it
+    std::unique_ptr<KWayland::Client::Surface> coverSurface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> coverToplevel(Test::createXdgToplevelSurface(coverSurface.get(), Test::CreationSetup::CreateOnly));
+    Window *cover = showFullscreen(coverSurface.get(), coverToplevel.get(), QImage::Format_ARGB32_Premultiplied);
+    QVERIFY(cover);
+    QTest::qWait(100);
+    QVERIFY(framesIn(surface.get(), 500ms) >= 15);
+}
+
+void TestFullscreenOcclusion::testPartialCover()
+{
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> toplevel(Test::createXdgToplevelSurface(surface.get()));
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    animate(surface.get(), QSize(100, 50));
+
+    // an opaque window hiding all of it, but not the whole output: no change
+    std::unique_ptr<KWayland::Client::Surface> coverSurface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> coverToplevel(Test::createXdgToplevelSurface(coverSurface.get()));
+    Window *cover = Test::renderAndWaitForShown(coverSurface.get(), QSize(400, 300), Qt::red, QImage::Format_RGB32);
+    QVERIFY(cover);
+    cover->move(window->pos() - QPointF(50, 50));
+    QVERIFY(cover->frameGeometry().contains(window->frameGeometry()));
+    QTest::qWait(100);
+    QVERIFY(framesIn(surface.get(), 500ms) >= 15);
+}
+
+void TestFullscreenOcclusion::testPingCoveredWindow()
+{
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> toplevel(Test::createXdgToplevelSurface(surface.get()));
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    animate(surface.get(), QSize(100, 50));
+
+    std::unique_ptr<KWayland::Client::Surface> coverSurface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> coverToplevel(Test::createXdgToplevelSurface(coverSurface.get(), Test::CreationSetup::CreateOnly));
+    QVERIFY(showFullscreen(coverSurface.get(), coverToplevel.get(), QImage::Format_RGB32));
+    QTest::qWait(100);
+
+    // just after a heartbeat, the next one is a second away
+    QSignalSpy frameSpy(surface.get(), &KWayland::Client::Surface::frameRendered);
+    QVERIFY(frameSpy.wait(1500));
+    QTest::qWait(200);
+    frameSpy.clear();
+
+    // a client waiting for its frame callback could not answer a ping in time: it gets it now
+    QElapsedTimer elapsed;
+    elapsed.start();
+    window->closeWindow();
+    QVERIFY(frameSpy.wait(500));
+    QVERIFY2(elapsed.elapsed() < 150, qPrintable(QString::number(elapsed.elapsed())));
+}
+
+WAYLANDTEST_MAIN(TestFullscreenOcclusion)
+#include "fullscreen_occlusion_test.moc"
