+// A window whose opaque content covers a whole output hides every window below it there, and
+// KWin's occlusion culling already paints none of them. Those windows get no frame callbacks with
+// the output's frames and their commits and damage schedule none (RenderView::scheduleRepaint):
+// a program animating behind a fullscreen window no longer keeps the output compositing identical
+// frames. A heartbeat sends them frame callbacks once a second, so that clients waiting for one
+// (eglSwapBuffers, FIFO) are not stalled. Only a single window covering the entire output counts:
+// partly covered windows are not affected.
+static constexpr std::chrono::milliseconds s_coveredFrameInterval(1000);
+
+WorkspaceScene::Coverage WorkspaceScene::findCoverage(SceneView *delegate) const
+{
+    Coverage coverage;
+    // the windows painted, from the bottom, with what effects did to them in this frame
+    if (painted_delegate != delegate || (m_paintContext.mask & (PAINT_SCREEN_TRANSFORMED | PAINT_SCREEN_WITH_TRANSFORMED_WINDOWS))) {
+        return coverage;
+    }
+    const Rect deviceRect = delegate->deviceRect();
+    const RectF viewport = delegate->viewport();
+    for (int i = m_paintContext.phase2Data.size() - 1; i >= 0; --i) {
+        const Phase2Data &data = m_paintContext.phase2Data[i];
+        // the same conditions as the occlusion culling in paintSimpleScreen()
+        if (data.mask & (PAINT_WINDOW_TRANSLUCENT | PAINT_WINDOW_TRANSFORMED)) {
+            continue;
+        }
+        const bool canCover = delegate->shouldRenderItem(data.item->surfaceItem())
+            || delegate->shouldRenderHole(data.item->surfaceItem());
+        if (!canCover || !data.deviceOpaque.contains(deviceRect)) {
+            continue;
+        }
+        coverage.cover = data.item;
+        for (int j = 0; j < i; ++j) {
+            WindowItem *item = m_paintContext.phase2Data[j].item;
+            const Window *window = item->window();
+            // rendered elsewhere at their own rate: thumbnails, window screencasts
+            if (window->isOffscreenRendering() || window->isInputMethod() || window->isLockScreen() || window->isLockScreenOverlay()) {
+                continue;
+            }
+            // nothing of it may be shown on another output
+            if (!viewport.contains(item->mapToScene(item->boundingRect()))) {
+                continue;
+            }
+            coverage.covered.append(item);
+        }
+        break;
+    }
+    return coverage;
+}
+
+void WorkspaceScene::updateCoverage(SceneView *delegate)
+{
+    Coverage next = findCoverage(delegate);
+    auto it = m_coverage.find(delegate);
+    if (it == m_coverage.end()) {
+        if (next.covered.isEmpty()) {
+            return;
+        }
+        it = m_coverage.insert(delegate, Coverage{});
+        connect(delegate, &QObject::destroyed, this, [this, delegate]() {
+            forgetCoverage(delegate);
+        });
+    }
+    // uncovered windows get their frame callbacks with this frame, and their repaints were
+    // collected in it
+    for (const QPointer<WindowItem> &item : std::as_const(it->covered)) {
+        if (item && item->coveredIn() == delegate && !next.covered.contains(item)) {
+            item->setCoveredIn(nullptr);
+        }
+    }
+    for (const QPointer<WindowItem> &item : std::as_const(next.covered)) {
+        item->setCoveredIn(delegate);
+    }
+    *it = next;
+
+    const bool anyCovered = std::ranges::any_of(m_coverage, [](const Coverage &coverage) {
+        return !coverage.covered.isEmpty();
+    });
+    if (!anyCovered) {
+        m_coveredFrameTimer.stop();
+    } else if (!m_coveredFrameTimer.isActive()) {
+        m_coveredFrameTimer.start(s_coveredFrameInterval);
+    }
+}
+
+void WorkspaceScene::forgetCoverage(SceneView *delegate)
+{
+    const Coverage coverage = m_coverage.take(delegate);
+    for (const QPointer<WindowItem> &item : coverage.covered) {
+        if (item && item->coveredIn() == delegate) {
+            item->setCoveredIn(nullptr);
+        }
+    }
+}
+
+static bool stillCovers(SceneView *view, WindowItem *cover)
+{
+    if (!cover || !cover->isVisible() || cover->window()->opacity() != 1.0 || view->shouldHideWindow(cover->window())) {
+        return false;
+    }
+    Region opaque;
+    addOpaqueRegionRecursive(view, cover, std::nullopt, opaque);
+    return opaque.contains(view->deviceRect());
+}
+
+void WorkspaceScene::sendCoveredFrameCallbacks()
+{
+    const auto timestamp = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch());
+    const QList<SceneView *> views = m_coverage.keys();
+    for (SceneView *view : views) {
+        const auto it = m_coverage.constFind(view);
+        if (it == m_coverage.constEnd() || it->covered.isEmpty()) {
+            continue;
+        }
+        if (!stillCovers(view, it->cover)) {
+            // the cover went away or turned translucent without a frame of this output;
+            // the next frame finds out what is visible now
+            view->addDeviceRepaint(view->deviceRect());
+        }
+        const QList<QPointer<WindowItem>> covered = it->covered;
+        for (const QPointer<WindowItem> &item : covered) {
+            if (item) {
+                item->framePainted(nullptr, view->logicalOutput(), nullptr, timestamp);
+            }
+        }
+    }
+}
