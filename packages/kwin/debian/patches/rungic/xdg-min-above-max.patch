+void TestXdgShellWindow::testMinimumAboveMaximum()
+{
+    // xdg-shell makes a maximum below the minimum an invalid_size error. KWin keeps such a client
+    // (WeChat 4.1 sizes its maximum from the 360 px wide phone screen) connected and drops the
+    // conflicting maximum instead; the minimum is what the content needs.
+    QSignalSpy connectionErrorSpy(Test::waylandConnection(), &KWayland::Client::ConnectionThread::errorOccurred);
+    auto surface = Test::createSurface();
+    auto shellSurface = Test::createXdgToplevelSurface(surface.get(), [](Test::XdgToplevel *toplevel) {
+        toplevel->set_min_size(700, 400);
+        toplevel->set_max_size(360, 800);
+    });
+    Window *window = Test::renderAndWaitForShown(surface.get(), QSize(700, 400), Qt::cyan);
+    QVERIFY(window);
+    QCOMPARE(window->minSize(), QSizeF(700, 400));
+    QCOMPARE(window->maxSize(), QSizeF(INT_MAX, 800));
+
+    QSignalSpy committedSpy(window->surface(), &SurfaceInterface::committed);
+    shellSurface->set_max_size(360, 300);
+    surface->commit(KWayland::Client::Surface::CommitFlag::None);
+    QVERIFY(committedSpy.wait());
+    QCOMPARE(window->maxSize(), QSizeF(INT_MAX, INT_MAX));
+
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(connectionErrorSpy.count(), 0);
+}
