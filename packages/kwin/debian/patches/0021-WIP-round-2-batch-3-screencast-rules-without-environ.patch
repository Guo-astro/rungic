diff --git a/src/plugins/screencast/screencastmanager.cpp b/src/plugins/screencast/screencastmanager.cpp
index a4b6101..937eef1 100644
--- a/src/plugins/screencast/screencastmanager.cpp
+++ b/src/plugins/screencast/screencastmanager.cpp
@@ -107,8 +107,7 @@ static std::optional<pid_t> getPid(ScreencastStreamV1Interface *waylandStream)
     // Plasma Mobile records from its own shell process. Excluding that PID
     // also removes the wallpaper, launcher and panels, yielding a black home
     // screen. Keep explicit per-window excludeFromCapture filtering intact.
-    const bool mobileShellRecorder = qEnvironmentVariableIsSet("MOTO_KWIN_FLAT_OUTPUT")
-        && executable == QStringLiteral("/usr/bin/plasmashell");
+    const bool mobileShellRecorder = executable == QStringLiteral("/usr/bin/plasmashell");
     if (mobileShellRecorder || executable.contains("xdg-desktop-portal-kde")) {
         // HACK to avoid the portal's windows being hidden
         return std::nullopt;
diff --git a/src/plugins/screencast/screencastutils.h b/src/plugins/screencast/screencastutils.h
index 4714533..9538dc3 100644
--- a/src/plugins/screencast/screencastutils.h
+++ b/src/plugins/screencast/screencastutils.h
@@ -47,10 +47,10 @@ static void doGrabTexture(GLTexture *texture, QImage *target)
 
     const auto context = EglContext::currentContext();
     const QSize size = texture->size();
-    // Android's nested GLES framebuffer follows the same bottom-left readback
-    // convention as GL. Correct it here for every SHM screencast consumer.
-    const bool glesReadbackCorrection = context->isOpenGLES() && !qEnvironmentVariableIsSet("MOTO_KWIN_FLAT_OUTPUT");
