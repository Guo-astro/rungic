+void AndroidBackend::configureDisplay(Wayland::WaylandDisplay *display)
+{
+    // The host goes away whenever its app is updated or restarted. Waiting for its socket and
+    // asking kwin_wayland_wrapper for a restart (exit code 133) replaces an abort per host
+    // restart: no core dump, and the wrapper's crash counter (it gives up after ten) is not
+    // consumed. Clients stay on the wrapper's socket and reconnect.
+    display->setConnectTimeout(std::chrono::seconds(60));
+    const QByteArray socket = options().socketName.toUtf8();
+    display->setConnectionLostHandler([socket]() {
+        qCWarning(KWIN_WAYLAND_BACKEND) << "Host connection lost; waiting for the Android host to restart";
+        for (int waited = 0; waited < 120000; waited += 250) {
+            if (wl_display *probe = wl_display_connect(socket.constData())) {
+                wl_display_disconnect(probe);
+                break;
+            }
+            usleep(250 * 1000);
+        }
+        ::_exit(133); // kwin_wayland_wrapper: restart without counting a crash
+    });
+}
+
+QString AndroidBackend::renderDevicePath() const
+{
+    return m_android.renderDevice;
+}
+
+void AndroidBackend::setUpRenderDevice(DrmDevice *device)
+{
+    // Output buffers come from the host (AHardwareBuffer leases), which presents them itself.
+    device->setAllocator(std::make_unique<AndroidGraphicsBufferAllocator>(
+        m_android.allocator, std::make_unique<GbmGraphicsBufferAllocator>(device->gbmDevice())));
+}
+
+int AndroidBackend::maxLinuxDmabufVersion() const
+{
+    // v4 and later name the render node as main device; clients' Mesa cannot use a KGSL node.
+    return 3;
+}
+
+bool AndroidBackend::implicitSync() const
+{
+    return false; // AHardwareBuffers: the host waits for nothing unless given a fence
+}
+
+bool AndroidBackend::hostImportsClientBuffers() const
+{
+    return false; // the host presents only buffers it leased
+}
+
+bool AndroidBackend::hostFingerScrollIsNatural() const
+{
+    return true; // the host scrolls with fingers as a touch screen does
+}
+
+std::unique_ptr<GraphicsBufferAllocator> AndroidBackend::createShmAllocator() const
