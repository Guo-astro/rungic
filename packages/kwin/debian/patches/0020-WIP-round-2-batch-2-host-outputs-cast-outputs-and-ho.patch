+/*
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "host_text_input.h"
+#include "inputmethod.h"
+#include "main.h"
+
+#include "wayland-text-input-unstable-v3-client-protocol.h"
+
+#include <utility>
+
+namespace KWin
+{
+namespace Android
+{
+
+static void enable(zwp_text_input_v3 *textInput)
+{
+    zwp_text_input_v3_enable(textInput);
+    zwp_text_input_v3_set_content_type(textInput, ZWP_TEXT_INPUT_V3_CONTENT_HINT_NONE, ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NORMAL);
+    zwp_text_input_v3_commit(textInput);
+}
+
+HostTextInput::HostTextInput(zwp_text_input_manager_v3 *manager, wl_seat *seat)
+    : m_textInput(zwp_text_input_manager_v3_get_text_input(manager, seat))
+{
+    static const zwp_text_input_v3_listener listener{
+        .enter = [](void *, zwp_text_input_v3 *textInput, wl_surface *) {
+            enable(textInput);
+        },
+        .leave = [](void *, zwp_text_input_v3 *, wl_surface *) {},
+        .preedit_string = [](void *, zwp_text_input_v3 *, const char *, int32_t, int32_t) {},
+        .commit_string = [](void *data, zwp_text_input_v3 *, const char *text) {
+            static_cast<HostTextInput *>(data)->m_pendingCommit = QString::fromUtf8(text);
+        },
+        .delete_surrounding_text = [](void *, zwp_text_input_v3 *, uint32_t, uint32_t) {},
+        .done = [](void *data, zwp_text_input_v3 *, uint32_t) {
+            auto self = static_cast<HostTextInput *>(data);
+            const QString text = std::exchange(self->m_pendingCommit, QString());
+            if (!text.isEmpty() && kwinApp()->inputMethod()) {
+                kwinApp()->inputMethod()->commitHostText(text);
+            }
+        },
+    };
+    zwp_text_input_v3_add_listener(m_textInput, &listener, this);
+    // The host sends enter only when its keyboard focus changes; it may already be on one of our
+    // surfaces. It accepts enable from the focused client.
+    enable(m_textInput);
+}
+
+HostTextInput::~HostTextInput()
+{
+    zwp_text_input_v3_destroy(m_textInput);
+}
+
+} // namespace Android
+} // namespace KWin
