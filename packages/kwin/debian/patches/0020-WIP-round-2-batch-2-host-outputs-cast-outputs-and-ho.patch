+#pragma once
+
+#include <QString>
+
+struct wl_seat;
+struct zwp_text_input_manager_v3;
+struct zwp_text_input_v3;
+
+namespace KWin
+{
+namespace Android
+{
+
+/**
+ * Text the Android host commits from its keyboard (Chinese, emoji...: what no key can type) over
+ * text-input-v3 to the focused surface, which is one of KWin's output windows (docs/58 step 3).
+ * Text input stays enabled on them; each commit goes to KWin's input method, which gives it to
+ * the focused client's text input or, failing that, types it with a temporary keymap.
+ */
+class HostTextInput
+{
+public:
+    HostTextInput(zwp_text_input_manager_v3 *manager, wl_seat *seat);
+    ~HostTextInput();
+
+private:
+    zwp_text_input_v3 *m_textInput;
+    QString m_pendingCommit;
+};
+
