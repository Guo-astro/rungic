+/*
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+#include <QSize>
+#include <QString>
+
+struct wl_output;
+
+namespace KWin
+{
+namespace Android
+{
+
+/**
+ * A wl_output of the host compositor (docs/58, docs/72): identity and current mode.
+ * Read from the raw protocol instead of KWayland::Client::Output, whose
+ * addMode() keeps an iterator across QList::erase and crashes when the host
+ * announces a mode again (every refresh or resolution change of the phone).
+ */
+class HostOutput : public QObject
+{
+    Q_OBJECT
+
+public:
+    HostOutput(wl_output *output, uint32_t version, QObject *parent);
+    ~HostOutput() override;
+
+    wl_output *output() const;
+    QString manufacturer() const;
+    QString model() const;
+    QSize physicalSize() const;
+    QSize pixelSize() const;
+    /// mHz
+    int refreshRate() const;
+
+Q_SIGNALS:
+    /// A complete set of properties arrived (wl_output.done).
+    void changed();
+
+private:
+    static void handleGeometry(void *data, wl_output *output, int32_t x, int32_t y, int32_t physicalWidth, int32_t physicalHeight,
+                               int32_t subpixel, const char *make, const char *model, int32_t transform);
+    static void handleMode(void *data, wl_output *output, uint32_t flags, int32_t width, int32_t height, int32_t refresh);
+    static void handleDone(void *data, wl_output *output);
+    static void handleScale(void *data, wl_output *output, int32_t factor);
+    static void handleName(void *data, wl_output *output, const char *name);
+    static void handleDescription(void *data, wl_output *output, const char *description);
+
+    wl_output *m_output;
+    uint32_t m_version;
+    QString m_manufacturer;
+    QString m_model;
+    QSize m_physicalSize;
+    QSize m_pixelSize;
+    int m_refreshRate = 0;
+};
+
+} // namespace Android
+} // namespace KWin
