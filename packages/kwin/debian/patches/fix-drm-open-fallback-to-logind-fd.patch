Description: Fall back to logind file descriptor when direct DRM node open fails
 When running as the SDDM greeter compositor, kwin_wayland opens DRM
 devices via logind TakeDevice (which succeeds), then tries to open the
 same device directly with ::open(). After a session switch, the greeter
 user (sddm) may lack filesystem-level permissions on /dev/dri/card*
 because logind ACLs have not yet been updated, causing the direct open
 to fail and the greeter compositor to abort.
 .
 This patch makes openWithAuthentication() fall back to duplicating the
 already-valid logind file descriptor when the direct open fails,
 allowing the greeter compositor to start reliably after logout.
Author: Erich Eickmeyer <eeickmeyer@kfocus.org>
Forwarded: not-yet
Last-Update: 2026-04-03
---
 src/core/drmdevice.cpp |   27 ++++++++++++++++++---------
 1 file changed, 18 insertions(+), 9 deletions(-)

Index: b/src/core/drmdevice.cpp
===================================================================
--- a/src/core/drmdevice.cpp
+++ b/src/core/drmdevice.cpp
@@ -92,15 +92,19 @@ std::unique_ptr<DrmDevice> DrmDevice::op
 {
     FileDescriptor fd(::open(path.toLocal8Bit(), O_RDWR | O_CLOEXEC));
     if (!fd.isValid()) {
-        qCWarning(KWIN_CORE) << "Failed to open drm node:" << path;
-        return nullptr;
-    }
-    struct stat buf;
-    if (fstat(fd.get(), &buf) == -1) {
-        qCWarning(KWIN_CORE) << "Failed to fstat drm fd" << path;
-        return nullptr;
-    }
-    if (authenticatedFd != -1) {
+        if (authenticatedFd != -1) {
+            // The direct open failed (e.g. the greeter user lacks file-level
+            // permissions after a session switch), but we already have a valid
+            // FD from logind TakeDevice.  Duplicate it and use it instead.
+            qCDebug(KWIN_CORE) << "Direct open failed for" << path
+                               << "- falling back to logind file descriptor";
+            fd = FileDescriptor(fcntl(authenticatedFd, F_DUPFD_CLOEXEC, 0));
+        }
+        if (!fd.isValid()) {
+            qCWarning(KWIN_CORE) << "Failed to open drm node:" << path;
+            return nullptr;
+        }
+    } else if (authenticatedFd != -1) {
         drm_magic_t magic;
         if (drmGetMagic(fd.get(), &magic) < 0) {
             qCDebug(KWIN_CORE) << "Failed to get the drm magic token for" << path;
@@ -109,6 +113,11 @@ std::unique_ptr<DrmDevice> DrmDevice::op
             qCWarning(KWIN_CORE) << "Failed to authenticate the drm magic token. path:" << path << "error:" << strerror(errno);
         }
     }
+    struct stat buf;
+    if (fstat(fd.get(), &buf) == -1) {
+        qCWarning(KWIN_CORE) << "Failed to fstat drm fd" << path;
+        return nullptr;
+    }
     gbm_device *device = gbm_create_device(fd.get());
     if (!device) {
         qCWarning(KWIN_CORE) << "Failed to create gbm device for" << path;
