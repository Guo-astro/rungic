From: kevinzhow <kevinzhow@local>
Date: Wed, 23 Sep 2026 21:00:53 +0800
Subject: Record video with this project's H.264 encoder (motoh264enc) when it
 is available

Snapshot recognises the GStreamer element of the Android hardware codec bridge as an H.264 encoder,
hardware accelerated, and sets its bitrate, ahead of openh264enc and x264enc.

Forwarded: not-needed
Last-Update: 2026-09-26
X-Rungic-Status: Inappropriate [the encoder is this project's Android codec bridge]
X-Rungic-Tests: none (gap: no scenario records video in Snapshot)
X-Rungic-Docs: docs/48 docs/54
---
 aperture/src/utils.rs      |  5 ++++-
 aperture/src/viewfinder.rs | 13 +++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/aperture/src/utils.rs b/aperture/src/utils.rs
index 72ab13b..7c36d53 100644
--- a/aperture/src/utils.rs
+++ b/aperture/src/utils.rs
@@ -173,7 +173,9 @@ pub(crate) mod caps {
 // Whether the system supports h264 video encoding.
 pub fn is_h264_encoding_supported() -> bool {
     let registry = gst::Registry::get();
-    registry.lookup_feature("openh264enc").is_some() || registry.lookup_feature("x264enc").is_some()
+    registry.lookup_feature("motoh264enc").is_some()
+        || registry.lookup_feature("openh264enc").is_some()
+        || registry.lookup_feature("x264enc").is_some()
 }
 
 // Whether the system supports hardware video encoding for a given format.
@@ -184,6 +186,7 @@ pub fn is_hardware_encoding_supported(format: crate::VideoFormat) -> bool {
             registry.lookup_feature("vah264lpenc").is_some()
                 || registry.lookup_feature("vah264enc").is_some()
                 || registry.lookup_feature("v4l2h264enc").is_some()
+                || registry.lookup_feature("motoh264enc").is_some()
         }
         crate::VideoFormat::Vp8Webm => {
             registry.lookup_feature("vavp8lpenc").is_some()
diff --git a/aperture/src/viewfinder.rs b/aperture/src/viewfinder.rs
index 7209cb5..6459d09 100644
--- a/aperture/src/viewfinder.rs
+++ b/aperture/src/viewfinder.rs
@@ -907,6 +907,11 @@ impl Viewfinder {
 
         // Video encoder properties
         let video_properties_map = ElementProperties::builder_map()
+            .item(
+                ElementPropertiesMapItem::builder("motoh264enc")
+                    .field("bitrate", 4000u32)
+                    .build(),
+            )
             .item(
                 ElementPropertiesMapItem::builder("x264enc")
                     .field("bitrate", DEFAULT_BITRATE)
@@ -994,6 +999,14 @@ impl Viewfinder {
                     }
                     hw_encoder_found = true;
                 }
+                if let Some(encoder) = registry.lookup_feature("motoh264enc") {
+                    encoder.set_rank(if self.enable_hw_encoding() {
+                        gst::Rank::PRIMARY + 32
+                    } else {
+                        gst::Rank::NONE
+                    });
+                    hw_encoder_found = true;
+                }
                 if let Some(encoder) = registry.lookup_feature("openh264enc") {
                     encoder.set_rank(gst::Rank::PRIMARY);
                 }
