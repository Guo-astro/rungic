+bool KCMKScreen::androidDisplay() const
+{
+    return !m_androidInfo.isEmpty();
+}
+
+QVariantMap KCMKScreen::androidDisplayInfo() const
+{
+    return m_androidInfo;
+}
+
+QVariantList KCMKScreen::androidRefreshChoices() const
+{
+    QVariantList choices{QVariantMap{{"label", i18n("Automatic")}, {"value", 0}}};
+    for (const QVariant &rate : m_androidInfo.value(QStringLiteral("refreshRates")).toList()) {
+        choices.append(QVariantMap{{"label", QString::number(rate.toInt()) + QStringLiteral(" Hz")}, {"value", rate.toInt()}});
+    }
+    return choices;
+}
+
+int KCMKScreen::androidRefreshPolicy() const
+{
+    return m_androidPolicy;
+}
+
+void KCMKScreen::setAndroidRefreshPolicy(int policy)
+{
+    bool supported = policy == 0;
+    for (const QVariant &rate : m_androidInfo.value(QStringLiteral("refreshRates")).toList()) {
+        if (rate.toInt() == policy) supported = true;
+    }
+    if (!supported || policy == m_androidPolicy) return;
+    m_androidPolicy = policy;
+    Q_EMIT androidRefreshPolicyChanged();
+    settingsChanged();
+}
+
+void KCMKScreen::readAndroidDisplay()
+{
+    const auto value = MotoDisplay::info().toVariantMap();
+    if (value.isEmpty()) return;
+    if (!needsSave() && !m_stopUpdatesFromBackend) {
+        const int oldPolicy = m_androidPolicy;
+        m_androidPolicy = value.value(QStringLiteral("refreshPolicy")).toInt();
+        m_androidSavedPolicy = m_androidPolicy;
+        if (oldPolicy != m_androidPolicy) Q_EMIT androidRefreshPolicyChanged();
+    }
+    if (value == m_androidInfo) return;
+    const bool choicesChanged = value.value(QStringLiteral("refreshRates")) != m_androidInfo.value(QStringLiteral("refreshRates"));
+    m_androidInfo = value;
+    if (choicesChanged) Q_EMIT androidRefreshChoicesChanged();
+    Q_EMIT androidDisplayChanged();
+}
