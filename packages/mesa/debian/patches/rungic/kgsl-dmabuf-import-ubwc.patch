From: clawd20130 <clawd20130@gmail.com>
Date: Thu, 24 Sep 2026 06:11:40 +0900
Subject: freedreno: opt-in import of gralloc UBWC buffers on the kgsl dma-buf
 path

FD_KGSL_DMABUF_UBWC=1 lets the kgsl dma-buf path import (not export) DRM_FORMAT_MOD_QCOM_COMPRESSED
buffers allocated by the platform gralloc. fdl6's explicit UBWC layout (metadata plane first, 64x16 tile
alignment, 256-byte pitch) matches gralloc's RGBA8888_UBWC allocation, and gallium leaves the UBWC mode
registers to the kernel's platform configuration, so the GPU, the display and the platform GLES driver
agree. Modifier queries and exports stay LINEAR, so clients allocate as before.

Forwarded: no
Last-Update: 2026-09-27
X-Rungic-Status: Pending [the branch's narrow KGSL dma-buf contract (its PR #85) rejects non-linear imports on purpose; this is an opt-in]
X-Rungic-Tests: L3:perf.compositor (KWin exports FD_KGSL_DMABUF_UBWC=1)
X-Rungic-Docs: docs/57
---
 src/gallium/drivers/freedreno/freedreno_resource.c |  4 +++-
 src/gallium/drivers/freedreno/freedreno_screen.c   | 10 +++++++++-
 src/gallium/drivers/freedreno/freedreno_screen.h   |  7 +++++++
 3 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/freedreno/freedreno_resource.c b/src/gallium/drivers/freedreno/freedreno_resource.c
index bcb6c2c..995b3fa 100644
--- a/src/gallium/drivers/freedreno/freedreno_resource.c
+++ b/src/gallium/drivers/freedreno/freedreno_resource.c
@@ -1562,7 +1562,9 @@ fd_resource_from_handle(struct pipe_screen *pscreen,
 
    if (screen->kgsl_dmabuf &&
        handle->modifier != DRM_FORMAT_MOD_LINEAR &&
-       handle->modifier != DRM_FORMAT_MOD_INVALID) {
+       handle->modifier != DRM_FORMAT_MOD_INVALID &&
+       !(screen->kgsl_dmabuf_ubwc &&
+         handle->modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED)) {
       if (FD_DBG(LAYOUT))
          mesa_loge("kgsl cannot import non-linear modifier %" PRIx64,
                    handle->modifier);
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.c b/src/gallium/drivers/freedreno/freedreno_screen.c
index 1275dfb..29e2bb2 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.c
+++ b/src/gallium/drivers/freedreno/freedreno_screen.c
@@ -98,6 +98,12 @@ fd_kgsl_dmabuf_enabled(void)
           debug_get_bool_option("XWAYLAND_FORCE_KGSL_SURFACELESS", false);
 }
 
+static bool
+fd_kgsl_dmabuf_ubwc_enabled(void)
+{
+   return debug_get_bool_option("FD_KGSL_DMABUF_UBWC", false);
+}
+
 static const char *
 fd_screen_get_name(struct pipe_screen *pscreen)
 {
@@ -902,7 +908,8 @@ fd_screen_is_dmabuf_modifier_supported(struct pipe_screen *pscreen,
 
    if (screen->kgsl_dmabuf &&
        modifier != DRM_FORMAT_MOD_LINEAR &&
-       modifier != DRM_FORMAT_MOD_INVALID)
+       modifier != DRM_FORMAT_MOD_INVALID &&
+       !(screen->kgsl_dmabuf_ubwc && modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED))
       return false;
 
    return is_format_supported(pscreen, format, modifier);
@@ -1007,6 +1014,7 @@ fd_screen_create(int fd,
    screen->dev = dev;
    screen->is_kgsl = fd_get_features(dev) & FD_FEATURE_KGSL;
    screen->kgsl_dmabuf = screen->is_kgsl && fd_kgsl_dmabuf_enabled();
+   screen->kgsl_dmabuf_ubwc = screen->kgsl_dmabuf && fd_kgsl_dmabuf_ubwc_enabled();
    screen->ro = ro;
 
    // maybe this should be in context?
diff --git a/src/gallium/drivers/freedreno/freedreno_screen.h b/src/gallium/drivers/freedreno/freedreno_screen.h
index d3276c8..4b4f03c 100644
--- a/src/gallium/drivers/freedreno/freedreno_screen.h
+++ b/src/gallium/drivers/freedreno/freedreno_screen.h
@@ -77,6 +77,13 @@ struct fd_screen {
    bool has_syncobj;
    bool is_kgsl;
    bool kgsl_dmabuf;
+   /* Opt-in on the kgsl dma-buf path: import (never export) UBWC buffers
+    * allocated by the platform gralloc.  Their layout is the one
+    * fdl6_layout computes (metadata plane first); the UBWC bank/swizzle
+    * configuration is programmed by the kernel for the whole GPU, so it
+    * matches the display and the platform GLES driver.
+    */
+   bool kgsl_dmabuf_ubwc;
 
    struct {
       /* Conservative LRZ (default true) invalidates LRZ on draws with
