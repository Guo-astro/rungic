 {
+   struct fd_screen *screen = fd_screen(pscreen);
+
+   if (screen->kgsl_dmabuf) {
+      *count = is_format_supported(pscreen, format,
+                                   DRM_FORMAT_MOD_LINEAR) ? 1 : 0;
+
+      if (*count && max > 0) {
+         if (modifiers)
+            modifiers[0] = DRM_FORMAT_MOD_LINEAR;
+
+         if (external_only)
+            external_only[0] = !is_rendering_supported(pscreen, format);
+      }
+
+      return;
+   }
+
    const uint64_t all_modifiers[] = {
       DRM_FORMAT_MOD_LINEAR,
       DRM_FORMAT_MOD_QCOM_COMPRESSED,
@@ -865,6 +903,14 @@ fd_screen_is_dmabuf_modifier_supported(struct pipe_screen *pscreen,
                                        enum pipe_format format,
                                        bool *external_only)
 {
+   struct fd_screen *screen = fd_screen(pscreen);
+
+   if (screen->kgsl_dmabuf &&
+       modifier != DRM_FORMAT_MOD_LINEAR &&
+       modifier != DRM_FORMAT_MOD_INVALID &&
+       !(screen->kgsl_dmabuf_ubwc && modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED))
