 {
@@ -383,6 +395,13 @@ fd_init_screen_caps(struct fd_screen *screen)
 
    u_init_pipe_screen_caps(&screen->base, 1);
 
+   /* KGSL is not DRM: drmGetCap(DRM_CAP_PRIME) cannot describe it. The backend
