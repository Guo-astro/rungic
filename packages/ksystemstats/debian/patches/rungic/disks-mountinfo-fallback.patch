+#include <QFile>
+#include <QTest>
+
+#include "../MountInfo.h"
+
+// covers: apps.system-monitor/E3
+class MountInfoTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void testParse();
+    void testContainer();
+    void testBtrfsDesktop();
+    void testEmpty();
+
+private:
+    static QByteArray fixture(const QString &name);
+};
+
+QByteArray MountInfoTest::fixture(const QString &name)
+{
+    QFile file(QFINDTESTDATA(QStringLiteral("fixtures/") + name));
+    if (!file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    return file.readAll();
+}
+
+void MountInfoTest::testParse()
+{
+    const auto mounts = MountInfo::parse(fixture(QStringLiteral("mountinfo-btrfs.txt")));
+    QCOMPARE(mounts.size(), 9);
+    QCOMPARE(mounts[2].major, 0u);
+    QCOMPARE(mounts[2].minor, 35u);
+    QCOMPARE(mounts[2].root, QStringLiteral("/@"));
+    QCOMPARE(mounts[2].mountPoint, QStringLiteral("/"));
+    QCOMPARE(mounts[2].fsType, QStringLiteral("btrfs"));
+    QCOMPARE(mounts[2].source, QStringLiteral("/dev/nvme0n1p2"));
+    // \040 is a space; optional fields of any number before the "-"
+    QCOMPARE(mounts[6].mountPoint, QStringLiteral("/media/user/My Disk"));
+    QCOMPARE(mounts[6].major, 8u);
+    QCOMPARE(mounts[6].minor, 17u);
+
+    QCOMPARE(MountInfo::parse("garbage\n\n1 2 3\n").size(), 0);
+}
+
+// An LXC container on Android (Rungic): the root file system is an ext4
+// image behind device mapper (dm-7), the f2fs data partition (dm-53) is bind
+// mounted many times, /home among them; /dev, /run and the shared storage are
+// tmpfs and FUSE.
+void MountInfoTest::testContainer()
+{
+    const auto volumes = MountInfo::volumes(MountInfo::parse(fixture(QStringLiteral("mountinfo-container.txt"))), QStringLiteral("/home/user"));
+    QCOMPARE(volumes.size(), 2);
+
+    QCOMPARE(volumes[0].major, 254u);
+    QCOMPARE(volumes[0].minor, 7u);
+    QCOMPARE(volumes[0].mountPoint, QStringLiteral("/"));
+    QCOMPARE(volumes[0].fsType, QStringLiteral("ext4"));
+    QCOMPARE(volumes[0].source, QStringLiteral("/dev/block/dm-7"));
+    QVERIFY(!volumes[0].holdsHome);
+
+    QCOMPARE(volumes[1].major, 254u);
+    QCOMPARE(volumes[1].minor, 53u);
+    QCOMPARE(volumes[1].mountPoint, QStringLiteral("/home"));
+    QCOMPARE(volumes[1].fsType, QStringLiteral("f2fs"));
+    QVERIFY(volumes[1].holdsHome);
+}
+
+void MountInfoTest::testBtrfsDesktop()
+{
+    const auto volumes = MountInfo::volumes(MountInfo::parse(fixture(QStringLiteral("mountinfo-btrfs.txt"))), QStringLiteral("/home/user"));
+    QCOMPARE(volumes.size(), 3);
+    // Both subvolumes are one file system; "/" represents it and holds the
+    // home folder too, so no volume is marked as "Home".
+    QCOMPARE(volumes[0].mountPoint, QStringLiteral("/"));
+    QCOMPARE(volumes[0].minor, 35u);
+    QVERIFY(!volumes[0].holdsHome);
+    QCOMPARE(volumes[1].mountPoint, QStringLiteral("/boot/efi"));
+    QCOMPARE(volumes[2].mountPoint, QStringLiteral("/media/user/My Disk"));
+    QVERIFY(!volumes[1].holdsHome);
+    QVERIFY(!volumes[2].holdsHome);
+    // The snap's squashfs, tmpfs and the overlay are not listed.
+}
+
+void MountInfoTest::testEmpty()
+{
+    QVERIFY(MountInfo::volumes({}, QStringLiteral("/home/user")).isEmpty());
+}
+
+QTEST_GUILESS_MAIN(MountInfoTest)
+
+#include "mountinfo.moc"
