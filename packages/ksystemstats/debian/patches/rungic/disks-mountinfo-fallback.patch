+// Without udev or UDisks2 (in a container) Solid finds no storage volumes;
+// take the mounted file systems on block devices from the kernel instead.
+void DisksPlugin::addMountInfoVolumes()
+{
+#if defined Q_OS_LINUX
+    QFile mountinfo(QStringLiteral("/proc/self/mountinfo"));
+    if (!mountinfo.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    auto container = containers()[0];
+    const auto volumes = MountInfo::volumes(MountInfo::parse(mountinfo.readAll()), QDir::homePath());
+    for (const auto &volume : volumes) {
+        struct statvfs info;
+        if (statvfs(QFile::encodeName(volume.mountPoint).constData(), &info) != 0 || info.f_blocks == 0) {
+            continue;
+        }
+        const QString sysfs = QStringLiteral("/sys/dev/block/%1:%2").arg(volume.major).arg(volume.minor);
+        // The kernel's name, as /proc/diskstats lists the device.
+        QString kernelName = QFileInfo(volume.source).fileName();
+        QFile uevent(sysfs + QStringLiteral("/uevent"));
+        if (uevent.open(QIODevice::ReadOnly)) {
+            for (const QByteArray &line : uevent.readAll().split('\n')) {
+                if (line.startsWith("DEVNAME=")) {
+                    kernelName = QString::fromLocal8Bit(line.mid(8));
+                }
+            }
+        }
+        // A device-mapper name ("userdata") is stable across boots, dm-N is not.
+        QString id;
+        QFile dmName(sysfs + QStringLiteral("/dm/name"));
+        if (dmName.open(QIODevice::ReadOnly)) {
+            id = QString::fromLocal8Bit(dmName.readAll().trimmed());
+        }
+        if (id.isEmpty()) {
+            id = kernelName;
+        }
+        id.replace(QLatin1Char('/'), QLatin1Char('_'));
+        const QString device = QStringLiteral("/dev/") + kernelName;
+        if (id.isEmpty() || kernelName.isEmpty() || m_volumesByDevice.contains(device) || container->object(id)) {
+            continue;
+        }
+
+        QString name = volume.mountPoint;
+        if (volume.mountPoint == QLatin1String("/")) {
+            name = i18nc("@title the file system mounted at /", "System");
+        } else if (volume.holdsHome) {
+            name = i18nc("@title the file system holding the home folder", "Home");
+        }
+        m_volumesByDevice.insert(device, new VolumeObject(id, name, volume.mountPoint, quint64(info.f_blocks) * info.f_frsize, container));
+    }
+#endif
+}
