diff --git a/plugins/disks/MountInfo.cpp b/plugins/disks/MountInfo.cpp
new file mode 100644
index 0000000..8f215ef
--- /dev/null
+++ b/plugins/disks/MountInfo.cpp
@@ -0,0 +1,159 @@
+/*
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "MountInfo.h"
+
+#include <QHash>
+
+#include <algorithm>
+
+namespace MountInfo
+{
+static QString unescape(const QByteArray &field)
+{
+    QByteArray result;
+    result.reserve(field.size());
+    for (qsizetype i = 0; i < field.size(); ++i) {
+        if (field[i] == '\\' && i + 3 < field.size()) {
+            const QByteArray octal = field.mid(i + 1, 3);
+            bool ok = false;
+            const int value = octal.toInt(&ok, 8);
+            if (ok && octal.size() == 3 && value < 256) {
+                result.append(char(value));
+                i += 3;
+                continue;
+            }
+        }
+        result.append(field[i]);
+    }
+    return QString::fromLocal8Bit(result);
+}
+
+QList<Mount> parse(const QByteArray &mountinfo)
+{
+    QList<Mount> mounts;
+    const auto lines = mountinfo.split('\n');
+    for (const QByteArray &line : lines) {
+        // 36 35 98:0 /mnt1 /mnt2 rw,noatime master:1 - ext3 /dev/root rw,errors=continue
+        const auto fields = line.split(' ');
+        const qsizetype separator = fields.indexOf("-");
+        if (fields.size() < 6 || separator < 6 || separator + 2 >= fields.size()) {
+            continue;
+        }
+        const auto device = fields[2].split(':');
+        if (device.size() != 2) {
+            continue;
+        }
+        bool majorOk = false;
+        bool minorOk = false;
+        Mount mount;
+        mount.major = device[0].toUInt(&majorOk);
+        mount.minor = device[1].toUInt(&minorOk);
+        if (!majorOk || !minorOk) {
+            continue;
+        }
+        mount.root = unescape(fields[3]);
+        mount.mountPoint = unescape(fields[4]);
+        mount.fsType = unescape(fields[separator + 1]);
+        mount.source = unescape(fields[separator + 2]);
+        mounts.append(mount);
+    }
+    return mounts;
+}
+
+static bool contains(const QString &mountPoint, const QString &path)
+{
+    if (path.isEmpty()) {
+        return false;
+    }
+    if (mountPoint == QLatin1String("/")) {
+        return true;
+    }
+    return path == mountPoint || path.startsWith(mountPoint + QLatin1Char('/'));
+}
+
+QList<Volume> volumes(const QList<Mount> &mounts, const QString &homePath)
+{
+    static const QStringList readOnlyImages = {QStringLiteral("squashfs"), QStringLiteral("erofs"), QStringLiteral("iso9660")};
+
+    QList<quint64> order;
+    QHash<quint64, QList<Mount>> byDevice;
+    for (const Mount &mount : mounts) {
+        // btrfs mounts show the anonymous device of the file system (major 0).
+        const bool blockDevice = mount.major != 0 || (mount.fsType == QLatin1String("btrfs") && mount.source.startsWith(QLatin1String("/dev/")));
+        if (!blockDevice || readOnlyImages.contains(mount.fsType)) {
+            continue;
+        }
+        const quint64 key = (quint64(mount.major) << 32) | mount.minor;
+        if (!byDevice.contains(key)) {
+            order.append(key);
+        }
+        byDevice[key].append(mount);
+    }
+
+    // Lower is better.
+    auto rank = [&homePath](const Mount &mount) {
+        if (mount.mountPoint == QLatin1String("/")) {
+            return 0;
+        }
+        if (mount.root == QLatin1String("/")) {
+            return 1;
+        }
+        if (contains(mount.mountPoint, homePath)) {
+            return 2;
+        }
+        return 3;
+    };
+
+    QList<Volume> result;
+    for (const quint64 key : std::as_const(order)) {
+        const auto &candidates = byDevice[key];
+        const Mount best = *std::min_element(candidates.cbegin(), candidates.cend(), [&rank](const Mount &a, const Mount &b) {
+            const int rankA = rank(a);
+            const int rankB = rank(b);
+            if (rankA != rankB) {
+                return rankA < rankB;
+            }
+            if (a.mountPoint.size() != b.mountPoint.size()) {
+                return a.mountPoint.size() < b.mountPoint.size();
+            }
+            return a.mountPoint < b.mountPoint;
+        });
+        Volume volume;
+        volume.major = best.major;
+        volume.minor = best.minor;
+        volume.mountPoint = best.mountPoint;
+        volume.fsType = best.fsType;
+        volume.source = best.source;
+        result.append(volume);
+    }
+
+    // The home folder belongs to the device mounted deepest on its path.
+    Volume *home = nullptr;
+    qsizetype homeDepth = -1;
+    for (Volume &volume : result) {
+        for (const Mount &mount : std::as_const(byDevice[(quint64(volume.major) << 32) | volume.minor])) {
+            if (contains(mount.mountPoint, homePath) && mount.mountPoint.size() > homeDepth) {
+                home = &volume;
+                homeDepth = mount.mountPoint.size();
+            }
+        }
+    }
+    if (home && home->mountPoint != QLatin1String("/")) {
+        home->holdsHome = true;
+    }
+
+    std::stable_sort(result.begin(), result.end(), [](const Volume &a, const Volume &b) {
+        const bool rootA = a.mountPoint == QLatin1String("/");
+        const bool rootB = b.mountPoint == QLatin1String("/");
+        if (rootA != rootB) {
+            return rootA;
+        }
+        return a.mountPoint < b.mountPoint;
+    });
+    return result;
+}
+}
diff --git a/plugins/disks/MountInfo.h b/plugins/disks/MountInfo.h
new file mode 100644
index 0000000..a43ad13
--- /dev/null
+++ b/plugins/disks/MountInfo.h
@@ -0,0 +1,49 @@
+/*
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QByteArray>
+#include <QList>
+#include <QString>
+
+// The mounted file systems as the kernel lists them in /proc/self/mountinfo,
+// for systems where Solid sees no storage volumes (a container without
+// /dev nodes for the disks, udev or UDisks2).
+namespace MountInfo
+{
+struct Mount {
+    quint32 major = 0;
+    quint32 minor = 0;
+    QString root; // the directory of the file system mounted here ("/" for all of it)
+    QString mountPoint;
+    QString fsType;
+    QString source;
+};
+
+struct Volume {
+    quint32 major = 0;
+    quint32 minor = 0;
+    QString mountPoint; // where its size is asked for
+    QString fsType;
+    QString source;
+    bool holdsHome = false; // the home folder is on it (and it is not "/")
+};
+
+// One entry per line; lines that do not parse are skipped. Octal escapes
+// (\040 for a space) are decoded.
+QList<Mount> parse(const QByteArray &mountinfo);
+
+// The file systems on block devices, each device once even when it is
+// mounted (or bind mounted) at several places: pseudo file systems, tmpfs,
+// FUSE and overlays have no block device (major 0; btrfs, which shows an
+// anonymous major 0 device, counts when its source is a /dev path) and are
+// left out, as are read-only images (squashfs, erofs, iso9660). The mount point used for a
+// device is "/" if it is mounted there, else one where its whole file system
+// is mounted, else the one holding homePath, else the shortest. "/" comes
+// first, then by mount point.
+QList<Volume> volumes(const QList<Mount> &mounts, const QString &homePath);
+}
