diff --git a/plugins/gpu/KgslStats.cpp b/plugins/gpu/KgslStats.cpp
new file mode 100644
index 0000000..c0fabbf
--- /dev/null
+++ b/plugins/gpu/KgslStats.cpp
@@ -0,0 +1,114 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rungic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "KgslStats.h"
+
+#include <QRegularExpression>
+
+#include <algorithm>
+
+namespace Kgsl
+{
+QString modelName(const QByteArray &gpuModel)
+{
+    const QString model = QString::fromLatin1(gpuModel).trimmed();
+    static const QRegularExpression adreno(QStringLiteral("^Adreno(\\d+)v\\d+$"));
+    const auto match = adreno.match(model);
+    if (match.hasMatch()) {
+        return QStringLiteral("Adreno %1").arg(match.captured(1));
+    }
+    return model;
+}
+
+std::optional<quint64> unsignedValue(const QByteArray &input)
+{
+    const QByteArray number = input.trimmed();
+    if (number.isEmpty() || !std::all_of(number.cbegin(), number.cend(), [](char c) {
+            return c >= '0' && c <= '9';
+        })) {
+        return std::nullopt;
+    }
+    bool ok = false;
+    const quint64 value = number.toULongLong(&ok);
+    if (!ok) {
+        return std::nullopt;
+    }
+    return value;
+}
+
+std::optional<quint64> clockStatsBusyMicroseconds(const QByteArray &clockStats)
+{
+    const auto fields = clockStats.simplified().split(' ');
+    quint64 sum = 0;
+    int count = 0;
+    for (const QByteArray &field : fields) {
+        if (field.isEmpty()) {
+            continue;
+        }
+        const auto value = unsignedValue(field);
+        if (!value) {
+            return std::nullopt;
+        }
+        sum += *value;
+        count++;
+    }
+    if (count == 0) {
+        return std::nullopt;
+    }
+    return sum;
+}
+
+std::optional<double> gpubusyPercent(const QByteArray &gpubusy)
+{
+    const auto fields = gpubusy.simplified().split(' ');
+    if (fields.size() != 2) {
+        return std::nullopt;
+    }
+    const auto busy = unsignedValue(fields[0]);
+    const auto total = unsignedValue(fields[1]);
+    if (!busy || !total) {
+        return std::nullopt;
+    }
+    if (*total == 0) {
+        return 0.0;
+    }
+    return std::clamp(static_cast<double>(*busy) * 100.0 / static_cast<double>(*total), 0.0, 100.0);
+}
+
+QList<quint64> frequencies(const QByteArray &input)
+{
+    QList<quint64> result;
+    const auto fields = input.simplified().split(' ');
+    for (const QByteArray &field : fields) {
+        if (const auto value = unsignedValue(field)) {
+            result.append(*value);
+        }
+    }
+    return result;
+}
+
+std::optional<double> BusySampler::sample(quint64 busyMicroseconds, qint64 elapsedNanoseconds)
+{
+    if (!m_hasBaseline || busyMicroseconds < m_previous) {
+        m_previous = busyMicroseconds;
+        m_hasBaseline = true;
+        return std::nullopt;
+    }
+    const quint64 busy = busyMicroseconds - m_previous;
+    m_previous = busyMicroseconds;
+    if (elapsedNanoseconds <= 0) {
+        return std::nullopt;
+    }
+    const double percent = static_cast<double>(busy) * 1000.0 * 100.0 / static_cast<double>(elapsedNanoseconds);
+    return std::clamp(percent, 0.0, 100.0);
+}
+
+void BusySampler::reset()
+{
+    m_previous = 0;
+    m_hasBaseline = false;
+}
+}
diff --git a/plugins/gpu/KgslStats.h b/plugins/gpu/KgslStats.h
new file mode 100644
index 0000000..e641048
--- /dev/null
+++ b/plugins/gpu/KgslStats.h
@@ -0,0 +1,52 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rungic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QByteArray>
+#include <QList>
+#include <QString>
+
+#include <optional>
+
+// Parsing of the Qualcomm KGSL (msm_kgsl, downstream Adreno driver) sysfs
+// files under /sys/class/kgsl/kgsl-3d0. Kept free of I/O so it can be tested
+// with fixtures.
+namespace Kgsl
+{
+// "Adreno710v1" -> "Adreno 710"; anything else is returned trimmed as is.
+QString modelName(const QByteArray &gpuModel);
+
+// gpu_clock_stats: cumulative busy time in microseconds per power level,
+// separated by spaces. Returns the sum over all levels.
+std::optional<quint64> clockStatsBusyMicroseconds(const QByteArray &clockStats);
+
+// gpubusy: "<busy> <total>" of the last completed ~1 s window of powered
+// time. Returns the busy percentage of that window (0 when total is 0).
+std::optional<double> gpubusyPercent(const QByteArray &gpubusy);
+
+// A single unsigned integer, as in devfreq/cur_freq or temp.
+std::optional<quint64> unsignedValue(const QByteArray &input);
+
+// devfreq/available_frequencies: frequencies in Hz separated by spaces.
+QList<quint64> frequencies(const QByteArray &input);
+
+// Turns a monotonic busy-time counter into a usage percentage over the
+// elapsed wall time between two samples.
+class BusySampler
+{
+public:
+    // The first sample after construction or reset() only sets the baseline
+    // and returns nothing. A counter that went backwards also restarts the
+    // baseline.
+    std::optional<double> sample(quint64 busyMicroseconds, qint64 elapsedNanoseconds);
+    void reset();
+
+private:
+    quint64 m_previous = 0;
+    bool m_hasBaseline = false;
+};
+}
diff --git a/plugins/gpu/LinuxBackend.cpp b/plugins/gpu/LinuxBackend.cpp
index ee6104d..c91fe8d 100644
--- a/plugins/gpu/LinuxBackend.cpp
+++ b/plugins/gpu/LinuxBackend.cpp
@@ -10,8 +10,11 @@
 
 #include <libudev.h>
 
+#include <algorithm>
+
 #include "LinuxAmdGpu.h"
 #include "LinuxIntelGpu.h"
+#include "LinuxKgslGpu.h"
 #include "LinuxNvidiaGpu.h"
 #include "debug.h"
 
@@ -74,6 +77,22 @@ void LinuxBackend::start()
     }
 
     udev_enumerate_unref(enumerate);
+
+    // Qualcomm Adreno on Android kernels: the downstream KGSL driver has no DRM
+    // device, only /dev/kgsl-3d0 and its sysfs class directory.
+    const QString kgslPath = QStringLiteral("/sys/class/kgsl/kgsl-3d0");
+    if (LinuxKgslGpu::isPresent(kgslPath)) {
+        int number = 0;
+        while (std::any_of(m_devices.cbegin(), m_devices.cend(), [number](GpuDevice *device) {
+            return device->id() == QStringLiteral("gpu%1").arg(number);
+        })) {
+            number++;
+        }
+        auto gpu = new LinuxKgslGpu{QStringLiteral("gpu%1").arg(number), i18nc("@title %1 is GPU number", "GPU %1", number + 1), kgslPath};
+        gpu->initialize();
+        m_devices.append(gpu);
+        Q_EMIT deviceAdded(gpu);
+    }
 }
 
 void LinuxBackend::stop()
diff --git a/plugins/gpu/LinuxKgslGpu.cpp b/plugins/gpu/LinuxKgslGpu.cpp
new file mode 100644
index 0000000..b26d89c
--- /dev/null
+++ b/plugins/gpu/LinuxKgslGpu.cpp
@@ -0,0 +1,123 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rungic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "LinuxKgslGpu.h"
+
+#include <QFile>
+
+#include <algorithm>
+
+#include <systemstats/SensorProperty.h>
+
+LinuxKgslGpu::LinuxKgslGpu(const QString &id, const QString &name, const QString &sysfsPath)
+    : GpuDevice(id, name)
+    , m_path(sysfsPath)
+{
+}
+
+bool LinuxKgslGpu::isPresent(const QString &sysfsPath)
+{
+    QFile model(sysfsPath + QStringLiteral("/gpu_model"));
+    return model.open(QIODevice::ReadOnly) && !model.readAll().trimmed().isEmpty();
+}
+
+QByteArray LinuxKgslGpu::read(const QString &relativePath) const
+{
+    QFile file(m_path + QLatin1Char('/') + relativePath);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    // sysfs files are at most a page; QFile::readAll() on them may stop early.
+    return file.read(4096);
+}
+
+void LinuxKgslGpu::initialize()
+{
+    GpuDevice::initialize();
+
+    m_nameProperty->setValue(Kgsl::modelName(read(QStringLiteral("gpu_model"))));
+
+    // The range of the hardware; devfreq/min_freq and max_freq are the
+    // current policy and can change at run time.
+    auto frequencies = Kgsl::frequencies(read(QStringLiteral("devfreq/available_frequencies")));
+    if (frequencies.isEmpty()) {
+        for (const QString &file : {QStringLiteral("devfreq/min_freq"), QStringLiteral("devfreq/max_freq")}) {
+            if (const auto value = Kgsl::unsignedValue(read(file))) {
+                frequencies.append(*value);
+            }
+        }
+    }
+    if (!frequencies.isEmpty()) {
+        const auto [min, max] = std::minmax_element(frequencies.cbegin(), frequencies.cend());
+        m_coreFrequencyProperty->setMin(*min / 1'000'000.0);
+        m_coreFrequencyProperty->setMax(*max / 1'000'000.0);
+    }
+
+    m_usageProperty->setValue(0.0);
+    connect(m_usageProperty, &KSysGuard::SensorProperty::subscribedChanged, this, [this](bool subscribed) {
+        if (subscribed) {
+            restartUsage();
+        }
+    });
+}
+
+void LinuxKgslGpu::restartUsage()
+{
+    m_sampler.reset();
+    if (m_clockStatsReadable) {
+        if (const auto busy = Kgsl::clockStatsBusyMicroseconds(read(QStringLiteral("gpu_clock_stats")))) {
+            m_sampler.sample(*busy, 0);
+        } else {
+            m_clockStatsReadable = false;
+        }
+    }
+    m_usageTimer.start();
+}
+
+void LinuxKgslGpu::updateUsage()
+{
+    if (m_clockStatsReadable) {
+        // Cumulative busy microseconds per power level; reading it makes the
+        // driver add the hardware counters accumulated so far.
+        const auto busy = Kgsl::clockStatsBusyMicroseconds(read(QStringLiteral("gpu_clock_stats")));
+        const qint64 elapsed = m_usageTimer.nsecsElapsed();
+        m_usageTimer.restart();
+        if (busy) {
+            if (const auto percent = m_sampler.sample(*busy, elapsed)) {
+                m_usageProperty->setValue(*percent);
+            }
+            return;
+        }
+        m_clockStatsReadable = false;
+    }
+    // The last ~1 s window of powered time; the driver clears it when the GPU
+    // is off, so an idle GPU reads 0. (Never devfreq/gpu_load: reading it
+    // resets the governor's own statistics.)
+    if (const auto percent = Kgsl::gpubusyPercent(read(QStringLiteral("gpubusy")))) {
+        m_usageProperty->setValue(*percent);
+    }
+}
+
+void LinuxKgslGpu::update()
+{
+    if (m_usageProperty->isSubscribed()) {
+        updateUsage();
+    }
+    if (m_coreFrequencyProperty->isSubscribed()) {
+        if (const auto hertz = Kgsl::unsignedValue(read(QStringLiteral("devfreq/cur_freq")))) {
+            m_coreFrequencyProperty->setValue(*hertz / 1'000'000.0);
+        }
+    }
+    if (m_temperatureProperty->isSubscribed()) {
+        // Millidegrees, the hottest of the GPU's thermal zones; 0 without any.
+        const auto milli = Kgsl::unsignedValue(read(QStringLiteral("temp")));
+        if (milli && *milli > 0) {
+            m_temperatureProperty->setValue(*milli / 1000.0);
+        }
+    }
+}
+
+#include "moc_LinuxKgslGpu.cpp"
diff --git a/plugins/gpu/LinuxKgslGpu.h b/plugins/gpu/LinuxKgslGpu.h
new file mode 100644
index 0000000..d575309
--- /dev/null
+++ b/plugins/gpu/LinuxKgslGpu.h
@@ -0,0 +1,40 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Rungic
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include "GpuDevice.h"
+#include "KgslStats.h"
+
+#include <QElapsedTimer>
+
+// A Qualcomm Adreno GPU driven by the downstream KGSL driver (Android kernels:
+// /dev/kgsl-3d0, no DRM render node). Everything comes from sysfs:
+// /sys/class/kgsl/kgsl-3d0/{gpu_model,gpu_clock_stats,gpubusy,temp} and its
+// devfreq directory. The memory is shared with the CPU, so the video memory
+// and memory frequency sensors stay empty; the driver reports no power.
+class LinuxKgslGpu : public GpuDevice
+{
+    Q_OBJECT
+
+public:
+    LinuxKgslGpu(const QString &id, const QString &name, const QString &sysfsPath);
+
+    static bool isPresent(const QString &sysfsPath);
+
+    void initialize() override;
+    void update() override;
+
+private:
+    QByteArray read(const QString &relativePath) const;
+    void restartUsage();
+    void updateUsage();
+
+    QString m_path;
+    Kgsl::BusySampler m_sampler;
+    QElapsedTimer m_usageTimer;
+    bool m_clockStatsReadable = true;
+};
