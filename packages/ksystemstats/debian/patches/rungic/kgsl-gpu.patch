diff --git a/plugins/gpu/autotests/kgsl.cpp b/plugins/gpu/autotests/kgsl.cpp
new file mode 100644
index 0000000..bb20038
--- /dev/null
+++ b/plugins/gpu/autotests/kgsl.cpp
@@ -0,0 +1,193 @@
+/*
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include <QDir>
+#include <QFile>
+#include <QTemporaryDir>
+#include <QTest>
+
+#include <systemstats/SensorProperty.h>
+
+#include "../KgslStats.h"
+#include "../LinuxKgslGpu.h"
+
+// Values read from /sys/class/kgsl/kgsl-3d0 of an Adreno 710 (Motorola
+// XT2537, Android 16, gfx-kernel.lnx.15.0) on 2026-10-03.
+static const QByteArray adreno710ClockStats = "7603584471 3417620194 884482783 2648244955 11343366934 3267221696 21997648518 \n";
+static const QByteArray adreno710Frequencies = "816000000 734000000 650000000 600000000 500000000 345000000 295000000\n";
+
+class KgslTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void testModelName_data();
+    void testModelName();
+    void testClockStats();
+    void testGpubusy_data();
+    void testGpubusy();
+    void testFrequencies();
+    void testSampler();
+    void testDevice();
+    void testDeviceGpubusyFallback();
+};
+
+void KgslTest::testModelName_data()
+{
+    QTest::addColumn<QByteArray>("input");
+    QTest::addColumn<QString>("expected");
+    QTest::newRow("adreno710") << QByteArray("Adreno710v1\n") << QStringLiteral("Adreno 710");
+    QTest::newRow("adreno740v2") << QByteArray("Adreno740v2") << QStringLiteral("Adreno 740");
+    QTest::newRow("other") << QByteArray(" Something 9 \n") << QStringLiteral("Something 9");
+    QTest::newRow("empty") << QByteArray("") << QString();
+}
+
+void KgslTest::testModelName()
+{
+    QFETCH(QByteArray, input);
+    QFETCH(QString, expected);
+    QCOMPARE(Kgsl::modelName(input), expected);
+}
+
+void KgslTest::testClockStats()
+{
+    QCOMPARE(Kgsl::clockStatsBusyMicroseconds(adreno710ClockStats),
+             std::optional<quint64>(7603584471ULL + 3417620194ULL + 884482783ULL + 2648244955ULL + 11343366934ULL + 3267221696ULL + 21997648518ULL));
+    QCOMPARE(Kgsl::clockStatsBusyMicroseconds("0 0 0\n"), std::optional<quint64>(0));
+    QCOMPARE(Kgsl::clockStatsBusyMicroseconds(""), std::nullopt);
+    QCOMPARE(Kgsl::clockStatsBusyMicroseconds("12 x 3"), std::nullopt);
+}
+
+void KgslTest::testGpubusy_data()
+{
+    QTest::addColumn<QByteArray>("input");
+    QTest::addColumn<double>("expected");
+    QTest::addColumn<bool>("valid");
+    // The driver prints "%7d %7d\n"
+    QTest::newRow("busy") << QByteArray(" 938819 1008623\n") << 938819.0 * 100.0 / 1008623.0 << true;
+    QTest::newRow("off") << QByteArray("      0       0\n") << 0.0 << true;
+    QTest::newRow("garbage") << QByteArray("n/a") << 0.0 << false;
+}
+
+void KgslTest::testGpubusy()
+{
+    QFETCH(QByteArray, input);
+    QFETCH(double, expected);
+    QFETCH(bool, valid);
+    const auto result = Kgsl::gpubusyPercent(input);
+    QCOMPARE(result.has_value(), valid);
+    if (valid) {
+        QCOMPARE(*result, expected);
+    }
+}
+
+void KgslTest::testFrequencies()
+{
+    const auto frequencies = Kgsl::frequencies(adreno710Frequencies);
+    QCOMPARE(frequencies.size(), 7);
+    QCOMPARE(frequencies.first(), 816000000ULL);
+    QCOMPARE(frequencies.last(), 295000000ULL);
+    QCOMPARE(Kgsl::unsignedValue("345000000\n"), std::optional<quint64>(345000000));
+    QCOMPARE(Kgsl::unsignedValue("-5\n"), std::nullopt);
+}
+
+void KgslTest::testSampler()
+{
+    Kgsl::BusySampler sampler;
+    QCOMPARE(sampler.sample(1000, 0), std::nullopt); // baseline
+    // 250 ms busy in 500 ms
+    QCOMPARE(sampler.sample(251000, 500'000'000), std::optional<double>(50.0));
+    // nothing busy
+    QCOMPARE(sampler.sample(251000, 500'000'000), std::optional<double>(0.0));
+    // more busy time than elapsed time (timer jitter) is clamped
+    QCOMPARE(sampler.sample(851000, 500'000'000), std::optional<double>(100.0));
+    // a counter that went backwards restarts the baseline
+    QCOMPARE(sampler.sample(10, 500'000'000), std::nullopt);
+    QCOMPARE(sampler.sample(5010, 10'000'000), std::optional<double>(50.0));
+    sampler.reset();
+    QCOMPARE(sampler.sample(9000, 500'000'000), std::nullopt);
+}
+
+static void writeFile(const QString &path, const QByteArray &contents)
+{
+    QDir().mkpath(QFileInfo(path).path());
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::WriteOnly | QIODevice::Truncate));
+    file.write(contents);
+}
+
+static void makeSysfs(const QString &root)
+{
+    writeFile(root + QStringLiteral("/gpu_model"), "Adreno710v1\n");
+    writeFile(root + QStringLiteral("/gpubusy"), "  50000  100000\n");
+    writeFile(root + QStringLiteral("/temp"), "34600\n");
+    writeFile(root + QStringLiteral("/devfreq/available_frequencies"), adreno710Frequencies);
+    writeFile(root + QStringLiteral("/devfreq/cur_freq"), "345000000\n");
+}
+
+void KgslTest::testDevice()
+{
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString root = dir.path();
+    QVERIFY(!LinuxKgslGpu::isPresent(root));
+    makeSysfs(root);
+    writeFile(root + QStringLiteral("/gpu_clock_stats"), "1000 0 0\n");
+    QVERIFY(LinuxKgslGpu::isPresent(root));
+
+    LinuxKgslGpu gpu(QStringLiteral("gpu0"), QStringLiteral("GPU 1"), root);
+    gpu.initialize();
+
+    QCOMPARE(gpu.sensor(QStringLiteral("name"))->value().toString(), QStringLiteral("Adreno 710"));
+    auto frequency = gpu.sensor(QStringLiteral("coreFrequency"));
+    QCOMPARE(frequency->info().min, 295.0);
+    QCOMPARE(frequency->info().max, 816.0);
+
+    // Unsubscribed sensors are not read.
+    gpu.update();
+    QCOMPARE(frequency->value().toDouble(), 0.0);
+    QCOMPARE(gpu.sensor(QStringLiteral("temperature"))->value().toDouble(), 0.0);
+
+    frequency->subscribe();
+    gpu.sensor(QStringLiteral("temperature"))->subscribe();
+    gpu.update();
+    QCOMPARE(frequency->value().toDouble(), 345.0);
+    QCOMPARE(gpu.sensor(QStringLiteral("temperature"))->value().toDouble(), 34.6);
+
+    // Usage: the baseline is taken on subscription, the next update gives
+    // the busy share of the elapsed time.
+    auto usage = gpu.sensor(QStringLiteral("usage"));
+    usage->subscribe();
+    QTest::qWait(200);
+    writeFile(root + QStringLiteral("/gpu_clock_stats"), "1000 0 200000000\n"); // far more than elapsed
+    gpu.update();
+    QCOMPARE(usage->value().toDouble(), 100.0);
+    QTest::qWait(200);
+    gpu.update(); // unchanged counter: idle
+    QCOMPARE(usage->value().toDouble(), 0.0);
+
+    // The memory is unified: no video memory figures are made up.
+    QVERIFY(!gpu.sensor(QStringLiteral("totalVram"))->value().isValid() || gpu.sensor(QStringLiteral("totalVram"))->value().toLongLong() == 0);
+    QVERIFY(!gpu.sensor(QStringLiteral("usedVram"))->value().isValid() || gpu.sensor(QStringLiteral("usedVram"))->value().toLongLong() == 0);
+}
+
+void KgslTest::testDeviceGpubusyFallback()
+{
+    QTemporaryDir dir;
+    QVERIFY(dir.isValid());
+    const QString root = dir.path();
+    makeSysfs(root); // without gpu_clock_stats
+
+    LinuxKgslGpu gpu(QStringLiteral("gpu0"), QStringLiteral("GPU 1"), root);
+    gpu.initialize();
+    auto usage = gpu.sensor(QStringLiteral("usage"));
+    usage->subscribe();
+    gpu.update();
+    QCOMPARE(usage->value().toDouble(), 50.0);
+}
+
+QTEST_GUILESS_MAIN(KgslTest)
