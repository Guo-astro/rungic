From: kevinzhow <kevinzhow@local>
Date: Wed, 23 Sep 2026 21:00:53 +0800
Subject: Android host: cellular,
 Bluetooth and power settings open the Android settings

On the Android host the phone's radios and suspend belong to Android. When the host's platform
socket exists, the cellular, Bluetooth and power modules hand over to the project's platform helper,
which opens the matching Android settings page; other sessions keep the desktop modules. Wi-Fi and
network use the desktop modules: NetworkManager is backed by Android (docs/73).

Forwarded: not-needed
Last-Update: 2026-09-27
X-Rungic-Status: Inappropriate [Android host specific: hands the hardware settings to Android]
X-Rungic-Tests: none (gap: no scenario opens these modules)
X-Rungic-Docs: docs/42 docs/73
---
 src/settingsapp.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/settingsapp.cpp b/src/settingsapp.cpp
index 2c398ad..3267927 100644
--- a/src/settingsapp.cpp
+++ b/src/settingsapp.cpp
@@ -9,6 +9,8 @@
 #include "settingsapp.h"
 
 #include <QDebug>
+#include <QFileInfo>
+#include <QProcess>
 #include <QQmlContext>
 #include <QQmlEngine>
 
@@ -257,6 +259,29 @@ void SettingsApp::loadModule(const QModelIndex &activeModule, const QStringList
         return;
     }
 
+    // Physical network/radio/suspend ownership stays with the Android host.
+    // The normal desktop modules remain available on non-Android sessions.
+    if (QFileInfo::exists(QStringLiteral("/mnt/android-wayland/platform.sock"))) {
+        const QString id = QFileInfo(mi->id()).baseName();
+        QString target;
+        // Wi-Fi and network settings are the desktop modules: the NetworkManager service is backed by
+        // Android (shared/platform/network-manager.py, docs/73).
+        if (id == u"kcm_cellular_network"_s) {
+            target = u"network"_s;
+        } else if (id == u"kcm_bluetooth"_s || id == u"kcm_mobile_bluetooth"_s || id == u"kcm_bluetooth_power"_s) {
+            target = u"bluetooth"_s;
+        }
+        if (!target.isEmpty()) {
+            QProcess::startDetached(u"/usr/bin/rungic-platform"_s,
+                {u"--request"_s, u"{\"op\":\"settings\",\"target\":\""_s + target + u"\"}"_s});
+            return;
+        }
+        if (id == u"kcm_mobile_power"_s || id == u"kcm_powerdevilprofilesconfig"_s) {
+            QProcess::startDetached(u"/usr/bin/rungic-platform"_s, {});
+            return;
+        }
+    }
+
     // Load KCM
     m_activeModule->setPath(mi->id());
 }
