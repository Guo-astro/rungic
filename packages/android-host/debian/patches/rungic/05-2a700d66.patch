---
 src/android/backend/wayland/input_router.rs | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/android/backend/wayland/input_router.rs b/src/android/backend/wayland/input_router.rs
index 63caab3..2976d7c 100644
--- a/src/android/backend/wayland/input_router.rs
+++ b/src/android/backend/wayland/input_router.rs
@@ -152,7 +152,7 @@ impl AndroidSeatRuntime {
                 if let Some(old_window) = self.wl_to_window.get(old_surface) {
                     old_window.set_activated(false);
                     if let Some(toplevel) = old_window.toplevel() {
-                        toplevel.send_configure();
+                        toplevel.send_pending_configure();
                     }
                 }
             }
@@ -162,8 +162,11 @@ impl AndroidSeatRuntime {
 
         if let Some(window) = self.wl_to_window.get(&target) {
             window.set_activated(true);
+            // Every touch-down refocuses; only a real state change may configure,
+            // otherwise KWin reapplies its output configuration (and rescans cursor
+            // themes) on each touch (docs/57).
             if let Some(toplevel) = window.toplevel() {
-                toplevel.send_configure();
+                toplevel.send_pending_configure();
             }
         }
 
