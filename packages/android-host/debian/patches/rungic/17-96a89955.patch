+// EGL fallback has its own real display timestamp. eglSwapBuffers success is
+// only submission and must not release the startup gate.
+type NextFrame = unsafe extern "C" fn(egl::EGLDisplay, egl::EGLSurface, *mut u64) -> u32;
+type FrameTimes = unsafe extern "C" fn(egl::EGLDisplay, egl::EGLSurface, u64, i32, *const i32, *mut i64) -> u32;
+type SupportsTime = unsafe extern "C" fn(egl::EGLDisplay, egl::EGLSurface, i32) -> u32;
+const DISPLAY_PRESENT: i32 = 0x343A;
+unsafe fn next_startup_egl_frame(display: egl::EGLDisplay, surface: egl::EGLSurface) -> Option<u64> {
+    let next = eglGetProcAddress(c"eglGetNextFrameIdANDROID".as_ptr());
+    let supported = eglGetProcAddress(c"eglGetFrameTimestampSupportedANDROID".as_ptr());
+    if next.is_null() || supported.is_null() { return None; }
+    let supported: SupportsTime = std::mem::transmute(supported);
+    if supported(display, surface, DISPLAY_PRESENT) == 0 || eglSurfaceAttrib(display, surface, 0x3430, 1) == 0 { return None; }
+    let next: NextFrame = std::mem::transmute(next);
+    let mut id = 0;
+    (next(display, surface, &mut id) != 0).then_some(id)
+}
+pub fn collect_startup_egl_frames(state: &mut AndroidSmithayState) {
+    if state.startup_egl_frames.is_empty() { return; }
+    let ticket = crate::android::frame_clock::phone_proof();
+    let (Some(display), Some(surface)) = (state.egl_display, state.egl_surface) else {
+        state.startup_egl_frames.clear(); return;
+    };
+    unsafe {
+        let query = eglGetProcAddress(c"eglGetFrameTimestampsANDROID".as_ptr());
+        if query.is_null() { state.startup_egl_frames.clear(); return; }
+        let query: FrameTimes = std::mem::transmute(query);
+        state.startup_egl_frames.retain(|(frame_surface, id, frame_ticket)| {
+            if *frame_ticket != ticket || ticket == 0 || *frame_surface != surface { return false; }
+            let mut value: i64 = -1;
+            if query(display, surface, *id, 1, &DISPLAY_PRESENT, &mut value) == 0 { return false; }
+            if value > 0 { crate::android::frame_clock::confirm_phone_proof(ticket); }
+            value == -2 // only genuinely pending timestamps remain
+        });
+    }
+}
