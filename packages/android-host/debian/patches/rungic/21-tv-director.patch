+/// The TV's director layout (cast.rs): `slots[i]` in the rectangle `rects[4i..4i+4]` (x, y,
+/// width, height as fractions of the TV), `focus` the presented one; no slots: one source.
+#[no_mangle]
+pub extern "system" fn Java_com_winland_server_NativeBridge_setDirector(
+    env: JNIEnv,
+    _class: JClass,
+    slots: jni::objects::JIntArray,
+    rects: jni::objects::JFloatArray,
+    focus: jni::sys::jint,
+) {
+    let count = env.get_array_length(&slots).unwrap_or(0).max(0) as usize;
+    let mut slot_values = vec![0i32; count];
+    let mut rect_values = vec![0f32; count * 4];
+    if count > 0 && (env.get_int_array_region(&slots, 0, &mut slot_values).is_err()
+        || env.get_float_array_region(&rects, 0, &mut rect_values).is_err()) {
+        return;
+    }
+    let tiles = slot_values.iter().enumerate()
+        .map(|(i, slot)| (*slot, [rect_values[4 * i], rect_values[4 * i + 1], rect_values[4 * i + 2], rect_values[4 * i + 3]]))
+        .collect();
+    crate::android::command_channel::send_command(crate::android::command_channel::JniCommand::SetDirector { tiles, focus });
+}
+
+/// Move the director's tile of `slot` to (x, y, width, height) as fractions, without a new frame.
+#[no_mangle]
+pub extern "system" fn Java_com_winland_server_NativeBridge_placeTile(
