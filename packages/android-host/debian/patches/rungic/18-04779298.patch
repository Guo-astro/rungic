     pub(crate) fn clear_input_state(&mut self) {
+        // Touches still down are cancelled for the clients too: the lift that follows is dropped
+        // while rendering is suspended, and a client (the navigation panel's Home button held for
+        // the voice assistant) kept the press forever (docs/49).
+        if !self.active_touch_ids.is_empty() {
+            let t = self.touch.clone();
+            t.cancel(self);
+            t.frame(self);
+        }
         self.active_touch_ids.clear();
         self.swipe_starts.clear();
         self.swipe_cycle_armed = false;
