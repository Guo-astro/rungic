+// ── Output pacing (docs/65) ─────────────────────────────────────────────────
+
+/// Per-output render state. The phone and the cast window (TV or the assistant's screen)
+/// are rendered apart: a frame of one does not re-present the other, and an output that
+/// nobody sees gets its frame callbacks at most once per interval.
+#[cfg(feature = "smithay_android")]
+#[derive(Debug)]
+pub(crate) struct OutputPacing {
+    pub phone_interval: Option<std::time::Duration>,
+    pub cast_interval: Option<std::time::Duration>,
+    phone_commits_seen: u64,
+    cast_commits_seen: u64,
+    /// A change held back by the interval (or a render list the consumer dropped).
+    phone_deferred: bool,
+    cast_deferred: bool,
+    last_phone_frame: Option<std::time::Instant>,
+    last_cast_frame: Option<std::time::Instant>,
+    /// When a held-back output is due; the loop wakes for it.
+    pub due: Option<std::time::Instant>,
+    /// The cast window's frame callbacks went out this round: report its presentation.
+    pub cast_released: bool,
+    /// Phone frames rendered and cast turns taken (diagnostics: native-stats).
+    pub phone_frames: u64,
+    pub cast_turns: u64,
+}
+
+#[cfg(feature = "smithay_android")]
+impl Default for OutputPacing {
+    fn default() -> Self {
+        Self {
+            phone_interval: None,
+            cast_interval: None,
+            phone_commits_seen: engine_timing::phone_commit_count(),
+            cast_commits_seen: engine_timing::cast_commit_count(),
+            phone_deferred: true,
+            cast_deferred: false,
+            last_phone_frame: None,
+            last_cast_frame: None,
+            due: None,
+            cast_released: false,
+            phone_frames: 0,
+            cast_turns: 0,
+        }
+    }
+}
+
+#[cfg(feature = "smithay_android")]
+impl OutputPacing {
+    /// Whether an output with `pending` work renders now; else note when it is due.
+    fn take_turn(pending: bool, interval: Option<std::time::Duration>, last: &mut Option<std::time::Instant>,
+                 deferred: &mut bool, due: &mut Option<std::time::Instant>, now: std::time::Instant) -> bool {
+        if !pending {
+            return false;
+        }
+        if let (Some(interval), Some(last)) = (interval, *last) {
+            if now < last + interval {
+                *deferred = true;
+                let at = last + interval;
+                *due = Some(due.map_or(at, |d| d.min(at)));
+                return false;
+            }
+        }
+        *deferred = false;
+        *last = Some(now);
+        true
+    }
+
+    pub fn stats(&self) -> String {
+        let ms = |i: Option<std::time::Duration>| i.map_or("-".to_string(), |d| format!("{}ms", d.as_millis()));
+        format!("pacing(phone={} cast={} phone_frames={} cast_turns={} deferred={}/{} commits={}/{})", ms(self.phone_interval),
+            ms(self.cast_interval), self.phone_frames, self.cast_turns, self.phone_deferred, self.cast_deferred,
+            engine_timing::phone_commit_count(), engine_timing::cast_commit_count())
+    }
+}
