+// Output pacing (docs/65). An output nobody sees is still rendered, at a low rate: its
+// windows get frame callbacks, so KWin and the apps on it draw that often. Stopping it
+// would save little more (measured: 1 fps is within a few % of a core of stopped) and
+// would leave the agent's screen stale for its own screenshots.
+
+/// The phone's picture while the assistant's screen is fullscreen above it.
+#[cfg(feature = "smithay_android")]
+pub const COVERED_PHONE_INTERVAL: std::time::Duration = std::time::Duration::from_millis(1000);
+/// The assistant's screen while no one looks at it: no TV or fullscreen presenter, and its
+/// floating window tucked into the edge or the phone's picture gone.
+#[cfg(feature = "smithay_android")]
+pub const UNWATCHED_CAST_INTERVAL: std::time::Duration = std::time::Duration::from_millis(200);
+
+#[cfg(feature = "smithay_android")]
+static PHONE_COVERED: AtomicBool = AtomicBool::new(false);
+#[cfg(feature = "smithay_android")]
+static AGENT_SCREEN_WATCHED: AtomicBool = AtomicBool::new(true);
+
+/// The assistant's screen is fullscreen on the phone, above the phone's own picture
+/// (NativeBridge.setPhoneCovered). Rendering, input and the EGL surface stay as they are.
+#[cfg(feature = "smithay_android")]
+pub fn set_phone_covered(covered: bool) {
+    if PHONE_COVERED.swap(covered, Ordering::Relaxed) != covered {
+        log::info!("SmithayRuntime: phone_covered = {}", covered);
+    }
+}
+
+#[cfg(feature = "smithay_android")]
+pub fn is_phone_covered() -> bool {
+    PHONE_COVERED.load(Ordering::Relaxed)
+}
+
+/// Whether the assistant's floating window shows its picture (false: tucked into the edge;
+/// NativeBridge.setAgentScreenWatched).
+#[cfg(feature = "smithay_android")]
+pub fn set_agent_screen_watched(watched: bool) {
+    if AGENT_SCREEN_WATCHED.swap(watched, Ordering::Relaxed) != watched {
+        log::info!("SmithayRuntime: agent_screen_watched = {}", watched);
+    }
+}
+
+#[cfg(feature = "smithay_android")]
+pub fn agent_screen_watched() -> bool {
+    AGENT_SCREEN_WATCHED.load(Ordering::Relaxed)
+}
+
+/// Whether anyone sees the phone's picture: the surface is there and not covered.
+#[cfg(feature = "smithay_android")]
+pub fn phone_visible() -> bool {
+    is_rendering_active() && !is_phone_covered()
+}
