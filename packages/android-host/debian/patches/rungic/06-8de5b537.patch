+/// The SurfaceView window on the cast display and its zero-copy layer.
+#[derive(Debug)]
+pub(crate) struct CastWindow {
+    window: *mut ndk_sys::ANativeWindow,
+    pub presenter: crate::android::surface_control::Presenter,
+    pub size: (i32, i32),
+    pub frames: u64,
+}
+
+impl Drop for CastWindow {
+    fn drop(&mut self) {
+        self.presenter.hide();
+        unsafe { ndk_sys::ANativeWindow_release(self.window) };
+    }
+}
+
+/// Take ownership of the cast display's window (acquired by ANativeWindow_fromSurface).
+pub fn bind_cast_window(state: &mut AndroidSmithayState, window: *mut ndk_sys::ANativeWindow, size: (i32, i32)) -> bool {
+    state.cast = None;
+    if window.is_null() || size.0 <= 0 || size.1 <= 0 {
+        return false;
+    }
+    unsafe {
+        // SurfaceFlinger crops the zero-copy child layer to its parent's buffer, so
+        // the SurfaceView needs one frame of the full size first (cf. the rotation fix).
+        ndk_sys::ANativeWindow_setBuffersGeometry(window, size.0, size.1, 1 /* RGBA_8888 */);
+        let mut buffer: ndk_sys::ANativeWindow_Buffer = std::mem::zeroed();
+        if ndk_sys::ANativeWindow_lock(window, &mut buffer, std::ptr::null_mut()) == 0 {
+            let rows = buffer.height.max(0) as usize;
+            let bytes = buffer.stride.max(0) as usize * 4;
+            std::ptr::write_bytes(buffer.bits as *mut u8, 0, rows * bytes);
+            // Opaque black: alpha bytes to 255.
+            let pixels = std::slice::from_raw_parts_mut(buffer.bits as *mut u32, rows * buffer.stride.max(0) as usize);
+            pixels.fill(0xff00_0000);
+            ndk_sys::ANativeWindow_unlockAndPost(window);
+        }
+    }
+    match crate::android::surface_control::Presenter::new(window) {
+        Some(presenter) => {
+            log::info!("cast: window bound {}x{}", size.0, size.1);
+            state.cast = Some(CastWindow { window, presenter, size, frames: 0 });
+            true
+        }
+        None => {
+            unsafe { ndk_sys::ANativeWindow_release(window) };
+            false
+        }
+    }
+}
+
+pub fn release_cast_window(state: &mut AndroidSmithayState) {
+    if state.cast.take().is_some() {
+        log::info!("cast: window released");
+    }
+}
+
+/// Hand the cast window's buffer (a leased AHardwareBuffer from KWin) to SurfaceFlinger.
+pub fn present_cast(state: &mut AndroidSmithayState, mut item: RenderItem) -> bool {
+    let Some(cast) = state.cast.as_mut() else { return false };
+    let RenderItem::DmaBuf { ref fd, fourcc, width, height, ref mut hold, ref acquire, ref mut release, .. } = item else {
+        return false;
+    };
+    let Some(ahb) = crate::android::gpu_allocator::lookup(fd.as_raw_fd(), width, height, fourcc) else {
+        return false;
+    };
+    let Some(hold) = hold.take() else { return false };
+    let acquire_fd = acquire.as_ref().and_then(|fence| fence.try_clone().ok());
+    cast.presenter.present(ahb, hold, release.take(), acquire_fd, (width, height), cast.size);
+    cast.frames += 1;
+    true
+}
