+/// Cast display window (docs/58): the Surface of a SurfaceView on the Wi-Fi
+/// Display, in pixels, with the display's refresh rate.
+#[no_mangle]
+pub unsafe extern "system" fn Java_com_winland_server_NativeBridge_bindCastSurface(
+    env: JNIEnv,
+    _class: JClass,
+    surface: JObject,
+    width: jni::sys::jint,
+    height: jni::sys::jint,
+    refresh_mhz: jni::sys::jint,
+) {
+    let native_window = ndk_sys::ANativeWindow_fromSurface(env.get_native_interface(), surface.as_raw());
+    if native_window.is_null() {
+        log::error!("Bridge: bindCastSurface - no ANativeWindow for the Surface");
+        return;
+    }
+    let sent = crate::android::command_channel::send_command(
+        crate::android::command_channel::JniCommand::BindCastWindow {
+            native_window: crate::android::command_channel::NativeWindowPtr(native_window as *mut std::ffi::c_void),
+            width,
+            height,
+            refresh_mhz,
+        },
+    );
+    if !sent {
+        ndk_sys::ANativeWindow_release(native_window);
+    }
+}
+
+#[no_mangle]
+pub extern "system" fn Java_com_winland_server_NativeBridge_releaseCastSurface(_env: JNIEnv, _class: JClass) {
+    crate::android::command_channel::send_command(crate::android::command_channel::JniCommand::ReleaseCastWindow);
+}
