index 0000000..91822cb
--- /dev/null
+++ b/delegate.h
@@ -0,0 +1,106 @@
+/*  This file is part of the KDE project
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+// A prompt in the session its requester is in.
+//
+// polkit picks one agent per session, but a session can have more than one desktop: a nested or
+// headless compositor with a session bus of its own (Rungic's independent desktop is one, its own
+// KWin and its own bus inside the phone's session). The agent registered with polkit (the router)
+// looks at the requesting process's session bus. When that is another bus of this user, and a
+// delegate runs there (this program with --delegate, D-Bus activatable on that bus), the prompt is
+// shown by the delegate, on the requester's display, in its look; polkit-agent-helper-1 checks the
+// password with the request's cookie whichever process of the user runs it. Anything else, or a
+// delegate that cannot be reached, gets the router's own dialog as before.
+
+#pragma once
+
+#include <QDBusConnection>
+#include <QObject>
+#include <QStringList>
+#include <QVariantMap>
+#include <functional>
+
+#include <PolkitQt1/Agent/Session>
+#include <PolkitQt1/Details>
+#include <PolkitQt1/Identity>
+
+#include "promptroute.h"
+
+class PolicyKitListener;
+class QDBusServiceWatcher;
+
+
+// In the agent polkit knows: hands a request to the delegate on its requester's bus.
+class PromptRouter : public QObject
+{
+    Q_OBJECT
+public:
+    explicit PromptRouter(QObject *parent = nullptr);
+
+    // Starts the request on the delegate of the requester's bus and returns true, or returns false
+    // when the request stays here. When the delegate cannot take it after all, `fallback` runs (show
+    // the dialog here); otherwise `finished` with polkit's error text (empty when completed).
+    bool forward(const QString &actionId,
+                 const QString &message,
+                 const QString &iconName,
+                 const PolkitQt1::Details &details,
+                 const QString &cookie,
+                 const PolkitQt1::Identity::List &identities,
+                 std::function<void()> fallback,
+                 std::function<void(const QString &)> finished);
+    // The forwarded request is cancelled (polkit asked): the delegate closes its dialog and finishes.
+    bool cancel();
+    bool active() const;
+
+private Q_SLOTS:
+    void delegateFinished(const QString &cookie, const QString &error);
+
+private:
+    void finish(const QString &error);
+    void reset();
+
+    QString m_connectionName;
+    QString m_cookie;
+    std::function<void(const QString &)> m_finished;
+    QDBusServiceWatcher *m_watcher = nullptr;
+};
+
+// --delegate: shows the router's requests on this display (PolicyKitListener's dialog), not
+// registered with polkit itself.
+class PromptDelegate : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.Polkit1AuthAgent.Delegate")
+    // A request is waiting for its user here (a shell can point at it).
+    Q_PROPERTY(bool Prompting READ prompting NOTIFY PromptingChanged SCRIPTABLE true)
+public:
+    explicit PromptDelegate(PolicyKitListener *listener, QObject *parent = nullptr);
+    ~PromptDelegate() override;
+    bool prompting() const;
+
+public Q_SLOTS:
+    Q_SCRIPTABLE void Begin(const QString &actionId,
+                            const QString &message,
+                            const QString &iconName,
+                            const QVariantMap &details,
+                            const QString &cookie,
+                            const QStringList &identities);
+    Q_SCRIPTABLE void Cancel(const QString &cookie);
+
+Q_SIGNALS:
+    Q_SCRIPTABLE void Finished(const QString &cookie, const QString &error);
+    Q_SCRIPTABLE void PromptingChanged(bool prompting);
+
+private:
+    static void completed(struct _GObject *source, struct _GAsyncResult *result, void *self);
+    void setPrompting(bool prompting);
+
+    PolicyKitListener *m_listener;
+    QString m_cookie;
+    PolkitQt1::Agent::AsyncResult *m_result = nullptr;     // the request shown now
+    PolkitQt1::Agent::AsyncResult *m_finished = nullptr;   // the last one, completed
+    bool m_prompting = false;
+};
