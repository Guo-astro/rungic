diff --git a/policykitlistener.cpp b/policykitlistener.cpp
index b56a4b2..51f9e6a 100644
--- a/policykitlistener.cpp
+++ b/policykitlistener.cpp
@@ -23,6 +23,7 @@
 
 #include "IdentitiesModel.h"
 #include "QuickAuthDialog.h"
+#include "delegate.h"
 #include "policykitlistener.h"
 #include "polkit1authagentadaptor.h"
 
@@ -107,6 +108,45 @@ void PolicyKitListener::initiateAuthentication(const QString &actionId,
 
     m_inProgress = true;
 
+    if (m_router
+        && m_router->forward(
+            actionId,
+            message,
+            iconName,
+            details,
+            cookie,
+            identities,
+            [this, actionId, message, details, identities] {
+                showDialog(actionId, message, details, identities);
+            },
+            [this](const QString &error) {
+                delegateFinished(error);
+            })) {
+        return;
+    }
+    showDialog(actionId, message, details, identities);
+}
+
+void PolicyKitListener::setRouter(PromptRouter *router)
+{
+    m_router = router;
+}
+
+void PolicyKitListener::delegateFinished(const QString &error)
+{
+    qDebug() << "The delegate finished" << error;
+    if (!error.isEmpty()) {
+        m_result->setError(error);
+    }
+    m_result->setCompleted();
+    m_inProgress = false;
+}
+
+void PolicyKitListener::showDialog(const QString &actionId,
+                                   const QString &message,
+                                   const PolkitQt1::Details &details,
+                                   const PolkitQt1::Identity::List &identities)
+{
     const QString parentHandle = m_windowHandles.value(actionId);
     const QString activationToken = m_activationTokens.value(actionId);
 
@@ -225,6 +265,11 @@ void PolicyKitListener::cancelAuthentication()
 {
     qDebug() << "Cancelling authentication";
 
+    // Shown by a delegate: it closes its dialog, and the request finishes when it says so.
+    if (m_router && m_router->cancel()) {
+        return;
+    }
+
     m_wasCancelled = true;
     finishObtainPrivilege();
 }
