--- /dev/null
+++ b/delegate.cpp
@@ -0,0 +1,225 @@
+/*  This file is part of the KDE project
+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "delegate.h"
+#include "policykitlistener.h"
+
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusServiceWatcher>
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+
+#include <gio/gio.h>
+#include <polkit/polkit.h>
+#include <unistd.h>
+
+using namespace Qt::StringLiterals;
+
+PromptRouter::PromptRouter(QObject *parent)
+    : QObject(parent)
+{
+}
+
+bool PromptRouter::active() const
+{
+    return !m_cookie.isEmpty();
+}
+
+bool PromptRouter::forward(const QString &actionId,
+                           const QString &message,
+                           const QString &iconName,
+                           const PolkitQt1::Details &details,
+                           const QString &cookie,
+                           const PolkitQt1::Identity::List &identities,
+                           std::function<void()> fallback,
+                           std::function<void(const QString &)> finished)
+{
+    if (active())
+        return false;
+    const QString pid = details.lookup(u"polkit.subject-pid"_s);
+    if (pid.isEmpty())
+        return false;
+    // Unreadable (another user's process, or one that is not dumpable): the request stays here.
+    QFile environ(u"/proc/%1/environ"_s.arg(pid));
+    if (!environ.open(QIODevice::ReadOnly))
+        return false;
+    const QString socket = PromptRoute::acceptedSocket(PromptRoute::sessionBusFromEnviron(environ.readAll()),
+                                                       qEnvironmentVariable("DBUS_SESSION_BUS_ADDRESS"),
+                                                       qEnvironmentVariable("XDG_RUNTIME_DIR"));
+    if (socket.isEmpty())
+        return false;
+    const QFileInfo info(socket);
+    if (!info.exists() || info.ownerId() != getuid())
+        return false;
+
+    m_connectionName = u"polkit-delegate "_s + socket;
+    QDBusConnection bus = QDBusConnection::connectToBus(u"unix:path="_s + socket, m_connectionName);
+    if (!bus.isConnected()) {
+        QDBusConnection::disconnectFromBus(m_connectionName);
+        m_connectionName.clear();
+        return false;
+    }
+    m_cookie = cookie;
+    m_finished = std::move(finished);
+    bus.connect(QString::fromLatin1(PromptRoute::Service), QString::fromLatin1(PromptRoute::Path), QString::fromLatin1(PromptRoute::Interface),
+                u"Finished"_s, this, SLOT(delegateFinished(QString,QString)));
+
+    QVariantMap detailMap;
+    for (const QString &key : details.keys())
+        detailMap.insert(key, details.lookup(key));
+    QStringList identityNames;
+    for (const PolkitQt1::Identity &identity : identities)
+        identityNames << identity.toString();
+    QDBusMessage call = QDBusMessage::createMethodCall(QString::fromLatin1(PromptRoute::Service), QString::fromLatin1(PromptRoute::Path),
+                                                       QString::fromLatin1(PromptRoute::Interface), u"Begin"_s);
+    call << actionId << message << iconName << detailMap << cookie << identityNames;
+    qDebug() << "Prompt for" << actionId << "goes to the delegate on" << socket;
+    // Long enough for the bus to start the delegate.
+    auto *pending = new QDBusPendingCallWatcher(bus.asyncCall(call, 30000), this);
+    connect(pending, &QDBusPendingCallWatcher::finished, this, [this, cookie, fallback, bus](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+        if (m_cookie != cookie)
+            return;  // finished meanwhile
+        if (watcher->isError()) {
+            qWarning() << "The delegate did not take the prompt, showing it here:" << watcher->error().message();
+            reset();
+            fallback();
+            return;
+        }
+        // Shown there: gone before it finished, the request ends.
+        m_watcher = new QDBusServiceWatcher(QString::fromLatin1(PromptRoute::Service), bus, QDBusServiceWatcher::WatchForUnregistration, this);
+        connect(m_watcher, &QDBusServiceWatcher::serviceUnregistered, this, [this] {
+            finish(u"The authentication dialog went away"_s);
+        });
+    });
+    return true;
+}
+
+bool PromptRouter::cancel()
+{
+    if (!active())
+        return false;
+    QDBusMessage call = QDBusMessage::createMethodCall(QString::fromLatin1(PromptRoute::Service), QString::fromLatin1(PromptRoute::Path),
+                                                       QString::fromLatin1(PromptRoute::Interface), u"Cancel"_s);
+    call << m_cookie;
+    QDBusConnection(m_connectionName).asyncCall(call);
+    return true;
+}
+
+void PromptRouter::delegateFinished(const QString &cookie, const QString &error)
+{
+    if (active() && cookie == m_cookie)
+        finish(error);
+}
+
+void PromptRouter::finish(const QString &error)
+{
+    auto finished = std::move(m_finished);
+    reset();
+    if (finished)
+        finished(error);
+}
+
+void PromptRouter::reset()
+{
+    delete m_watcher;
+    m_watcher = nullptr;
+    if (!m_connectionName.isEmpty()) {
+        QDBusConnection(m_connectionName)
+            .disconnect(QString::fromLatin1(PromptRoute::Service), QString::fromLatin1(PromptRoute::Path), QString::fromLatin1(PromptRoute::Interface),
+                        u"Finished"_s, this, SLOT(delegateFinished(QString,QString)));
+        QDBusConnection::disconnectFromBus(m_connectionName);
+    }
+    m_connectionName.clear();
+    m_cookie.clear();
+    m_finished = nullptr;
+}
+
+PromptDelegate::PromptDelegate(PolicyKitListener *listener, QObject *parent)
+    : QObject(parent)
+    , m_listener(listener)
+{
+    if (!QDBusConnection::sessionBus().registerObject(QString::fromLatin1(PromptRoute::Path), this, QDBusConnection::ExportScriptableContents)) {
+        qWarning() << "Could not register the delegate on the session bus";
+    }
+}
+
+PromptDelegate::~PromptDelegate()
+{
+    delete m_finished;
+}
+
+bool PromptDelegate::prompting() const
+{
+    return m_prompting;
+}
+
+void PromptDelegate::setPrompting(bool prompting)
+{
+    if (m_prompting == prompting)
+        return;
+    m_prompting = prompting;
+    Q_EMIT PromptingChanged(prompting);
+}
+
+void PromptDelegate::Begin(const QString &actionId,
+                           const QString &message,
+                           const QString &iconName,
+                           const QVariantMap &details,
+                           const QString &cookie,
+                           const QStringList &identities)
+{
+    if (m_result) {
+        Q_EMIT Finished(cookie, u"Another client is already authenticating, please try again later."_s);
+        return;
+    }
+    PolkitQt1::Details polkitDetails;
+    for (auto it = details.cbegin(); it != details.cend(); ++it)
+        polkitDetails.insert(it.key(), it.value().toString());
+    PolkitQt1::Identity::List polkitIdentities;
+    for (const QString &name : identities) {
+        const PolkitQt1::Identity identity = PolkitQt1::Identity::fromString(name);
+        if (identity.isValid())
+            polkitIdentities << identity;
+    }
+    qDebug() << "Prompt for" << actionId << "from the router";
+    m_cookie = cookie;
+    // The listener completes it as it does polkit's: completed() reports to the router.
+    GSimpleAsyncResult *simple = g_simple_async_result_new(nullptr, &PromptDelegate::completed, this, nullptr);
+    m_result = new PolkitQt1::Agent::AsyncResult(simple);
+    setPrompting(true);
+    m_listener->initiateAuthentication(actionId, message, iconName, polkitDetails, cookie, polkitIdentities, m_result);
+}
+
+void PromptDelegate::Cancel(const QString &cookie)
+{
+    if (m_result && cookie == m_cookie)
+        m_listener->cancelAuthentication();
+}
+
+void PromptDelegate::completed(GObject *, GAsyncResult *result, void *self)
+{
+    auto *delegate = static_cast<PromptDelegate *>(self);
+    QString text;
+    GError *error = nullptr;
+    if (g_simple_async_result_propagate_error(G_SIMPLE_ASYNC_RESULT(result), &error)) {
+        text = QString::fromUtf8(error->message);
+        g_error_free(error);
+    }
+    // Kept until the next request: the listener finishes a cancelled dialog more than once (the
+    // button, the session, the window closing) and completes its result each time; a completed
+    // AsyncResult ignores that, a deleted one crashed the delegate (2026-10-03).
+    delete delegate->m_finished;
+    delegate->m_finished = delegate->m_result;
+    const QString cookie = delegate->m_cookie;
+    delegate->m_result = nullptr;
+    delegate->m_cookie.clear();
+    delegate->setPrompting(false);
+    Q_EMIT delegate->Finished(cookie, text);
+}
