+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+// Which session bus a prompt goes to (delegate.h): the rules alone, Qt Core only.
+
+#pragma once
+
+#include <QByteArray>
+#include <QString>
+
+namespace PromptRoute
+{
+// The well-known name, object and interface of a delegate on its session bus.
+inline constexpr char Service[] = "org.kde.polkit-kde-authentication-agent-1";
+inline constexpr char Path[] = "/org/kde/Polkit1AuthAgent/Delegate";
+inline constexpr char Interface[] = "org.kde.Polkit1AuthAgent.Delegate";
+
+// DBUS_SESSION_BUS_ADDRESS from the contents of /proc/<pid>/environ; empty without one.
+QString sessionBusFromEnviron(const QByteArray &environ);
+// The bus at `address` may get a prompt: one Unix socket path (a guid allowed, no other transport) in
+// `runtimeDir` (this user's XDG_RUNTIME_DIR), not `ownAddress`'s socket. Returns that socket's path,
+// or an empty string.
+QString acceptedSocket(const QString &address, const QString &ownAddress, const QString &runtimeDir);
+}
