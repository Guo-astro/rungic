+    SPDX-FileCopyrightText: 2026 Rungic
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "promptroute.h"
+
+#include <QDir>
+#include <QStringList>
+
+using namespace Qt::StringLiterals;
+
+QString PromptRoute::sessionBusFromEnviron(const QByteArray &environ)
+{
+    const QByteArray key = "DBUS_SESSION_BUS_ADDRESS=";
+    for (const QByteArray &entry : environ.split('\0')) {
+        if (entry.startsWith(key))
+            return QString::fromUtf8(entry.mid(key.size()));
+    }
+    return {};
+}
+
+namespace
+{
+// The socket path of a unix:path= address (its first, a guid allowed), or an empty string.
+QString socketOf(const QString &address)
+{
+    const QString first = address.section(u';', 0, 0);
+    if (!first.startsWith("unix:"_L1))
+        return {};
+    QString path;
+    for (const QString &part : first.mid(5).split(u',')) {
+        if (part.startsWith("path="_L1))
+            path = part.mid(5);
+        else if (!part.startsWith("guid="_L1))
+            return {};  // abstract sockets, directories, other keys: not ours to follow
+    }
+    return path;
+}
+}
+
+QString PromptRoute::acceptedSocket(const QString &address, const QString &ownAddress, const QString &runtimeDir)
+{
+    const QString socket = QDir::cleanPath(socketOf(address));
+    if (socket.isEmpty() || runtimeDir.isEmpty() || !QDir::isAbsolutePath(socket))
+        return {};
+    if (!socket.startsWith(QDir::cleanPath(runtimeDir) + u'/'))
+        return {};
+    if (socket == QDir::cleanPath(socketOf(ownAddress)))
+        return {};
+    return socket;
+}
+
