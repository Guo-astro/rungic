 #include <libcamera/camera_manager.h>
@@ -267,6 +268,7 @@ private:
 
     QMediaCaptureSession m_session;
     QTimer m_videoFrameTimer;
+    QElapsedTimer m_recordingClock;
     QMediaFormat m_format;
