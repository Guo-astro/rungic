From: kevinzhow <kevinzhow@local>
Date: Wed, 23 Sep 2026 21:29:00 +0800
Subject: Video recording: each frame stamped with the recording clock

Frames were stamped from a frame counter and one QVideoFrame was re-sent with changed times, so
dropped frames sped the video up and frames already queued in QMediaRecorder had their times
changed (the TODO upstream notes "severe frame corruption"). Each submitted frame is now its own copy
stamped with the elapsed recording time.

Forwarded: no
Last-Update: 2026-09-27
X-Rungic-Status: Pending [a plain bug; check upstream master first]
X-Rungic-Tests: none (gap: no scenario records video in Plasma Camera)
X-Rungic-Docs: docs/48
---
 src/plasmacameramanager.cpp | 22 +++++++++++++---------
 src/plasmacameramanager.h   |  2 ++
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/src/plasmacameramanager.cpp b/src/plasmacameramanager.cpp
index 7aac316..738fb2b 100644
--- a/src/plasmacameramanager.cpp
+++ b/src/plasmacameramanager.cpp
@@ -299,6 +299,8 @@ void PlasmaCameraManager::setRecorder(QMediaRecorder *recorder)
     m_session.setRecorder(recorder);
     connect(m_recorder, &QMediaRecorder::recorderStateChanged, this, [this]() {
         if (m_recorder->recorderState() == QMediaRecorder::RecordingState) {
+            m_frameRecordingCount = 0;
+            m_recordingClock.start();
             m_videoFrameTimer.start();
         } else {
             m_videoFrameTimer.stop();
@@ -390,6 +392,7 @@ void PlasmaCameraManager::updateRecorderSettings()
     m_recorder->setVideoFrameRate(0);
 
     // Set frame timer polling rate
+    m_videoFrameTimer.setTimerType(Qt::PreciseTimer);
     m_videoFrameTimer.setInterval(static_cast<int>(1000.0f / m_videoRecordingFps));
 }
 
@@ -625,15 +628,16 @@ void PlasmaCameraManager::writeExifData(const QString &fileName)
 
 void PlasmaCameraManager::processVideoFrame()
 {
-    // Set the time in the video that the frame should show up.
-    // This allows for frames to be dropped without impacting video speed.
-    // TODO: This causes severe frame corruption on devices that drop frames, how do we make it smoother?
-    int frameLengthMicroseconds = qRound(1000.0 * 1000.0 / m_videoRecordingFps);
-    m_videoFrame.setStartTime(m_frameRecordingCount * frameLengthMicroseconds);
-    m_videoFrame.setEndTime((m_frameRecordingCount + 1) * frameLengthMicroseconds - 1);
-
-    // Attempt to send frame
-    bool success = m_videoInput.sendVideoFrame(m_videoFrame);
+    if (m_currentFrame.isNull() || !m_recordingClock.isValid()) return;
+    // QVideoFrame copies share their timestamps. Never mutate a frame already
+    // queued in QMediaRecorder; each submitted frame needs its own metadata.
+    QVideoFrame frame(m_currentFrame);
+    frame.setRotation(m_videoFrame.rotation());
+    frame.setMirrored(m_videoFrame.mirrored());
+    const qint64 pts = m_recordingClock.nsecsElapsed() / 1000;
+    frame.setStartTime(pts);
+    frame.setEndTime(pts + qRound(1000000.0 / m_videoRecordingFps));
+    bool success = m_videoInput.sendVideoFrame(frame);
     if (success) {
         m_frameRecorded = true;
     } else {
