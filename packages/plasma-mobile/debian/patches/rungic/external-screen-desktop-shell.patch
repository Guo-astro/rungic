@@ -0,0 +1,67 @@
+// Plasma shell script (org.kde.PlasmaShell.evaluateScript): a desktop-style shell
+// on every external screen while the phone keeps the mobile shell (docs/58).
+// Idempotent. Upstream Plasma Mobile puts a second mobile homescreen and no
+// panels on external screens; this follows the idea of the unmerged
+// plasma-mobile!548 but leaves screen 0 (the phone) untouched. The layout is
+// kept in the shell's config and comes back whenever an external screen does.
+
+var log = [];
+
+function hasDesktopPanel(screen) {
+    var ps = panels();
+    for (var i = 0; i < ps.length; i++) {
+        if (ps[i].type === "org.kde.panel" && ps[i].screen === screen) {
+            return true;
+        }
+    }
+    return false;
+}
+
+for (var screen = 1; screen < screenCount; screen++) {
+    // Desktop containment: Folder View instead of the mobile Folio homescreen.
+    // Scripts cannot create desktop containments, but moving one to a screen that
+    // has none makes the shell create an org.kde.plasma.folder containment there
+    // and swap the two (ShellCorona::setScreenForContainment).
+    var current = desktopForScreen(screen);
+    if (current && current.type === "org.kde.plasma.mobile.homescreen.folio") {
+        var folioId = current.id;
+        var parking = 100 + screen;
+        current.screen = parking;
+        var folder = desktopForScreen(screen);
+        var folio = desktopById(folioId);
+        if (folder && folder.type === "org.kde.plasma.folder" && folio && folio.screen !== screen) {
+            folio.remove();
+        }
+        log.push("screen " + screen + ": " + (folder ? folder.type + " " + folder.id : "no desktop"));
+    }
+
+    // This system's XDG desktop directory is $HOME, which would put the whole
+    // home directory on the desktop; show ~/Desktop instead.
+    var desktop = desktopForScreen(screen);
+    if (desktop && desktop.type === "org.kde.plasma.folder") {
+        desktop.currentConfigGroup = ["General"];
+        if (!desktop.readConfig("url", "")) {
+            desktop.writeConfig("url", "file://" + userDataPath() + "/Desktop");
+            log.push("screen " + screen + ": desktop folder ~/Desktop");
+        }
+    }
+
+    // Panel: the Plasma Desktop default layout, tasks of this screen only.
+    if (!hasDesktopPanel(screen)) {
+        var panel = new Panel("org.kde.panel");
+        panel.screen = screen;
+        panel.location = "bottom";
+        panel.height = 2 * Math.floor(gridUnit * 2.5 / 2);
+        panel.addWidget("org.kde.plasma.kickoff");
+        var tasks = panel.addWidget("org.kde.plasma.icontasks");
+        tasks.currentConfigGroup = ["General"];
+        tasks.writeConfig("showOnlyCurrentScreen", true);
+        panel.addWidget("org.kde.plasma.marginsseparator");
+        panel.addWidget("org.kde.plasma.systemtray");
+        panel.addWidget("org.kde.plasma.digitalclock");
+        panel.addWidget("org.kde.plasma.showdesktop");
+        log.push("screen " + screen + ": panel " + panel.id);
+    }
+}
+
+print(log.length ? log.join("\n") : "unchanged");
