diff --git a/quicksettings/kscreenosd/kscreenosdutil.cpp b/quicksettings/kscreenosd/kscreenosdutil.cpp
index bce4069..3016200 100644
--- a/quicksettings/kscreenosd/kscreenosdutil.cpp
+++ b/quicksettings/kscreenosd/kscreenosdutil.cpp
@@ -10,6 +10,10 @@
 #include <QDebug>
 #include <QDBusInterface>
 #include <QDBusReply>
+#include <QFile>
+#include <QGuiApplication>
+#include <QStandardPaths>
+#include <QTimer>
 
 KScreenOSDUtil::KScreenOSDUtil(QObject *parent)
     : QObject{parent}
@@ -23,6 +27,30 @@ KScreenOSDUtil::KScreenOSDUtil(QObject *parent)
     // Without a config the output count stays 0 and KScreenOSDProvider never
     // switches to docked (convergence) mode when a display is added (docs/58).
     retrieveKScreen();
+    // After the shell has made its view for a new screen.
+    connect(qGuiApp, &QGuiApplication::screenAdded, this, [this]() {
+        QTimer::singleShot(1000, this, &KScreenOSDUtil::applyExternalDesktopLayout);
+    });
+}
+
+void KScreenOSDUtil::applyExternalDesktopLayout()
+{
+    // Desktop panel and Folder View desktop on external screens, mobile shell on
+    // the phone (docs/58). The script is idempotent and its result is kept in
+    // the shell's config, so later connections of any external screen reuse it.
+    const QString path = QStandardPaths::locate(QStandardPaths::GenericDataLocation,
+                                                QStringLiteral("plasma/shells/org.kde.plasma.mobileshell/contents/external-desktop.js"));
+    QFile file(path);
+    if (path.isEmpty() || !file.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    QDBusMessage msg = QDBusMessage::createMethodCall(QStringLiteral("org.kde.plasmashell"),
+                                                      QStringLiteral("/PlasmaShell"),
+                                                      QStringLiteral("org.kde.PlasmaShell"),
+                                                      QStringLiteral("evaluateScript"));
+    msg << QString::fromUtf8(file.readAll());
+    // Asynchronous: this runs inside plasmashell, which serves the call itself.
+    QDBusConnection::sessionBus().asyncCall(msg);
 }
 
 void KScreenOSDUtil::retrieveKScreen()
@@ -44,6 +72,9 @@ void KScreenOSDUtil::setOutputs(int _outputs)
     if (_outputs != m_outputs) {
         m_outputs = _outputs;
         Q_EMIT outputsChanged();
+        if (m_outputs > 1) {
+            QTimer::singleShot(1000, this, &KScreenOSDUtil::applyExternalDesktopLayout);
+        }
     }
 }
 
