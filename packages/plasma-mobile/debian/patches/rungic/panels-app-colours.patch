+void ShellDBusObject::setActiveWindowColorScheme(const QString &screen, const QString &colorScheme)
+{
+    // A scheme is a .colors file: an absolute path, or a name under color-schemes/.
+    QString path;
+    if (!colorScheme.isEmpty() && colorScheme != QLatin1String("kdeglobals")) {
+        path = QFileInfo(colorScheme).isAbsolute()
+            ? colorScheme
+            : QStandardPaths::locate(QStandardPaths::GenericDataLocation, QStringLiteral("color-schemes/%1.colors").arg(colorScheme));
+    }
+    if (m_windowColorSchemes.value(screen) == path) {
+        return;
+    }
+    m_windowColorSchemes.insert(screen, path);
+    m_windowColorsRevision++;
+    Q_EMIT windowColorsChanged();
+}
+
+QString ShellDBusObject::windowBackground(const QString &screen, const QString &colorSet) const
+{
+    const QString path = m_windowColorSchemes.value(screen);
+    if (path.isEmpty() || !QFileInfo::exists(path)) {
+        return {};
+    }
+    const auto config = KSharedConfig::openConfig(path, KConfig::SimpleConfig);
+    const QStringList rgb = KConfigGroup(config, QStringLiteral("Colors:%1").arg(colorSet)).readEntry("BackgroundNormal", QStringList{});
+    if (rgb.size() < 3) {
+        return {};
+    }
+    return QColor(rgb[0].trimmed().toInt(), rgb[1].trimmed().toInt(), rgb[2].trimmed().toInt()).name();
+}
+
+int ShellDBusObject::windowColorsRevision() const
+{
+    return m_windowColorsRevision;
+}
