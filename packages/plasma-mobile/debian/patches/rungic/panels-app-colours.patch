diff --git a/kwin/scripts/convergentwindows/contents/ui/WindowColors.qml b/kwin/scripts/convergentwindows/contents/ui/WindowColors.qml
new file mode 100644
index 0000000..15564e2
--- /dev/null
+++ b/kwin/scripts/convergentwindows/contents/ui/WindowColors.qml
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Moto (docs/59): tells the mobile shell the colour scheme of the app window made active on
+// each screen, so the status bar and navigation panel take that app's colours. The scheme
+// is what the app gave through the KDE palette protocol (KWin's Window::colorScheme: a
+// .colors path, or "kdeglobals" for none); apps without one keep the theme's panels.
+import QtQuick
+import org.kde.kwin as KWinComponents
+
+Item {
+    id: root
+    property var window: null
+
+    KWinComponents.DBusCall {
+        id: report
+        service: "org.kde.plasmashell"
+        path: "/Mobile"
+        dbusInterface: "org.kde.plasmashell"
+        method: "setActiveWindowColorScheme"
+    }
+
+    function send(window) {
+        if (!window || !window.output) {
+            return;
+        }
+        report.arguments = [window.output.name, window.colorScheme];
+        report.call();
+    }
+
+    Connections {
+        target: KWinComponents.Workspace
+        function onWindowActivated(window) {
+            // Only apps' own windows: panels, the shell and overlays keep the last app's colours.
+            if (window && window.normalWindow) {
+                root.window = window;
+                root.send(window);
+            }
+        }
+    }
+    Connections {
+        target: root.window
+        ignoreUnknownSignals: true
+        function onColorSchemeChanged() { root.send(root.window); }
+        function onOutputChanged() { root.send(root.window); }
+    }
+}
