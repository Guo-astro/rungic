diff --git a/components/windowplugin/windowutil.cpp b/components/windowplugin/windowutil.cpp
index 51427e4..295790a 100644
--- a/components/windowplugin/windowutil.cpp
+++ b/components/windowplugin/windowutil.cpp
@@ -10,6 +10,7 @@
 #include <KApplicationTrader>
 
 #include <QGuiApplication>
+#include <QScreen>
 
 constexpr int ACTIVE_WINDOW_UPDATE_INVERVAL = 0;
 
@@ -69,6 +70,16 @@ void WindowUtil::initWayland()
         m_activeWindowTimer->start();
     });
 
+    // Outputs by name (wl_output v4), to send windows to a screen.
+    connect(registry, &Registry::outputAnnounced, this, [this, registry](quint32 name, quint32 version) {
+        auto *output = registry->createOutput(name, std::min(version, 4u), this);
+        m_outputs.append(output);
+        connect(output, &Output::removed, this, [this, output]() {
+            m_outputs.removeOne(output);
+            output->deleteLater();
+        });
+    });
+
     connect(registry, &Registry::plasmaActivationFeedbackAnnounced, this, [this, registry](quint32 name, quint32 version) {
         auto iface = registry->createPlasmaActivationFeedback(name, version, this);
 
@@ -146,16 +157,34 @@ bool WindowUtil::hasCloseableActiveWindow() const
     return m_activeWindow && m_activeWindow->isCloseable() /*&& !m_activeWindow->isMinimized()*/;
 }
 
-bool WindowUtil::activateWindowByStorageId(const QString &storageId)
+bool WindowUtil::activateWindowByStorageId(const QString &storageId, const QString &screenName)
 {
     auto windows = windowsFromStorageId(storageId);
 
-    if (!windows.empty()) {
-        windows[0]->requestActivate();
-        return true;
+    if (windows.empty()) {
+        return false;
     }
 
-    return false;
+    auto *window = windows[0];
+    if (!screenName.isEmpty()) {
+        // Geometries are global logical coordinates, as QScreen's are.
+        QScreen *screen = nullptr;
+        for (QScreen *s : QGuiApplication::screens()) {
+            if (s->name() == screenName) {
+                screen = s;
+            }
+        }
+        if (screen && !screen->geometry().contains(window->geometry().center())) {
+            for (auto *output : std::as_const(m_outputs)) {
+                if (output->name() == screenName) {
+                    window->sendToOutput(output);
+                    break;
+                }
+            }
+        }
+    }
+    window->requestActivate();
+    return true;
 }
 
 void WindowUtil::closeActiveWindow()
